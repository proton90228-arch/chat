  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/color && cat > Role.java <<'EOF'\npackage com.valkyrie.client.ui.color;\n\n/**\n * Цветовые роли Sakura You (M3 + роли бренда и состояний лаунчера).\n * Для каждой роли: палитра и тон в светлой и тёмной схеме — один в один с {@code scheme.ts}.\n */\npublic enum Role {\n    PRIMARY(\"primary\", 'P', 40, 'P', 80),\n    ON_PRIMARY(\"on-primary\", 'P', 100, 'P', 20),\n    PRIMARY_CONTAINER(\"primary-container\", 'P', 90, 'P', 30),\n    ON_PRIMARY_CONTAINER(\"on-primary-container\", 'P', 30, 'P', 90),\n    SECONDARY(\"secondary\", 'S', 40, 'S', 80),\n    ON_SECONDARY(\"on-secondary\", 'S', 100, 'S', 20),\n    SECONDARY_CONTAINER(\"secondary-container\", 'S', 90, 'S', 30),\n    ON_SECONDARY_CONTAINER(\"on-secondary-container\", 'S', 30, 'S', 90),\n    TERTIARY(\"tertiary\", 'T', 40, 'T', 80),\n    ON_TERTIARY(\"on-tertiary\", 'T', 100, 'T', 20),\n    TERTIARY_CONTAINER(\"tertiary-container\", 'T', 90, 'T', 30),\n    ON_TERTIARY_CONTAINER(\"on-tertiary-container\", 'T', 30, 'T', 90),\n    ERROR(\"error\", 'E', 40, 'E', 80),\n    ON_ERROR(\"on-error\", 'E', 100, 'E', 20),\n    ERROR_CONTAINER(\"error-container\", 'E', 90, 'E', 30),\n    ON_ERROR_CONTAINER(\"on-error-container\", 'E', 30, 'E', 90),\n    SURFACE(\"surface\", 'N', 99, 'D', 6),\n    SURFACE_DIM(\"surface-dim\", 'N', 88, 'D', 6),\n    SURFACE_BRIGHT(\"surface-bright\", 'N', 99, 'D', 24),\n    SURFACE_CONTAINER_LOWEST(\"surface-container-lowest\", 'N', 100, 'D', 4),\n    SURFACE_CONTAINER_LOW(\"surface-container-low\", 'N', 97, 'D', 10),\n    SURFACE_CONTAINER(\"surface-container\", 'N', 95, 'D', 12),\n    SURFACE_CONTAINER_HIGH(\"surface-container-high\", 'N', 93, 'D', 17),\n    SURFACE_CONTAINER_HIGHEST(\"surface-container-highest\", 'N', 91, 'D', 22),\n    ON_SURFACE(\"on-surface\", 'N', 10, 'D', 92),\n    ON_SURFACE_VARIANT(\"on-surface-variant\", 'V', 30, 'V', 80),\n    OUTLINE(\"outline\", 'V', 50, 'V', 60),\n    OUTLINE_VARIANT(\"outline-variant\", 'V', 85, 'V', 30),\n    INVERSE_SURFACE(\"inverse-surface\", 'N', 20, 'D', 90),\n    INVERSE_ON_SURFACE(\"inverse-on-surface\", 'N', 95, 'D', 20),\n    INVERSE_PRIMARY(\"inverse-primary\", 'P', 80, 'P', 40),\n    SCRIM(\"scrim\", 'N', 0, 'N', 0),\n    SHADOW(\"shadow\", 'N', 0, 'N', 0),\n    PRIMARY_FIXED(\"primary-fixed\", 'P', 90, 'P', 90),\n    PRIMARY_FIXED_DIM(\"primary-fixed-dim\", 'P', 80, 'P', 80),\n    ON_PRIMARY_FIXED(\"on-primary-fixed\", 'P', 10, 'P', 10),\n    ON_PRIMARY_FIXED_VARIANT(\"on-primary-fixed-variant\", 'P', 30, 'P', 30),\n    PETAL(\"petal\", 'P', 80, 'P', 70),\n    PETAL_SOFT(\"petal-soft\", 'P', 90, 'P', 40),\n    BRAND(\"brand\", 'P', 50, 'P', 70),\n    ON_BRAND(\"on-brand\", 'P', 100, 'P', 10),\n    // Расширенные роли состояний (лаунчер: install/update/success).\n    INSTALL(\"install\", 'i', 40, 'i', 80),\n    ON_INSTALL(\"on-install\", 'i', 100, 'i', 20),\n    INSTALL_CONTAINER(\"install-container\", 'i', 90, 'i', 30),\n    ON_INSTALL_CONTAINER(\"on-install-container\", 'i', 30, 'i', 90),\n    UPDATE(\"update\", 'u', 40, 'u', 80),\n    ON_UPDATE(\"on-update\", 'u', 100, 'u', 20),\n    UPDATE_CONTAINER(\"update-container\", 'u', 90, 'u', 30),\n    ON_UPDATE_CONTAINER(\"on-update-container\", 'u', 30, 'u', 90),\n    SUCCESS(\"success\", 's', 40, 's', 80),\n    ON_SUCCESS(\"on-success\", 's', 100, 's', 20),\n    SUCCESS_CONTAINER(\"success-container\", 's', 90, 's', 30),\n    ON_SUCCESS_CONTAINER(\"on-success-container\", 's', 30, 's', 90);\n\n    public final String token;\n    final char lightPalette;\n    final int lightTone;\n    final char darkPalette;\n    final int darkTone;\n\n    Role(String token, char lightPalette, int lightTone, char darkPalette, int darkTone) {\n        this.token = token;\n        this.lightPalette = lightPalette;\n        this.lightTone = lightTone;\n        this.darkPalette = darkPalette;\n        this.darkTone = darkTone;\n    }\n\n    private static final Role[] VALUES = values();\n\n    public static Role[] all() {\n        return VALUES;\n    }\n}\nEOF\ncat > Scheme.java <<'EOF'\npackage com.valkyrie.client.ui.color;\n\nimport java.util.EnumMap;\nimport java.util.Map;\nimport java.util.concurrent.ConcurrentHashMap;\n\n/**\n * Схема Sakura You: все роли {@link Role} для одного seed-цвета и режима.\n * <p>\n * Палитры как в лаунчере: P — chroma ≥ 36, S — 16, T — hue+60 / 24, N — 4, NV — 8,\n * DN — тёмная нейтраль с hue−28 и chroma 7 (сумеречный фиолет вместо серого),\n * E — ошибка, гармонизированная к seed.\n */\npublic final class Scheme {\n    /** Пресеты лаунчера. */\n    public enum Preset {\n        SAKURA(\"Сакура\", \"桜\", 0xFFDF91AA),\n        FUJI(\"Глициния\", \"藤\", 0xFFB3A0D2),\n        MOMIJI(\"Момидзи\", \"紅葉\", 0xFFE39A6E),\n        MATCHA(\"Матча\", \"抹茶\", 0xFF93B47E),\n        SORA(\"Сора\", \"空\", 0xFF8FB4DE);\n\n        public final String title;\n        public final String kanji;\n        public final int seed;\n\n        Preset(String title, String kanji, int seed) {\n            this.title = title;\n            this.kanji = kanji;\n            this.seed = seed;\n        }\n\n        /** Пресет с точно таким seed или {@code null}. */\n        public static Preset bySeed(int argb) {\n            for (Preset preset : values()) {\n                if ((preset.seed & 0xFFFFFF) == (argb & 0xFFFFFF)) {\n                    return preset;\n                }\n            }\n            return null;\n        }\n    }\n\n    private static final Map<Long, Scheme> CACHE = new ConcurrentHashMap<>();\n\n    public final int seed;\n    public final boolean dark;\n    private final int[] colors;\n\n    private Scheme(int seed, boolean dark, int[] colors) {\n        this.seed = seed;\n        this.dark = dark;\n        this.colors = colors;\n    }\n\n    /** Схема для seed (альфа игнорируется). Результаты кэшируются. */\n    public static Scheme of(int seed, boolean dark) {\n        int rgb = seed & 0xFFFFFF;\n        long key = ((long) rgb << 1) | (dark ? 1 : 0);\n        return CACHE.computeIfAbsent(key, k -> build(0xFF000000 | rgb, dark));\n    }\n\n    public int get(Role role) {\n        return colors[role.ordinal()];\n    }\n\n    /** Цвет роли с альфой 0..1. */\n    public int get(Role role, float alpha) {\n        return Argb.withAlpha(colors[role.ordinal()], alpha);\n    }\n\n    /** Покомпонентная интерполяция двух схем — для плавной смены акцента/режима. */\n    public static int[] lerp(Scheme from, Scheme to, float t, int[] out) {\n        for (int i = 0; i < out.length; i++) {\n            out[i] = Argb.mixOklab(from.colors[i], to.colors[i], t);\n        }\n        return out;\n    }\n\n    int[] raw() {\n        return colors;\n    }\n\n    private static Scheme build(int seed, boolean dark) {\n        double[] hct = Hct.fromArgb(seed);\n        double hue = hct[0];\n        double chroma = hct[1];\n        Map<Character, TonalPalette> palettes = new EnumKeyMap();\n        palettes.put('P', new TonalPalette(hue, Math.max(chroma, 36.0)));\n        palettes.put('S', new TonalPalette(hue, 16.0));\n        palettes.put('T', new TonalPalette(hue + 60.0, 24.0));\n        palettes.put('N', new TonalPalette(hue, 4.0));\n        palettes.put('V', new TonalPalette(hue, 8.0));\n        palettes.put('D', new TonalPalette(Hct.mod360(hue - 28.0), 7.0));\n        double[] error = Hct.harmonize(0xFFB3261E, seed);\n        palettes.put('E', new TonalPalette(error[0], Math.max(error[1], 60.0)));\n        double[] install = Hct.harmonize(0xFF9D8AB8, seed);\n        palettes.put('i', new TonalPalette(install[0], Math.max(install[1], 36.0)));\n        double[] update = Hct.harmonize(0xFFD9925F, seed);\n        palettes.put('u', new TonalPalette(update[0], Math.max(update[1], 36.0)));\n        double[] success = Hct.fromArgb(0xFF4FB98A); // «успех» не гармонизируется\n        palettes.put('s', new TonalPalette(success[0], Math.max(success[1], 36.0)));\n\n        Role[] roles = Role.all();\n        int[] colors = new int[roles.length];\n        for (Role role : roles) {\n            char palette = dark ? role.darkPalette : role.lightPalette;\n            int tone = dark ? role.darkTone : role.lightTone;\n            colors[role.ordinal()] = palettes.get(palette).tone(tone);\n        }\n        return new Scheme(seed, dark, colors);\n    }\n\n    /** Маленькая карта по символу палитры (HashMap без лишних аллокаций boxed-ключей не нужен). */\n    private static final class EnumKeyMap extends java.util.HashMap<Character, TonalPalette> {\n    }\n\n    /** Для отладки и тестов: роль → цвет. */\n    public Map<Role, Integer> asMap() {\n        Map<Role, Integer> map = new EnumMap<>(Role.class);\n        for (Role role : Role.all()) {\n            map.put(role, colors[role.ordinal()]);\n        }\n        return map;\n    }\n}\nEOF\ncat > Argb.java <<'EOF'\npackage com.valkyrie.client.ui.color;\n\n/** Операции над цветами ARGB (0xAARRGGBB). */\npublic final class Argb {\n    private Argb() {\n    }\n\n    public static int a(int c) {\n        return c >>> 24;\n    }\n\n    public static int r(int c) {\n        return (c >> 16) & 0xFF;\n    }\n\n    public static int g(int c) {\n        return (c >> 8) & 0xFF;\n    }\n\n    public static int b(int c) {\n        return c & 0xFF;\n    }\n\n    public static int of(int a, int r, int g, int b) {\n        return (clamp8(a) << 24) | (clamp8(r) << 16) | (clamp8(g) << 8) | clamp8(b);\n    }\n\n    /** Заменяет альфу на {@code alpha} (0..1). */\n    public static int withAlpha(int c, float alpha) {\n        return (clamp8(Math.round(alpha * 255.0f)) << 24) | (c & 0xFFFFFF);\n    }\n\n    /** Умножает существующую альфу на {@code factor} (0..1). */\n    public static int fade(int c, float factor) {\n        if (factor >= 1.0f) {\n            return c;\n        }\n        int a = Math.round((c >>> 24) * Math.max(0.0f, factor));\n        return (clamp8(a) << 24) | (c & 0xFFFFFF);\n    }\n\n    /** Линейное смешивание в sRGB, включая альфу. */\n    public static int mix(int from, int to, float t) {\n        if (t <= 0.0f) {\n            return from;\n        }\n        if (t >= 1.0f) {\n            return to;\n        }\n        return of(\n            Math.round(a(from) + (a(to) - a(from)) * t),\n            Math.round(r(from) + (r(to) - r(from)) * t),\n            Math.round(g(from) + (g(to) - g(from)) * t),\n            Math.round(b(from) + (b(to) - b(from)) * t)\n        );\n    }\n\n    /**\n     * Слой состояния M3: {@code overlay} с прозрачностью {@code opacity} поверх {@code base}.\n     * Альфа результата — альфа основы, т. е. hover не делает полупрозрачную карточку плотнее.\n     */\n    public static int layer(int base, int overlay, float opacity) {\n        if (opacity <= 0.0f) {\n            return base;\n        }\n        int mixed = mix(base | 0xFF000000, overlay | 0xFF000000, Math.min(1.0f, opacity));\n        return (base & 0xFF000000) | (mixed & 0xFFFFFF);\n    }\n\n    /** Смешивание в OKLab: переходы между тонами без «грязной» середины. */\n    public static int mixOklab(int from, int to, float t) {\n        if (t <= 0.0f || from == to) {\n            return from;\n        }\n        if (t >= 1.0f) {\n            return to;\n        }\n        float[] x = oklab(from);\n        float[] y = oklab(to);\n        float l = x[0] + (y[0] - x[0]) * t;\n        float aa = x[1] + (y[1] - x[1]) * t;\n        float bb = x[2] + (y[2] - x[2]) * t;\n        int alpha = Math.round(a(from) + (a(to) - a(from)) * t);\n        return (clamp8(alpha) << 24) | (fromOklab(l, aa, bb) & 0xFFFFFF);\n    }\n\n    /** Относительная яркость (0..1) — для выбора варианта текста и контраста. */\n    public static float luminance(int c) {\n        return (float) Hct.luminance(c);\n    }\n\n    // ─── OKLab ──────────────────────────────────────────────────────────────\n\n    private static float toLinear(int c8) {\n        float c = c8 / 255.0f;\n        return c <= 0.04045f ? c / 12.92f : (float) Math.pow((c + 0.055f) / 1.055f, 2.4f);\n    }\n\n    private static int toSrgb8(float lin) {\n        float v = lin <= 0.0031308f ? lin * 12.92f : 1.055f * (float) Math.pow(Math.max(0.0f, lin), 1.0f / 2.4f) - 0.055f;\n        return clamp8(Math.round(v * 255.0f));\n    }\n\n    private static float[] oklab(int c) {\n        float r = toLinear(r(c));\n        float g = toLinear(g(c));\n        float b = toLinear(b(c));\n        float l = (float) Math.cbrt(0.4122214708f * r + 0.5363325363f * g + 0.0514459929f * b);\n        float m = (float) Math.cbrt(0.2119034982f * r + 0.6806995451f * g + 0.1073969566f * b);\n        float s = (float) Math.cbrt(0.0883024619f * r + 0.2817188376f * g + 0.6299787005f * b);\n        return new float[] {\n            0.2104542553f * l + 0.7936177850f * m - 0.0040720468f * s,\n            1.9779984951f * l - 2.4285922050f * m + 0.4505937099f * s,\n            0.0259040371f * l + 0.7827717662f * m - 0.8086757660f * s,\n        };\n    }\n\n    private static int fromOklab(float l, float a, float b) {\n        float l1 = l + 0.3963377774f * a + 0.2158037573f * b;\n        float m1 = l - 0.1055613458f * a - 0.0638541728f * b;\n        float s1 = l - 0.0894841775f * a - 1.2914855480f * b;\n        l1 = l1 * l1 * l1;\n        m1 = m1 * m1 * m1;\n        s1 = s1 * s1 * s1;\n        float r = 4.0767416621f * l1 - 3.3077115913f * m1 + 0.2309699292f * s1;\n        float g = -1.2684380046f * l1 + 2.6097574011f * m1 - 0.3413193965f * s1;\n        float bb = -0.0041960863f * l1 - 0.7034186147f * m1 + 1.7076147010f * s1;\n        return 0xFF000000 | (toSrgb8(r) << 16) | (toSrgb8(g) << 8) | toSrgb8(bb);\n    }\n\n    private static int clamp8(int v) {\n        return v < 0 ? 0 : Math.min(255, v);\n    }\n}\nEOF\necho ok","description":"Write Role, Scheme, Argb"}
