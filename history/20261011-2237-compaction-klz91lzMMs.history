  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/clickgui && cat > ModuleIcons.java <<'EOF'\npackage com.valkyrie.client.ui.clickgui;\n\nimport com.valkyrie.client.ui.icon.Icon;\nimport java.util.HashMap;\nimport java.util.Locale;\nimport java.util.Map;\n\n/** Иконки модулей и категорий (по имени — без правок в классах модулей). */\npublic final class ModuleIcons {\n    private static final Map<String, Icon> BY_NAME = new HashMap<>();\n\n    static {\n        put(Icon.TAG, \"watermark\");\n        put(Icon.KEYBOARD, \"keystrokes\");\n        put(Icon.INFO, \"info\");\n        put(Icon.SHIELD, \"armor\");\n        put(Icon.FLASK, \"effects\");\n        put(Icon.MOVE, \"edit layout\", \"hud editor\");\n        put(Icon.PERSON, \"target hud\");\n        put(Icon.CUBE, \"esp\");\n        put(Icon.TRACERS, \"tracers\");\n        put(Icon.HITMARKER, \"hit marker\");\n        put(Icon.DROP, \"damage tint\");\n        put(Icon.CROSSHAIR, \"crosshair\");\n        put(Icon.SUN, \"world time\");\n        put(Icon.GLOW, \"target glow\");\n        put(Icon.SAKURA, \"sakura bloom\");\n        put(Icon.STARS, \"threat constellation\");\n        put(Icon.LENS, \"intent lens\");\n        put(Icon.HISTORY, \"memory echo\");\n        put(Icon.SELECT, \"block highlight\");\n        put(Icon.ORBIT, \"pearl prediction\");\n        put(Icon.TRAIL, \"projectile trails\");\n        put(Icon.MOTION, \"item animations\");\n        put(Icon.CAMERA, \"camera effects\");\n        put(Icon.CHEST, \"storage esp\");\n        put(Icon.PALETTE, \"world color\", \"appearance\");\n        put(Icon.SWORD, \"killaura\", \"kill aura\");\n        put(Icon.AIM, \"aim assist\");\n        put(Icon.BOLT, \"triggerbot\", \"trigger bot\");\n        put(Icon.SWAP, \"autoweapon\", \"auto weapon\");\n        put(Icon.HEART, \"autototem\", \"auto totem\");\n        put(Icon.BURST, \"criticals\");\n        put(Icon.MOON, \"dark mode\");\n        put(Icon.HOME, \"main menu\");\n        put(Icon.FOCUS, \"focus mode\");\n        put(Icon.LAYERS, \"visual profiles\");\n    }\n\n    private ModuleIcons() {\n    }\n\n    private static void put(Icon icon, String... names) {\n        for (String n : names) {\n            BY_NAME.put(n, icon);\n        }\n    }\n\n    public static Icon forModule(String name) {\n        Icon icon = BY_NAME.get(name.toLowerCase(Locale.ROOT));\n        return icon != null ? icon : Icon.SPARKLE;\n    }\n\n    public static Icon forCategory(String title) {\n        return switch (title.toLowerCase(Locale.ROOT)) {\n            case \"hud\" -> Icon.DASHBOARD;\n            case \"visuals\" -> Icon.EYE;\n            case \"combat\" -> Icon.SWORD;\n            default -> Icon.TUNE;\n        };\n    }\n}\nEOF\nmkdir -p /tmp/w/tools/preview/src/preview && python3 - <<'EOF'\nimport json\nmods=json.load(open('/tmp/w/modules.json'))\ncats=['HUD','VISUALS','COMBAT','CLIENT']; titles={'HUD':'HUD','VISUALS':'Visuals','COMBAT':'Combat','CLIENT':'Client'}\ndef js(s): return '\"'+s.replace('\\\\','\\\\\\\\').replace('\"','\\\\\"')+'\"'\nfmts={'percent':'v -> Math.round(v * 100) + \"%\"','meters':'v -> Math.round(v) + \" m\"','plain':'v -> String.valueOf(Math.round(v))','decimal':'v -> String.format(java.util.Locale.ROOT, \"%.1f\", v)'}\nout=[]\nout.append('package preview;\\nimport com.valkyrie.client.ui.clickgui.*;\\nimport com.valkyrie.client.ui.icon.Icon;\\nimport java.util.*;\\n')\nout.append('/** Сгенерировано из исходников клиента: реальные модули, описания и настройки. */\\npublic final class FakeModel implements GuiModel {\\n')\nout.append('  boolean dark; final List<Category> cats = new ArrayList<>();\\n  public boolean dark() { return dark; }\\n  public void setDark(boolean d) { dark = d; }\\n  public List<Category> categories() { return cats; }\\n')\nout.append('''  record Cat(String title, Icon icon, List<Module> modules) implements Category {}\n  static final class Mod implements Module {\n    final String name, desc; boolean on; final boolean toggle; final String action; final List<Option> opts = new ArrayList<>(); boolean expanded;\n    Mod(String n, String d, boolean on, boolean toggle, String action) { name = n; desc = d; this.on = on; this.toggle = toggle; this.action = action; }\n    public String name() { return name; } public String description() { return desc; } public Icon icon() { return ModuleIcons.forModule(name); }\n    public boolean toggleable() { return toggle; } public boolean enabled() { return on; } public void toggle() { on = !on; }\n    public String actionLabel() { return action; } public List<Option> options() { return opts; }\n    public boolean expanded() { return expanded; } public void setExpanded(boolean e) { expanded = e; }\n  }\n  static final class B implements BoolOption { final String n, d; boolean v; B(String n, String d, boolean v) { this.n = n; this.d = d; this.v = v; }\n    public String name() { return n; } public String description() { return d; } public boolean value() { return v; } public void set(boolean x) { v = x; } }\n  static final class S implements SliderOption { final String n; float v; final float lo, hi; final java.util.function.Function<Float,String> f;\n    S(String n, float v, float lo, float hi, java.util.function.Function<Float,String> f) { this.n = n; this.v = v; this.lo = lo; this.hi = hi; this.f = f; }\n    public String name() { return n; } public float min() { return lo; } public float max() { return hi; } public float value() { return v; } public void set(float x) { v = x; } public String label() { return f.apply(v); } }\n  static final class M implements ModeOption { final String n; final List<String> ms; String v; M(String n, List<String> ms, String v) { this.n = n; this.ms = ms; this.v = v; }\n    public String name() { return n; } public List<String> modes() { return ms; } public String value() { return v; } public void set(String x) { v = x; } }\n  static final class C implements ColorOption { final String n; int v; final boolean accent; C(String n, int v, boolean accent) { this.n = n; this.v = v; this.accent = accent; }\n    public String name() { return n; } public int value() { return v; } public void set(int x) { v = x; }\n    public int[] swatches() { return accent ? new int[] {0xFFDF91AA, 0xFFB3A0D2, 0xFFE39A6E, 0xFF93B47E, 0xFF8FB4DE} : new int[] {0xFFDF91AA, 0xFFB3A0D2, 0xFF8FB4DE, 0xFF93B47E, 0xFFE39A6E, 0xFFF2D28C, 0xFFFFFFFF}; } }\n''')\nout.append('  public FakeModel() {\\n')\nfor cat in cats:\n    out.append(f'    {{ List<Module> l = new ArrayList<>(); cats.add(new Cat({js(titles[cat])}, ModuleIcons.forCategory({js(titles[cat])}), l));\\n')\n    for m in [m for m in mods if m['cat']==cat]:\n        act = js('Open') if m['action'] else 'null'\n        out.append(f'      {{ Mod m = new Mod({js(m[\"name\"])}, {js(m[\"desc\"])}, {str(m[\"enabled\"]).lower()}, {str(m[\"toggle\"]).lower()}, {act}); l.add(m);\\n')\n        for s in m['settings']:\n            k=s['kind']\n            if k=='Bool': out.append(f'        m.opts.add(new B({js(s[\"name\"])}, {js(s[\"desc\"])}, {str(s[\"value\"]).lower()}));\\n')\n            elif k=='Slider': out.append(f'        m.opts.add(new S({js(s[\"name\"])}, {s[\"value\"]}f, {s[\"min\"]}f, {s[\"max\"]}f, {fmts.get(s[\"fmt\"],fmts[\"plain\"])}));\\n')\n            elif k=='Mode': out.append(f'        m.opts.add(new M({js(s[\"name\"])}, List.of({\", \".join(js(o) for o in s[\"options\"])}), {js(s[\"value\"])}));\\n')\n            elif k=='Color': out.append(f'        m.opts.add(new C({js(s[\"name\"])}, 0x{s[\"value\"]:08X}, {\"true\" if m[\"name\"]==\"Appearance\" else \"false\"}));\\n')\n        out.append('      }\\n')\n    out.append('    }\\n')\nout.append('  }\\n  Module find(String name) { for (Category c : cats) for (Module m : c.modules()) if (m.name().equals(name)) return m; return null; }\\n}\\n')\nopen('/tmp/w/tools/preview/src/preview/FakeModel.java','w').write(''.join(out))\nprint('ok')\nEOF\ngrep -c 'new Mod' /tmp/w/tools/preview/src/preview/FakeModel.java","description":"Add module icon map and generate fake model"}
