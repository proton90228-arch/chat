  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/clickgui && python3 - <<'EOF'\np='GuiModel.java'; s=open(p).read()\ns=s.replace(\"\"\"        List<Option> options();\n    }\n\"\"\",\"\"\"        List<Option> options();\n\n        /** Раскрыт ли список настроек (сохраняется между открытиями). */\n        default boolean expanded() {\n            return false;\n        }\n\n        default void setExpanded(boolean expanded) {\n        }\n    }\n\"\"\",1)\nopen(p,'w').write(s)\nEOF\ncat > ClickGuiView.java <<'EOF'\npackage com.valkyrie.client.ui.clickgui;\n\nimport com.valkyrie.client.ui.color.Argb;\nimport com.valkyrie.client.ui.color.Role;\nimport com.valkyrie.client.ui.icon.Icon;\nimport com.valkyrie.client.ui.motion.Motion;\nimport com.valkyrie.client.ui.motion.Spring;\nimport com.valkyrie.client.ui.motion.SpringSpec;\nimport com.valkyrie.client.ui.render.Ui;\nimport com.valkyrie.client.ui.text.TypeStyle;\nimport com.valkyrie.client.ui.theme.Elevation;\nimport com.valkyrie.client.ui.theme.UiTheme;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.IdentityHashMap;\nimport java.util.List;\nimport java.util.Locale;\nimport java.util.Map;\n\n/**\n * ClickGUI «гибрид»: единое окно с навигационным рейлом слева (как в лаунчере)\n * и карточками модулей в колонках справа. Настройки раскрываются прямо в карточке,\n * окно складывается в рейл («Book Fold»). Не зависит от Minecraft: рисует через {@link Ui},\n * ввод получает в координатах GUI.\n */\npublic final class ClickGuiView {\n    public enum Sound { NAV, CLICK, TOGGLE_ON, TOGGLE_OFF, EXPAND, COLLAPSE, SLIDER, OPEN, CLOSE }\n\n    /** Связь с игрой: звуки, закрытие, модель игрока, сохранение состояния. */\n    public interface Host {\n        void sound(Sound sound);\n\n        void close();\n\n        default void companion(Ui ui, float x, float y, float w, float h, float alpha) {\n        }\n\n        default String playerName() {\n            return \"Player\";\n        }\n\n        default void stateChanged(int category, boolean folded) {\n        }\n    }\n\n    // ─── Размеры (единицы GUI) ──────────────────────────────────────────────\n    private static final float RAIL_W = 64.0f;\n    private static final float RADIUS = 18.0f;\n    private static final float CARD_R = 12.0f;\n    private static final float HEAD_H = 36.0f;\n    private static final float GAP = 8.0f;\n    private static final float MIN_CARD_W = 150.0f;\n    private static final float NAV_TOP = 46.0f;\n    private static final float NAV_STEP = 40.0f;\n\n    private final GuiModel model;\n    private final Host host;\n\n    private int category;\n    private boolean folded;\n    private boolean closing;\n    private final Spring appear = new Spring(0.0f, SpringSpec.EXPRESSIVE_DEFAULT_SPATIAL, 0.001f);\n    private final Spring fold = new Spring(0.0f, SpringSpec.EXPRESSIVE_DEFAULT_SPATIAL, 0.001f);\n    private final Spring navY = new Spring(0.0f, SpringSpec.EXPRESSIVE_FAST_SPATIAL, 0.001f);\n    private final Spring navGrow = new Spring(1.0f, SpringSpec.EXPRESSIVE_FAST_SPATIAL, 0.001f);\n    private final Spring contentIn = new Spring(1.0f, SpringSpec.EXPRESSIVE_DEFAULT_SPATIAL, 0.001f);\n    private final Spring scroll = new Spring(0.0f, SpringSpec.STANDARD_DEFAULT_SPATIAL, 0.02f);\n    private final Spring searchFocusS = new Spring(0.0f, SpringSpec.DEFAULT_EFFECTS, 0.002f);\n    private final Spring scrollbar = new Spring(0.0f, SpringSpec.DEFAULT_EFFECTS, 0.002f);\n    private final Spring menuS = new Spring(0.0f, SpringSpec.EXPRESSIVE_FAST_SPATIAL, 0.001f);\n    private float scrollTarget;\n    private float lastScrollAt = -10.0f;\n    private int contentDirection = 1;\n\n    private String query = \"\";\n    private boolean searchFocus;\n\n    private final Map<Object, Spring> hovers = new HashMap<>();\n    private final Map<GuiModel.Module, Card> cards = new IdentityHashMap<>();\n    private final Map<Object, Spring> toggles = new IdentityHashMap<>();\n    private List<Hot> hots = new ArrayList<>();\n    private List<Hot> lastHots = new ArrayList<>();\n    private final float[] clip = new float[4 * 8];\n    private int clipDepth;\n    private Object hoverKey;\n    private float mx = -1000.0f;\n    private float my = -1000.0f;\n\n    private GuiModel.ModeOption menu;\n    private GuiModel.ModeOption menuShown;\n    private float menuX;\n    private float menuY;\n    private float menuW;\n\n    private GuiModel.SliderOption drag;\n    private float dragX;\n    private float dragW;\n    private String dragLabel = \"\";\n    private float dragSoundAt;\n    private final Spring dragS = new Spring(0.0f, SpringSpec.FAST_EFFECTS, 0.002f);\n\n    private static final class Card {\n        final Spring expand = new Spring(0.0f, SpringSpec.EXPRESSIVE_DEFAULT_SPATIAL, 0.001f);\n        final Spring toggle = new Spring(0.0f, SpringSpec.EXPRESSIVE_FAST_SPATIAL, 0.001f);\n        final Spring appear = new Spring(0.0f, SpringSpec.EXPRESSIVE_DEFAULT_SPATIAL, 0.001f);\n        final Spring press = new Spring(0.0f, SpringSpec.FAST_EFFECTS, 0.002f);\n        boolean expanded;\n        float appearAt = -1.0f;\n    }\n\n    /** Активная зона ввода текущего кадра. */\n    private interface Action {\n        void run(int button, float x, float y);\n    }\n\n    private record Hot(float x0, float y0, float x1, float y1, Object key, Action action) {\n        boolean contains(float x, float y) {\n            return x >= x0 && x < x1 && y >= y0 && y < y1;\n        }\n    }\n\n    public ClickGuiView(GuiModel model, Host host, int category, boolean folded) {\n        this.model = model;\n        this.host = host;\n        this.category = Math.max(0, Math.min(category, model.categories().size() - 1));\n        this.folded = folded;\n        fold.snap(folded ? 1.0f : 0.0f);\n        navY.snap(this.category);\n        appear.target(1.0f);\n        stagger(visibleModules(), 0.06f);\n    }\n\n    // ─── Состояние ──────────────────────────────────────────────────────────\n\n    public int category() {\n        return category;\n    }\n\n    public boolean folded() {\n        return folded;\n    }\n\n    public boolean closing() {\n        return closing;\n    }\n\n    /** Запуск анимации закрытия; экран закроется через {@link Host#close()}. */\n    public void requestClose() {\n        if (!closing) {\n            closing = true;\n            appear.spec(SpringSpec.FAST_EFFECTS).target(0.0f);\n            host.sound(Sound.CLOSE);\n        }\n    }\n\n    private List<GuiModel.Module> visibleModules() {\n        List<GuiModel.Module> out = new ArrayList<>();\n        String q = query.trim().toLowerCase(Locale.ROOT);\n        if (q.isEmpty()) {\n            out.addAll(model.categories().get(category).modules());\n            return out;\n        }\n        for (GuiModel.Category c : model.categories()) {\n            for (GuiModel.Module m : c.modules()) {\n                if (m.name().toLowerCase(Locale.ROOT).contains(q) || m.description().toLowerCase(Locale.ROOT).contains(q)\n                    || c.title().toLowerCase(Locale.ROOT).startsWith(q)) {\n                    out.add(m);\n                }\n            }\n        }\n        return out;\n    }\n\n    private Card card(GuiModel.Module m) {\n        Card c = cards.get(m);\n        if (c == null) {\n            c = new Card();\n            c.expanded = m.expanded();\n            c.expand.snap(c.expanded ? 1.0f : 0.0f);\n            c.toggle.snap(m.toggleable() && m.enabled() ? 1.0f : 0.0f);\n            cards.put(m, c);\n        }\n        return c;\n    }\n\n    private void stagger(List<GuiModel.Module> list, float delay) {\n        float now = Motion.time();\n        for (int i = 0; i < list.size(); i++) {\n            Card c = card(list.get(i));\n            c.appear.snap(0.0f);\n            c.appearAt = now + delay + Math.min(i, 14) * 0.022f;\n        }\n    }\n\n    private Spring hover(Object key) {\n        Spring s = hovers.computeIfAbsent(key, k -> new Spring(0.0f, SpringSpec.DEFAULT_EFFECTS, 0.002f));\n        s.target(key.equals(hoverKey) ? 1.0f : 0.0f);\n        return s;\n    }\n\n    private Spring toggleSpring(Object key, boolean on) {\n        Spring s = toggles.computeIfAbsent(key, k -> new Spring(on ? 1.0f : 0.0f, SpringSpec.EXPRESSIVE_FAST_SPATIAL, 0.001f));\n        s.target(on ? 1.0f : 0.0f);\n        return s;\n    }\n\n    private void hot(float x0, float y0, float x1, float y1, Object key, Action action) {\n        if (clipDepth > 0) {\n            int i = (clipDepth - 1) * 4;\n            x0 = Math.max(x0, clip[i]);\n            y0 = Math.max(y0, clip[i + 1]);\n            x1 = Math.min(x1, clip[i + 2]);\n            y1 = Math.min(y1, clip[i + 3]);\n        }\n        if (x1 > x0 && y1 > y0) {\n            hots.add(new Hot(x0, y0, x1, y1, key, action));\n        }\n    }\n\n    private void pushHotClip(float x0, float y0, float x1, float y1) {\n        if (clipDepth > 0) {\n            int i = (clipDepth - 1) * 4;\n            x0 = Math.max(x0, clip[i]);\n            y0 = Math.max(y0, clip[i + 1]);\n            x1 = Math.min(x1, clip[i + 2]);\n            y1 = Math.min(y1, clip[i + 3]);\n        }\n        int j = clipDepth * 4;\n        clip[j] = x0;\n        clip[j + 1] = y0;\n        clip[j + 2] = x1;\n        clip[j + 3] = y1;\n        clipDepth++;\n    }\n\n    private void popHotClip() {\n        clipDepth--;\n    }\n\n    private static int c(Role role) {\n        return UiTheme.c(role);\n    }\n\n    private static int c(Role role, float alpha) {\n        return UiTheme.c(role, alpha);\n    }\n\n    private static float clamp01(float v) {\n        return v < 0.0f ? 0.0f : Math.min(1.0f, v);\n    }\n\n    private static float lerp(float a, float b, float t) {\n        return a + (b - a) * t;\n    }\n\n    // ─── Отрисовка ──────────────────────────────────────────────────────────\n\n    /** Кадр интерфейса. {@code Motion.beginFrame()} вызывает владелец экрана. */\n    public void render(Ui ui, float mouseX, float mouseY) {\n        mx = mouseX;\n        my = mouseY;\n        hoverKey = null;\n        if (drag == null) {\n            for (int i = lastHots.size() - 1; i >= 0; i--) {\n                Hot h = lastHots.get(i);\n                if (h.contains(mx, my)) {\n                    hoverKey = h.key();\n                    break;\n                }\n            }\n        } else {\n            hoverKey = drag;\n        }\n        hots = new ArrayList<>();\n        clipDepth = 0;\n\n        float a = appear.value();\n        if (closing && a < 0.04f) {\n            host.close();\n        }\n        float alpha = clamp01(a);\n        float sw = ui.width();\n        float sh = ui.height();\n\n        // Мягкий скрим поверх размытого мира: читаемость без «чёрного занавеса».\n        ui.gradient(0, 0, sw, sh, c(Role.SCRIM, 0.10f * alpha), c(Role.SCRIM, 0.28f * alpha));\n\n        float winW = Math.max(360.0f, Math.min(sw - 48.0f, 660.0f));\n        float winH = Math.max(230.0f, Math.min(sh - 40.0f, 392.0f));\n        float x = Math.round((sw - winW) / 2.0f);\n        float y = Math.round((sh - winH) / 2.0f);\n        float rise = (1.0f - a) * 14.0f;\n\n        ui.pushAlpha(alpha);\n        ui.push(0.0f, rise);\n        drawCompanion(ui, x, y, winH, alpha);\n        drawWindow(ui, x, y, winW, winH);\n        ui.pop();\n        ui.popAlpha();\n        drawMenu(ui);\n\n        List<Hot> swap = lastHots;\n        lastHots = hots;\n        swap.clear();\n        hots = swap;\n    }\n\n    private void drawCompanion(Ui ui, float winX, float winY, float winH, float alpha) {\n        float w = 86.0f;\n        float h = 124.0f;\n        float x = winX - 14.0f - w;\n        if (x < 10.0f) {\n            return;\n        }\n        float y = winY + winH - h;\n        ui.elevation(x, y, w, h, 16, Elevation.LEVEL2);\n        ui.round(x, y, w, h, 16, c(Role.SURFACE_CONTAINER, 0.94f));\n        ui.round(x + 5, y + 5, w - 10, h - 26, 12, c(Role.SURFACE_CONTAINER_HIGH, 0.9f));\n        host.companion(ui, x + 5, y + 5, w - 10, h - 26, alpha);\n        String name = ui.ellipsize(TypeStyle.LABEL_MEDIUM, host.playerName(), w - 14);\n        ui.textCentered(TypeStyle.LABEL_MEDIUM, name, x + w / 2.0f, y + h - 18.5f, c(Role.ON_SURFACE));\n    }\n\n    private void drawWindow(Ui ui, float x, float y, float winW, float winH) {\n        float f = fold.value();\n        float curW = RAIL_W + (winW - RAIL_W) * Math.max(0.0f, 1.0f - f);\n        boolean dark = UiTheme.dark();\n        ui.elevation(x, y, curW, winH, RADIUS, Elevation.LEVEL3);\n        ui.round(x, y, curW, winH, RADIUS, c(Role.SURFACE_CONTAINER, dark ? 0.95f : 0.965f));\n        ui.outline(x, y, curW, winH, RADIUS, 0.5f, c(Role.OUTLINE_VARIANT, dark ? 0.55f : 0.7f));\n        hot(x, y, x + curW, y + winH, \"window\", (b, mx2, my2) -> { });\n\n        drawRail(ui, x, y, winH);\n        float visible = clamp01(1.0f - f);\n        if (visible > 0.01f) {\n            ui.clip(x + RAIL_W - 2, y, curW - RAIL_W + 2, winH);\n            pushHotClip(x + RAIL_W - 2, y, x + curW, y + winH);\n            ui.pushAlpha(clamp01(1.0f - f * 1.5f));\n            drawContent(ui, x + RAIL_W, y, winW - RAIL_W, winH);\n            ui.popAlpha();\n            popHotClip();\n            ui.unclip();\n        }\n    }\n\n    // ─── Рейл ───────────────────────────────────────────────────────────────\n\n    private void drawRail(Ui ui, float x, float y, float h) {\n        float cx = x + RAIL_W / 2.0f;\n        ui.icon(Icon.SAKURA, cx - 9.0f, y + 13.0f, 18.0f, c(Role.BRAND));\n        List<GuiModel.Category> cats = model.categories();\n        boolean searching = !query.isBlank();\n\n        // Индикатор активного пункта: скользит пружиной и «распускается» по ширине.\n        float iy = y + NAV_TOP + navY.value() * NAV_STEP;\n        float grow = clamp01(navGrow.value());\n        float iw = 32.0f * (0.45f + 0.55f * grow);\n        ui.pill(cx - iw / 2.0f, iy, iw, 18.0f, c(Role.SECONDARY_CONTAINER, searching ? 0.45f : 1.0f));\n\n        for (int i = 0; i < cats.size(); i++) {\n            GuiModel.Category cat = cats.get(i);\n            float ty = y + NAV_TOP + i * NAV_STEP;\n            String key = \"nav:\" + i;\n            float hv = hover(key).value01();\n            boolean active = i == category && !searching;\n            if (hv > 0.0f) {\n                ui.pill(cx - 16.0f, ty, 32.0f, 18.0f, c(active ? Role.ON_SECONDARY_CONTAINER : Role.ON_SURFACE, 0.08f * hv));\n            }\n            int iconColor = active ? c(Role.ON_SECONDARY_CONTAINER) : c(Role.ON_SURFACE_VARIANT);\n            ui.icon(cat.icon(), cx - 6.0f, ty + 3.0f, 12.0f, iconColor, active ? 1.12f : 1.0f);\n            ui.textCentered(TypeStyle.LABEL_SMALL, cat.title(), cx, ty + 19.5f, active ? c(Role.ON_SURFACE) : c(Role.ON_SURFACE_VARIANT));\n            final int index = i;\n            hot(x + 4, ty - 3, x + RAIL_W - 4, ty + 30, key, (b, px, py) -> selectCategory(index));\n        }\n\n        // Нижние действия: тема и складывание.\n        float by = y + h - 32.0f;\n        iconButton(ui, model.dark() ? Icon.SUN : Icon.MOON, cx, by - 26.0f, \"rail:theme\", () -> {\n            model.setDark(!model.dark());\n            host.sound(Sound.CLICK);\n        });\n        iconButton(ui, folded ? Icon.DOCK_OPEN : Icon.DOCK_CLOSE, cx, by, \"rail:fold\", this::toggleFold);\n    }\n\n    private void iconButton(Ui ui, Icon icon, float cx, float y, String key, Runnable action) {\n        float hv = hover(key).value01();\n        if (hv > 0.0f) {\n            ui.circle(cx, y + 11.0f, 11.0f, c(Role.ON_SURFACE, 0.08f * hv));\n        }\n        ui.icon(icon, cx - 6.0f, y + 5.0f, 12.0f, c(Role.ON_SURFACE_VARIANT));\n        hot(cx - 11.0f, y, cx + 11.0f, y + 22.0f, key, (b, px, py) -> action.run());\n    }\n\n    // ─── Контент ────────────────────────────────────────────────────────────\n\n    private void drawContent(Ui ui, float x, float y, float w, float h) {\n        float right = x + w - 14.0f;\n        float left = x + 6.0f;\n        boolean searching = !query.isBlank();\n        List<GuiModel.Module> list = visibleModules();\n\n        // Заголовок.\n        float fadeIn = clamp01(contentIn.value());\n        float slide = (1.0f - contentIn.value()) * 10.0f * contentDirection;\n        String title = searching ? \"Search\" : model.categories().get(category).title();\n        int on = 0;\n        for (GuiModel.Module m : list) {\n            if (m.toggleable() && m.enabled()) {\n                on++;\n            }\n        }\n        String subtitle = searching\n            ? list.size() + (list.size() == 1 ? \" result\" : \" results\")\n            : list.size() + \" modules  ·  \" + on + \" on\";\n        ui.pushAlpha(fadeIn);\n        ui.text(TypeStyle.HEADLINE_SMALL, title, left + 2, y + 12.0f + slide * 0.4f, c(Role.ON_SURFACE));\n        ui.text(TypeStyle.BODY_SMALL, subtitle, left + 2, y + 28.5f + slide * 0.4f, c(Role.ON_SURFACE_VARIANT));\n        ui.popAlpha();\n\n        // Кнопка закрытия и поиск.\n        float closeCx = right - 10.0f;\n        iconButton(ui, Icon.CLOSE, closeCx, y + 12.0f, \"close\", this::requestClose);\n        float searchW = Math.min(176.0f, w * 0.40f);\n        drawSearch(ui, closeCx - 16.0f - searchW, y + 13.0f, searchW, 20.0f);\n\n        // Сетка карточек.\n        float gx0 = left;\n        float gx1 = right;\n        float gy0 = y + 46.0f;\n        float gy1 = y + h - 8.0f;\n        float gw = gx1 - gx0;\n        int cols = Math.max(1, (int) ((gw + GAP) / (MIN_CARD_W + GAP)));\n        float cw = (gw - GAP * (cols - 1)) / cols;\n        float[] colY = new float[cols];\n        float[] cardY = new float[list.size()];\n        float[] cardH = new float[list.size()];\n        for (int i = 0; i < list.size(); i++) {\n            GuiModel.Module m = list.get(i);\n            Card cd = card(m);\n            int col = i % cols;\n            cardH[i] = cardHeight(ui, m, cd, cw);\n            cardY[i] = colY[col];\n            colY[col] += cardH[i] + GAP;\n        }\n        float contentH = 0.0f;\n        for (float v : colY) {\n            contentH = Math.max(contentH, v - GAP);\n        }\n        float viewH = gy1 - gy0;\n        float maxScroll = Math.max(0.0f, contentH - viewH + 10.0f);\n        scrollTarget = Math.max(0.0f, Math.min(scrollTarget, maxScroll));\n        scroll.target(scrollTarget);\n        float sc = scroll.value();\n\n        ui.clip(gx0 - 8.0f, gy0, gw + 16.0f, viewH);\n        pushHotClip(gx0 - 8.0f, gy0, gx1 + 8.0f, gy1);\n        ui.pushAlpha(fadeIn);\n        for (int i = 0; i < list.size(); i++) {\n            float cy = gy0 + 2.0f + cardY[i] - sc + slide;\n            if (cy + cardH[i] < gy0 - 24.0f || cy > gy1 + 24.0f) {\n                continue;\n            }\n            float cx = gx0 + (i % cols) * (cw + GAP);\n            drawCard(ui, list.get(i), card(list.get(i)), cx, cy, cw, cardH[i]);\n        }\n        ui.popAlpha();\n        if (list.isEmpty()) {\n            drawEmpty(ui, (gx0 + gx1) / 2.0f, gy0 + viewH * 0.32f);\n        }\n        popHotClip();\n        ui.unclip();\n        hot(gx0 - 8.0f, gy0, gx1 + 8.0f, gy1, \"grid\", (b, px, py) -> { });\n\n        // Полоса прокрутки — появляется при прокрутке и наведении.\n        if (maxScroll > 0.5f) {\n            boolean recent = Motion.time() - lastScrollAt < 0.9f;\n            boolean over = mx >= gx0 && mx <= gx1 + 12 && my >= gy0 && my <= gy1;\n            scrollbar.target(recent || over ? 1.0f : 0.0f);\n            float sa = scrollbar.value01();\n            if (sa > 0.01f) {\n                float trackH = viewH - 8.0f;\n                float thumbH = Math.max(18.0f, trackH * viewH / (contentH + 10.0f));\n                float thumbY = gy0 + 4.0f + (trackH - thumbH) * (sc / maxScroll);\n                ui.pill(gx1 + 5.0f, thumbY, 3.0f, thumbH, c(Role.ON_SURFACE_VARIANT, 0.45f * sa));\n            }\n        }\n    }\n\n    private void drawEmpty(Ui ui, float cx, float cy) {\n        ui.circle(cx, cy, 18.0f, c(Role.SURFACE_CONTAINER_HIGHEST));\n        ui.icon(Icon.SEARCH, cx - 9.0f, cy - 9.0f, 18.0f, c(Role.ON_SURFACE_VARIANT));\n        ui.textCentered(TypeStyle.TITLE_SMALL, \"Nothing found\", cx, cy + 24.0f, c(Role.ON_SURFACE));\n        ui.textCentered(TypeStyle.BODY_SMALL, \"No module matches “\" + query.trim() + \"”\", cx, cy + 35.0f, c(Role.ON_SURFACE_VARIANT));\n    }\n\n    private void drawSearch(Ui ui, float x, float y, float w, float h) {\n        float focus = searchFocusS.target(searchFocus ? 1.0f : 0.0f).value01();\n        float hv = hover(\"search\").value01();\n        int bg = Argb.layer(c(Role.SURFACE_CONTAINER_HIGHEST), c(Role.ON_SURFACE), 0.05f * hv);\n        ui.pill(x, y, w, h, bg);\n        if (focus > 0.0f) {\n            ui.outline(x, y, w, h, h / 2.0f, 1.0f, c(Role.PRIMARY, focus));\n        }\n        ui.icon(Icon.SEARCH, x + 6.0f, y + 4.5f, 11.0f, focus > 0.5f ? c(Role.PRIMARY) : c(Role.ON_SURFACE_VARIANT));\n        float tx = x + 21.0f;\n        float maxText = w - 21.0f - (query.isEmpty() ? 8.0f : 20.0f);\n        ui.clip(tx, y, maxText + 2.0f, h);\n        if (query.isEmpty()) {\n            ui.text(TypeStyle.BODY_MEDIUM, searchFocus ? \"Type to search\" : \"Search modules\", tx, y + 5.25f, c(Role.ON_SURFACE_VARIANT, 0.9f));\n        } else {\n            float tw = ui.textWidth(TypeStyle.BODY_MEDIUM, query);\n            float shift = Math.max(0.0f, tw - maxText + 2.0f);\n            ui.text(TypeStyle.BODY_MEDIUM, query, tx - shift, y + 5.25f, c(Role.ON_SURFACE));\n            if (searchFocus && (Motion.time() * 1.6f) % 1.0f < 0.6f) {\n                ui.rect(tx - shift + tw + 0.75f, y + 5.0f, 0.75f, 10.0f, c(Role.PRIMARY));\n            }\n        }\n        if (query.isEmpty() && searchFocus && (Motion.time() * 1.6f) % 1.0f < 0.6f) {\n            ui.rect(tx - 0.5f, y + 5.0f, 0.75f, 10.0f, c(Role.PRIMARY));\n        }\n        ui.unclip();\n        if (!query.isEmpty()) {\n            float cx = x + w - 10.0f;\n            float chv = hover(\"search:clear\").value01();\n            ui.circle(cx, y + h / 2.0f, 7.0f, c(Role.ON_SURFACE, 0.08f * chv));\n            ui.icon(Icon.CLOSE, cx - 4.5f, y + h / 2.0f - 4.5f, 9.0f, c(Role.ON_SURFACE_VARIANT));\n            hot(cx - 8.0f, y, cx + 8.0f, y + h, \"search:clear\", (b, px, py) -> {\n                setQuery(\"\");\n                host.sound(Sound.CLICK);\n            });\n        }\n        hot(x, y, x + w, y + h, \"search\", (b, px, py) -> {\n            searchFocus = true;\n            if (folded) {\n                toggleFold();\n            }\n        });\n    }\n\n    // ─── Карточка модуля ────────────────────────────────────────────────────\n\n    private float cardHeight(Ui ui, GuiModel.Module m, Card cd, float w) {\n        float e = cd.expand.value();\n        if (e <= 0.001f) {\n            return HEAD_H;\n        }\n        return HEAD_H + Math.max(0.0f, optionsHeight(ui, m, w) * e);\n    }\n\n    private float optionsHeight(Ui ui, GuiModel.Module m, float w) {\n        float total = 6.0f;\n        for (GuiModel.Option o : m.options()) {\n            if (o.visible()) {\n                total += rowHeight(ui, o, w);\n            }\n        }\n        return total + 6.0f;\n    }\n\n    private float rowHeight(Ui ui, GuiModel.Option o, float w) {\n        if (o instanceof GuiModel.BoolOption) {\n            return o.description().isEmpty() ? 18.0f : 24.0f;\n        }\n        if (o instanceof GuiModel.SliderOption) {\n            return 27.0f;\n        }\n        if (o instanceof GuiModel.ModeOption mode) {\n            return segmented(ui, mode, w - 20.0f) ? 31.0f : 19.0f;\n        }\n        if (o instanceof GuiModel.ColorOption) {\n            return 29.0f;\n        }\n        return 18.0f;\n    }\n\n    private boolean segmented(Ui ui, GuiModel.ModeOption mode, float width) {\n        List<String> modes = mode.modes();\n        if (modes.size() < 2 || modes.size() > 3) {\n            return false;\n        }\n        float seg = width / modes.size();\n        for (String s : modes) {\n            if (ui.textWidth(TypeStyle.LABEL_MEDIUM, s) + 16.0f > seg) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    private void drawCard(Ui ui, GuiModel.Module m, Card cd, float x, float y, float w, float h) {\n        if (cd.appearAt >= 0.0f && Motion.time() >= cd.appearAt) {\n            cd.appear.target(1.0f);\n            cd.appearAt = -1.0f;\n        } else if (cd.appearAt < 0.0f && cd.appear.target() < 1.0f) {\n            cd.appear.target(1.0f);\n        }\n        float ap = cd.appear.value();\n        if (ap <= 0.001f) {\n            return;\n        }\n        boolean dark = UiTheme.dark();\n        cd.toggle.target(m.toggleable() && m.enabled() ? 1.0f : 0.0f);\n        float on = cd.toggle.value01();\n        float hv = hover(m).value01();\n        float press = cd.press.target(0.0f).value01();\n\n        ui.pushAlpha(clamp01(ap));\n        ui.push(0.0f, (1.0f - ap) * 10.0f - hv * 0.75f);\n        if (hv > 0.0f) {\n            ui.elevation(x, y, w, h, CARD_R, Elevation.LEVEL2, hv * 0.85f);\n        }\n        int base = c(dark ? Role.SURFACE_CONTAINER_HIGH : Role.SURFACE_CONTAINER_LOWEST);\n        int bg = Argb.mixOklab(base, c(Role.PRIMARY_CONTAINER), on * (dark ? 0.30f : 0.42f));\n        bg = Argb.layer(bg, c(Role.ON_SURFACE), 0.035f * hv + 0.07f * press);\n        ui.round(x, y, w, h, CARD_R + press * 2.0f, bg);\n\n        // Ведущая иконка в тональном круге.\n        float icx = x + 18.5f;\n        float icy = y + HEAD_H / 2.0f;\n        int icBg = Argb.mixOklab(c(dark ? Role.SURFACE_CONTAINER_HIGHEST : Role.SURFACE_CONTAINER_HIGH), c(Role.PRIMARY), on);\n        int icFg = Argb.mixOklab(c(Role.ON_SURFACE_VARIANT), c(Role.ON_PRIMARY), on);\n        ui.circle(icx, icy, 10.5f, icBg);\n        ui.icon(m.icon(), icx - 6.0f, icy - 6.0f, 12.0f, icFg);\n\n        // Хвост: переключатель / кнопка действия, шеврон настроек.\n        float right = x + w - 9.0f;\n        float trailing = right;\n        String action = m.actionLabel();\n        if (action != null) {\n            float bw = ui.textWidth(TypeStyle.LABEL_MEDIUM, action) + 16.0f;\n            float bx = right - bw;\n            float bhv = hover(\"act:\" + m.name()).value01();\n            ui.pill(bx, icy - 8.0f, bw, 16.0f, Argb.layer(c(Role.SECONDARY_CONTAINER), c(Role.ON_SECONDARY_CONTAINER), 0.08f * bhv));\n            ui.textCentered(TypeStyle.LABEL_MEDIUM, action, bx + bw / 2.0f, icy - 4.25f, c(Role.ON_SECONDARY_CONTAINER));\n            hot(bx, icy - 8.0f, right, icy + 8.0f, \"act:\" + m.name(), (b, px, py) -> {\n                host.sound(Sound.CLICK);\n                m.action();\n            });\n            trailing = bx;\n        } else if (m.toggleable()) {\n            float tw = 26.0f;\n            drawSwitch(ui, right - tw, icy - 7.0f, tw, 14.0f, cd.toggle.value(), press, hv);\n            trailing = right - tw;\n        }\n        boolean hasOptions = !m.options().isEmpty();\n        if (hasOptions) {\n            float chx = trailing - 11.0f;\n            String key = \"chev:\" + m.name();\n            float chv = hover(key).value01();\n            float ex = cd.expand.value01();\n            if (chv > 0.0f) {\n                ui.circle(chx, icy, 8.5f, c(Role.ON_SURFACE, 0.08f * chv));\n            }\n            ui.icon(ex > 0.5f ? Icon.CHEVRON_UP : Icon.CHEVRON_DOWN, chx - 5.0f, icy - 5.0f, 10.0f,\n                ex > 0.5f ? c(Role.PRIMARY) : c(Role.ON_SURFACE_VARIANT));\n            hot(chx - 9.0f, icy - 9.0f, chx + 9.0f, icy + 9.0f, key, (b, px, py) -> toggleExpand(m, cd));\n            trailing = chx - 9.0f;\n        }\n\n        // Название и описание.\n        float tx = x + 34.0f;\n        float avail = trailing - tx - 4.0f;\n        ui.text(TypeStyle.TITLE_SMALL, ui.ellipsize(TypeStyle.TITLE_SMALL, m.name(), avail), tx, y + 7.5f, c(Role.ON_SURFACE));\n        ui.text(TypeStyle.BODY_SMALL, ui.ellipsize(TypeStyle.BODY_SMALL, m.description(), avail), tx, y + 18.0f, c(Role.ON_SURFACE_VARIANT));\n\n        hot(x, y, x + w, y + HEAD_H, m, (b, px, py) -> {\n            if (b == 1) {\n                if (hasOptions) {\n                    toggleExpand(m, cd);\n                }\n            } else if (m.toggleable()) {\n                m.toggle();\n                cd.press.snap(1.0f);\n                host.sound(m.enabled() ? Sound.TOGGLE_ON : Sound.TOGGLE_OFF);\n            } else if (action != null) {\n                host.sound(Sound.CLICK);\n                m.action();\n            } else if (hasOptions) {\n                toggleExpand(m, cd);\n            }\n        });\n        hot(x, y + HEAD_H, x + w, y + h, \"body:\" + m.name(), (b, px, py) -> { });\n\n        // Настройки (раскрытие на месте).\n        if (h > HEAD_H + 0.5f) {\n            float ex = cd.expand.value01();\n            ui.clip(x, y + HEAD_H, w, h - HEAD_H);\n            pushHotClip(x, y + HEAD_H, x + w, y + h);\n            ui.rect(x + 12.0f, y + HEAD_H, w - 24.0f, 0.5f, c(Role.OUTLINE_VARIANT, 0.8f * ex));\n            float ry = y + HEAD_H + 6.0f;\n            int index = 0;\n            for (GuiModel.Option o : m.options()) {\n                if (!o.visible()) {\n                    continue;\n                }\n                float rh = rowHeight(ui, o, w);\n                float local = clamp01((ex - 0.15f - index * 0.04f) / 0.55f);\n                ui.pushAlpha(local);\n                drawOption(ui, o, x + 10.0f, ry, w - 20.0f, rh);\n                ui.popAlpha();\n                ry += rh;\n                index++;\n            }\n            popHotClip();\n            ui.unclip();\n        }\n        ui.pop();\n        ui.popAlpha();\n    }\n\n    /** Переключатель M3: дорожка, «растущий» бегунок с галочкой, ореол при наведении. */\n    private void drawSwitch(Ui ui, float x, float y, float w, float h, float onRaw, float press, float hv) {\n        float on = clamp01(onRaw);\n        ui.pill(x, y, w, h, Argb.mixOklab(c(Role.SURFACE_CONTAINER_HIGHEST), c(Role.PRIMARY), on));\n        if (on < 0.999f) {\n            ui.outline(x, y, w, h, h / 2.0f, Math.max(0.5f, h * 0.075f), c(Role.OUTLINE, 1.0f - on));\n        }\n        float dOff = h * 0.5f;\n        float dOn = h * 0.72f;\n        float d = lerp(dOff, dOn, on) + press * h * 0.12f;\n        float cxOff = x + h / 2.0f;\n        float cxOn = x + w - h / 2.0f;\n        float tcx = lerp(cxOff, cxOn, onRaw);\n        float tcy = y + h / 2.0f;\n        if (hv > 0.0f) {\n            ui.circle(tcx, tcy, h * 0.8f, c(on > 0.5f ? Role.PRIMARY : Role.ON_SURFACE, 0.10f * hv));\n        }\n        ui.circle(tcx, tcy, d / 2.0f, Argb.mixOklab(c(Role.OUTLINE), c(Role.ON_PRIMARY), on));\n        if (on > 0.5f) {\n            float is = d * 0.78f;\n            ui.icon(Icon.CHECK, tcx - is / 2.0f, tcy - is / 2.0f, is, c(Role.ON_PRIMARY_CONTAINER, (on - 0.5f) * 2.0f), 1.1f);\n        }\n    }\n\n    private void drawOption(Ui ui, GuiModel.Option o, float x, float y, float w, float h) {\n        if (o instanceof GuiModel.BoolOption b) {\n            Spring t = toggleSpring(b, b.value());\n            float hv = hover(b).value01();\n            if (hv > 0.0f) {\n                ui.round(x - 4.0f, y + 1.0f, w + 8.0f, h - 2.0f, 7.0f, c(Role.ON_SURFACE, 0.05f * hv));\n            }\n            boolean desc = !b.description().isEmpty();\n            float ty = desc ? y + 2.5f : y + 4.25f;\n            ui.text(TypeStyle.BODY_MEDIUM, ui.ellipsize(TypeStyle.BODY_MEDIUM, b.name(), w - 30.0f), x, ty, c(Role.ON_SURFACE));\n            if (desc) {\n                ui.text(TypeStyle.BODY_SMALL, ui.ellipsize(TypeStyle.BODY_SMALL, b.description(), w - 30.0f), x, y + 12.0f, c(Role.ON_SURFACE_VARIANT));\n            }\n            drawSwitch(ui, x + w - 21.0f, y + (h - 12.0f) / 2.0f, 21.0f, 12.0f, t.value(), 0.0f, hv);\n            hot(x - 4.0f, y, x + w + 4.0f, y + h, b, (btn, px, py) -> {\n                b.set(!b.value());\n                host.sound(b.value() ? Sound.TOGGLE_ON : Sound.TOGGLE_OFF);\n            });\n        } else if (o instanceof GuiModel.SliderOption s) {\n            drawSlider(ui, s, x, y, w);\n        } else if (o instanceof GuiModel.ModeOption mode) {\n            if (segmented(ui, mode, w)) {\n                drawSegmented(ui, mode, x, y, w);\n            } else {\n                drawModeChip(ui, mode, x, y, w, h);\n            }\n        } else if (o instanceof GuiModel.ColorOption col) {\n            drawSwatches(ui, col, x, y, w);\n        }\n    }\n\n    /** Слайдер M3 Expressive: толстая дорожка, вертикальная ручка с зазором, точка конца. */\n    private void drawSlider(Ui ui, GuiModel.SliderOption s, float x, float y, float w) {\n        boolean dragging = drag == s;\n        float hv = hover(s).value01();\n        ui.text(TypeStyle.BODY_MEDIUM, ui.ellipsize(TypeStyle.BODY_MEDIUM, s.name(), w - 40.0f), x, y + 1.0f, c(Role.ON_SURFACE));\n        ui.textRight(TypeStyle.LABEL_MEDIUM, s.label(), x + w, y + 1.75f, c(Role.PRIMARY));\n        float range = s.max() - s.min();\n        float t = range <= 0.0f ? 0.0f : clamp01((s.value() - s.min()) / range);\n        Spring pos = toggles.computeIfAbsent(s, k -> new Spring(t, SpringSpec.STANDARD_FAST_SPATIAL, 0.0005f));\n        pos.target(t);\n        float vt = dragging ? t : clamp01(pos.value());\n        if (dragging) {\n            pos.snap(t);\n        }\n        float ty = y + 15.0f;\n        float th = 6.0f;\n        float hx = x + 1.0f + (w - 2.0f) * vt;\n        float gap = 2.0f;\n        if (hx - gap - x > 1.0f) {\n            ui.round(x, ty, hx - gap - x, th, th / 2.0f, 1.0f, 1.0f, th / 2.0f, c(Role.PRIMARY));\n        }\n        if (x + w - hx - gap > 1.0f) {\n            ui.round(hx + gap, ty, x + w - hx - gap, th, 1.0f, th / 2.0f, th / 2.0f, 1.0f, c(Role.SECONDARY_CONTAINER));\n            ui.circle(x + w - th / 2.0f, ty + th / 2.0f, 1.0f, c(Role.ON_SECONDARY_CONTAINER, 0.9f));\n        }\n        float handleW = 2.0f - 0.6f * (dragging ? 1.0f : 0.0f) + hv * 0.4f;\n        ui.pill(hx - handleW / 2.0f, ty - 4.0f, handleW, th + 8.0f, c(Role.PRIMARY));\n        float bubble = dragS.target(dragging ? 1.0f : 0.0f).value01();\n        if (bubble > 0.01f) {\n            String label = s.label();\n            float bw = Math.max(22.0f, ui.textWidth(TypeStyle.LABEL_MEDIUM, label) + 12.0f);\n            ui.pushAlpha(bubble);\n            ui.push(0.0f, (1.0f - bubble) * 4.0f);\n            ui.pill(hx - bw / 2.0f, ty - 19.0f, bw, 13.0f, c(Role.INVERSE_SURFACE));\n            ui.textCentered(TypeStyle.LABEL_MEDIUM, label, hx, ty - 16.75f, c(Role.INVERSE_ON_SURFACE));\n            ui.pop();\n            ui.popAlpha();\n        }\n        hot(x - 3.0f, ty - 6.0f, x + w + 3.0f, ty + th + 6.0f, s, (btn, px, py) -> {\n            drag = s;\n            dragX = x;\n            dragW = w;\n            dragLabel = s.label();\n            updateDrag(px);\n        });\n    }\n\n    private void drawSegmented(Ui ui, GuiModel.ModeOption mode, float x, float y, float w) {\n        ui.text(TypeStyle.BODY_MEDIUM, mode.name(), x, y + 1.0f, c(Role.ON_SURFACE));\n        List<String> modes = mode.modes();\n        float sy = y + 13.0f;\n        float sh = 15.0f;\n        float seg = w / modes.size();\n        for (int i = 0; i < modes.size(); i++) {\n            String value = modes.get(i);\n            boolean selected = value.equals(mode.value());\n            float sx = x + seg * i;\n            float tl = i == 0 ? sh / 2.0f : 1.5f;\n            float br = i == modes.size() - 1 ? sh / 2.0f : 1.5f;\n            String key = \"seg:\" + System.identityHashCode(mode) + \":\" + i;\n            float hv = hover(key).value01();\n            Spring sel = toggleSpring(key, selected);\n            float sv = sel.value01();\n            int fill = Argb.mixOklab(c(Role.SURFACE_CONTAINER_HIGHEST), c(Role.SECONDARY_CONTAINER), sv);\n            fill = Argb.layer(fill, c(Role.ON_SURFACE), 0.06f * hv);\n            ui.round(sx + (i == 0 ? 0.0f : 0.5f), sy, seg - (i == 0 || i == modes.size() - 1 ? 0.5f : 1.0f), sh, tl, br, br, tl, fill);\n            float lw = ui.textWidth(TypeStyle.LABEL_MEDIUM, value);\n            float iconW = 8.0f * sv;\n            float start = sx + seg / 2.0f - (lw + iconW) / 2.0f;\n            if (sv > 0.05f) {\n                ui.icon(Icon.CHECK, start - 1.0f, sy + 3.5f, 8.0f, c(Role.ON_SECONDARY_CONTAINER, sv), 1.15f);\n            }\n            ui.text(TypeStyle.LABEL_MEDIUM, value, start + iconW, sy + 3.25f, selected ? c(Role.ON_SECONDARY_CONTAINER) : c(Role.ON_SURFACE));\n            hot(sx, sy, sx + seg, sy + sh, key, (b, px, py) -> {\n                if (!mode.value().equals(value)) {\n                    mode.set(value);\n                    host.sound(Sound.CLICK);\n                }\n            });\n        }\n    }\n\n    private void drawModeChip(Ui ui, GuiModel.ModeOption mode, float x, float y, float w, float h) {\n        float cw = Math.min(w * 0.6f, ui.textWidth(TypeStyle.LABEL_MEDIUM, mode.value()) + 24.0f);\n        ui.text(TypeStyle.BODY_MEDIUM, ui.ellipsize(TypeStyle.BODY_MEDIUM, mode.name(), w - cw - 6.0f), x, y + 4.75f, c(Role.ON_SURFACE));\n        float cx = x + w - cw;\n        float cy = y + 2.0f;\n        float hv = hover(mode).value01();\n        boolean open = menu == mode;\n        ui.pill(cx, cy, cw, 15.0f, Argb.layer(c(open ? Role.SECONDARY_CONTAINER : Role.SURFACE_CONTAINER_HIGHEST), c(Role.ON_SURFACE), 0.06f * hv));\n        ui.text(TypeStyle.LABEL_MEDIUM, ui.ellipsize(TypeStyle.LABEL_MEDIUM, mode.value(), cw - 22.0f), cx + 8.0f, cy + 3.25f, c(Role.ON_SURFACE));\n        ui.icon(open ? Icon.CHEVRON_UP : Icon.CHEVRON_DOWN, cx + cw - 13.0f, cy + 3.0f, 9.0f, c(Role.ON_SURFACE_VARIANT));\n        hot(cx, cy, cx + cw, cy + 15.0f, mode, (b, px, py) -> {\n            if (menu == mode) {\n                closeMenu();\n            } else {\n                menu = mode;\n                menuShown = mode;\n                menuW = Math.max(cw, 80.0f);\n                menuX = cx + cw - menuW;\n                menuY = cy + 17.0f;\n                menuS.snap(0.0f).target(1.0f);\n                host.sound(Sound.EXPAND);\n            }\n        });\n    }\n\n    private void drawSwatches(Ui ui, GuiModel.ColorOption col, float x, float y, float w) {\n        ui.text(TypeStyle.BODY_MEDIUM, col.name(), x, y + 1.0f, c(Role.ON_SURFACE));\n        int[] swatches = col.swatches();\n        int current = col.value();\n        boolean known = false;\n        for (int s : swatches) {\n            known |= (s & 0xFFFFFF) == (current & 0xFFFFFF);\n        }\n        float d = 11.0f;\n        float step = d + 4.5f;\n        float sx = x + d / 2.0f;\n        float sy = y + 13.0f + d / 2.0f + 1.0f;\n        int count = swatches.length + (known ? 0 : 1);\n        for (int i = 0; i < count; i++) {\n            int value = i < swatches.length ? swatches[i] : current;\n            float cx = sx + i * step;\n            if (cx + d / 2.0f > x + w) {\n                break;\n            }\n            boolean selected = (value & 0xFFFFFF) == (current & 0xFFFFFF);\n            String key = \"sw:\" + System.identityHashCode(col) + \":\" + i;\n            float hv = hover(key).value01();\n            float sel = toggleSpring(key, selected).value01();\n            if (sel > 0.01f) {\n                ui.ring(cx, sy, d / 2.0f + 2.25f, 1.0f, c(Role.ON_SURFACE, sel));\n            }\n            ui.circle(cx, sy, d / 2.0f - sel * 0.75f + hv * 0.5f, 0xFF000000 | value);\n            if (sel > 0.5f) {\n                int mark = Argb.luminance(value) > 0.5f ? 0xFF201A1B : 0xFFFFFFFF;\n                ui.icon(Icon.CHECK, cx - 3.5f, sy - 3.5f, 7.0f, Argb.withAlpha(mark, (sel - 0.5f) * 2.0f), 1.2f);\n            }\n            hot(cx - step / 2.0f, sy - d / 2.0f - 2.0f, cx + step / 2.0f, sy + d / 2.0f + 2.0f, key, (b, px, py) -> {\n                if ((col.value() & 0xFFFFFF) != (value & 0xFFFFFF)) {\n                    col.set(0xFF000000 | value);\n                    host.sound(Sound.CLICK);\n                }\n            });\n        }\n    }\n\n    private void drawMenu(Ui ui) {\n        GuiModel.ModeOption shown = menu != null ? menu : menuShown;\n        float open = menuS.value();\n        if (shown == null || (menu == null && open < 0.02f)) {\n            menuShown = null;\n            return;\n        }\n        List<String> modes = shown.modes();\n        float itemH = 16.0f;\n        float mh = modes.size() * itemH + 8.0f;\n        float o = clamp01(open);\n        float maxY = ui.height() - 6.0f;\n        float y = menuY + mh > maxY ? menuY - mh - 21.0f : menuY;\n        ui.pushAlpha(o);\n        ui.elevation(menuX, y, menuW, mh, 10.0f, Elevation.LEVEL2);\n        ui.clip(menuX - 8.0f, y - 8.0f, menuW + 16.0f, (mh + 8.0f) * Math.max(0.15f, Math.min(1.0f, open)) + 8.0f);\n        ui.round(menuX, y, menuW, mh, 10.0f, c(UiTheme.dark() ? Role.SURFACE_CONTAINER_HIGH : Role.SURFACE_CONTAINER_LOW));\n        pushHotClip(menuX, y, menuX + menuW, y + mh);\n        for (int i = 0; i < modes.size(); i++) {\n            String value = modes.get(i);\n            float iy = y + 4.0f + i * itemH;\n            boolean selected = value.equals(shown.value());\n            String key = \"menu:\" + i;\n            float hv = hover(key).value01();\n            if (selected) {\n                ui.round(menuX + 4.0f, iy, menuW - 8.0f, itemH, 6.0f, c(Role.SECONDARY_CONTAINER));\n            } else if (hv > 0.0f) {\n                ui.round(menuX + 4.0f, iy, menuW - 8.0f, itemH, 6.0f, c(Role.ON_SURFACE, 0.08f * hv));\n            }\n            if (selected) {\n                ui.icon(Icon.CHECK, menuX + 9.0f, iy + 3.5f, 9.0f, c(Role.ON_SECONDARY_CONTAINER), 1.1f);\n            }\n            ui.text(TypeStyle.LABEL_LARGE, value, menuX + 21.0f, iy + 3.0f, selected ? c(Role.ON_SECONDARY_CONTAINER) : c(Role.ON_SURFACE));\n            if (menu != null) {\n                hot(menuX, iy, menuX + menuW, iy + itemH, key, (b, px, py) -> {\n                    shown.set(value);\n                    host.sound(Sound.CLICK);\n                    closeMenu();\n                });\n            }\n        }\n        popHotClip();\n        ui.unclip();\n        ui.popAlpha();\n        if (menu != null) {\n            hot(menuX, y, menuX + menuW, y + mh, \"menu\", (b, px, py) -> { });\n        }\n    }\n\n    // ─── Действия ───────────────────────────────────────────────────────────\n\n    private void selectCategory(int index) {\n        if (folded) {\n            folded = false;\n            fold.target(0.0f);\n        }\n        if (!query.isBlank()) {\n            setQuery(\"\");\n        }\n        if (index != category) {\n            contentDirection = index > category ? 1 : -1;\n            category = index;\n            navY.target(index);\n            navGrow.snap(0.0f).target(1.0f);\n            contentIn.snap(0.0f).target(1.0f);\n            scrollTarget = 0.0f;\n            scroll.snap(0.0f);\n            stagger(visibleModules(), 0.02f);\n            closeMenu();\n            host.sound(Sound.NAV);\n            host.stateChanged(category, folded);\n        }\n    }\n\n    private void toggleFold() {\n        folded = !folded;\n        fold.target(folded ? 1.0f : 0.0f);\n        if (folded) {\n            searchFocus = false;\n            closeMenu();\n        }\n        host.sound(folded ? Sound.COLLAPSE : Sound.EXPAND);\n        host.stateChanged(category, folded);\n    }\n\n    private void toggleExpand(GuiModel.Module m, Card cd) {\n        cd.expanded = !cd.expanded;\n        cd.expand.target(cd.expanded ? 1.0f : 0.0f);\n        m.setExpanded(cd.expanded);\n        host.sound(cd.expanded ? Sound.EXPAND : Sound.COLLAPSE);\n    }\n\n    private void closeMenu() {\n        if (menu != null) {\n            menu = null;\n            menuS.target(0.0f);\n        }\n    }\n\n    private void setQuery(String next) {\n        if (!next.equals(query)) {\n            query = next;\n            scrollTarget = 0.0f;\n            scroll.snap(0.0f);\n            contentIn.snap(0.4f).target(1.0f);\n            contentDirection = 1;\n            stagger(visibleModules(), 0.0f);\n        }\n    }\n\n    private void updateDrag(float px) {\n        GuiModel.SliderOption s = drag;\n        if (s == null) {\n            return;\n        }\n        float t = clamp01((px - dragX) / Math.max(1.0f, dragW));\n        float range = s.max() - s.min();\n        float step = range > 20.0f ? 1.0f : range > 2.0f ? 0.1f : 0.01f;\n        float value = s.min() + Math.round(t * range / step) * step;\n        s.set(Math.max(s.min(), Math.min(s.max(), value)));\n        String label = s.label();\n        if (!label.equals(dragLabel) && Motion.time() - dragSoundAt > 0.045f) {\n            dragLabel = label;\n            dragSoundAt = Motion.time();\n            host.sound(Sound.SLIDER);\n        }\n    }\n\n    // ─── Ввод (координаты GUI) ──────────────────────────────────────────────\n\n    public boolean mouseClicked(double x, double y, int button) {\n        float fx = (float) x;\n        float fy = (float) y;\n        if (closing) {\n            return true;\n        }\n        if (menu != null) {\n            Hot h = top(fx, fy);\n            if (h == null || !(h.key() instanceof String k && k.startsWith(\"menu\"))) {\n                closeMenu();\n                return true;\n            }\n        }\n        Hot h = top(fx, fy);\n        if (h == null) {\n            searchFocus = false;\n            return false;\n        }\n        if (!\"search\".equals(h.key())) {\n            searchFocus = false;\n        }\n        h.action().run(button, fx, fy);\n        return true;\n    }\n\n    public boolean mouseReleased(double x, double y, int button) {\n        if (drag != null) {\n            drag = null;\n            host.sound(Sound.SLIDER);\n            return true;\n        }\n        return false;\n    }\n\n    public boolean mouseDragged(double x, double y, int button) {\n        if (drag != null) {\n            updateDrag((float) x);\n            return true;\n        }\n        return false;\n    }\n\n    public boolean mouseScrolled(double x, double y, double amount) {\n        if (menu != null) {\n            return true;\n        }\n        scrollTarget -= (float) amount * 26.0f;\n        lastScrollAt = Motion.time();\n        return true;\n    }\n\n    /** Клавиши по кодам GLFW. */\n    public boolean keyPressed(int key, boolean ctrl) {\n        switch (key) {\n            case 256 -> {\n                if (menu != null) {\n                    closeMenu();\n                } else if (searchFocus && !query.isEmpty()) {\n                    setQuery(\"\");\n                } else if (searchFocus) {\n                    searchFocus = false;\n                } else {\n                    requestClose();\n                }\n                return true;\n            }\n            case 259 -> {\n                if (searchFocus && !query.isEmpty()) {\n                    if (ctrl) {\n                        String trimmed = query.stripTrailing();\n                        int cut = trimmed.lastIndexOf(' ');\n                        setQuery(cut < 0 ? \"\" : trimmed.substring(0, cut + 1));\n                    } else {\n                        setQuery(query.substring(0, query.length() - 1));\n                    }\n                    return true;\n                }\n                return false;\n            }\n            case 257, 335 -> {\n                if (searchFocus) {\n                    List<GuiModel.Module> list = visibleModules();\n                    if (!list.isEmpty() && list.get(0).toggleable()) {\n                        GuiModel.Module m = list.get(0);\n                        m.toggle();\n                        host.sound(m.enabled() ? Sound.TOGGLE_ON : Sound.TOGGLE_OFF);\n                    }\n                    return true;\n                }\n                return false;\n            }\n            case 258 -> {\n                int n = model.categories().size();\n                selectCategory((category + 1) % n);\n                return true;\n            }\n            case 70 -> {\n                if (ctrl) {\n                    searchFocus = true;\n                    if (folded) {\n                        toggleFold();\n                    }\n                    return true;\n                }\n                return false;\n            }\n            default -> {\n                return false;\n            }\n        }\n    }\n\n    public boolean charTyped(char ch) {\n        if (ch < 32 || ch == 127 || closing) {\n            return false;\n        }\n        if (!searchFocus) {\n            searchFocus = true;\n            if (folded) {\n                toggleFold();\n            }\n        }\n        if (query.length() < 40) {\n            setQuery(query + ch);\n        }\n        return true;\n    }\n\n    private Hot top(float x, float y) {\n        for (int i = lastHots.size() - 1; i >= 0; i--) {\n            Hot h = lastHots.get(i);\n            if (h.contains(x, y)) {\n                return h;\n            }\n        }\n        return null;\n    }\n\n    // ─── Для превью ─────────────────────────────────────────────────────────\n\n    /** Программные действия (превью и тесты). */\n    public void debugExpand(String moduleName) {\n        for (GuiModel.Category cat : model.categories()) {\n            for (GuiModel.Module m : cat.modules()) {\n                if (m.name().equals(moduleName)) {\n                    Card cd = card(m);\n                    if (!cd.expanded) {\n                        toggleExpand(m, cd);\n                    }\n                }\n            }\n        }\n    }\n\n    public void debugSelect(int index) {\n        selectCategory(index);\n    }\n\n    public void debugQuery(String q) {\n        searchFocus = true;\n        setQuery(q);\n    }\n\n    public void debugFold() {\n        toggleFold();\n    }\n\n    public void debugOpenMenu(GuiModel.ModeOption mode, float x, float y, float w) {\n        menu = mode;\n        menuShown = mode;\n        menuX = x;\n        menuY = y;\n        menuW = w;\n        menuS.snap(1.0f);\n    }\n}\nEOF\ncd /tmp/w/tools/preview && rm -rf cls && UI=/tmp/w/out/src/main/java/com/valkyrie/client/ui && java /tmp/w/tools/Javac.java cls \"\" $UI/color $UI/motion $UI/render $UI/text $UI/icon $UI/theme $UI/clickgui src 2>&1 | grep -v JAVA_TOOL | tail -20","timeoutMs":120000,"description":"Write ClickGUI hybrid view and compile"}
