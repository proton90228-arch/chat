  Input: {"command":"cd /tmp/w/tools/preview/src/preview && cat > ClickGuiPreview.java <<'EOF'\npackage preview;\n\nimport com.valkyrie.client.ui.clickgui.*;\nimport com.valkyrie.client.ui.color.*;\nimport com.valkyrie.client.ui.motion.Motion;\nimport com.valkyrie.client.ui.render.Ui;\nimport com.valkyrie.client.ui.text.TypeStyle;\nimport com.valkyrie.client.ui.theme.UiTheme;\nimport java.util.*;\n\npublic final class ClickGuiPreview {\n    static String dir;\n    public static void main(String[] a) throws Exception {\n        dir = a[0];\n        String only = a.length > 1 ? a[1] : \"\";\n        if (only.isEmpty() || only.equals(\"1\")) scene(\"clickgui_visuals_light_x2\", false, 2f, 1920, 1080, 1, v -> v.debugExpand(\"ESP\"), 0.62f, 0.33f);\n        if (only.isEmpty() || only.equals(\"2\")) scene(\"clickgui_combat_dark_x2\", true, 2f, 1920, 1080, 2, v -> v.debugExpand(\"KillAura\"), 0.45f, 0.52f);\n        if (only.isEmpty() || only.equals(\"3\")) scene(\"clickgui_client_light_x3\", false, 3f, 1920, 1080, 3, v -> v.debugExpand(\"Appearance\"), 0.7f, 0.4f);\n        if (only.isEmpty() || only.equals(\"4\")) scene(\"clickgui_search_dark_x2\", true, 2f, 1920, 1080, 1, v -> v.debugQuery(\"tr\"), 0.5f, 0.5f);\n        if (only.isEmpty() || only.equals(\"5\")) scene(\"clickgui_folded_light_x2\", false, 2f, 1920, 1080, 0, v -> v.debugFold(), 0.1f, 0.4f);\n        if (only.isEmpty() || only.equals(\"6\")) scene(\"clickgui_hud_light_x2_720p\", false, 2f, 1280, 720, 0, v -> v.debugExpand(\"Watermark\"), 0.5f, 0.3f);\n    }\n    interface Act { void run(ClickGuiView v); }\n\n    static void scene(String name, boolean dark, float sc, int W, int H, int cat, Act act, float mxr, float myr) throws Exception {\n        FakeModel model = new FakeModel();\n        model.dark = dark;\n        UiTheme.set(Scheme.Preset.SAKURA.seed, dark);\n        int[] bg = Backdrop.make(W, H, dark);\n        ImageCanvas cv = new ImageCanvas(W, H, sc);\n        Ui ui = Ui.get();\n        List<String> sounds = new ArrayList<>();\n        ClickGuiView.Host host = new ClickGuiView.Host() {\n            public void sound(ClickGuiView.Sound s) { sounds.add(s.name()); }\n            public void close() { }\n            public String playerName() { return \"Sakura_Valk\"; }\n            public void companion(Ui u, float x, float y, float w, float h, float alpha) {\n                float cx = x + w / 2, top = y + 10;\n                int skin = 0xFFE8B89A, shirt = UiTheme.c(Role.PRIMARY), pants = 0xFF3B3F5C;\n                u.round(cx - 9, top, 18, 18, 3, skin);\n                u.round(cx - 9, top, 18, 6, 3, 3, 0, 0, 0xFF5A3A2E);\n                u.rect(cx - 9, top + 20, 18, 26, shirt);\n                u.rect(cx - 16, top + 20, 6, 24, shirt); u.rect(cx + 10, top + 20, 6, 24, shirt);\n                u.rect(cx - 9, top + 46, 8.5f, 26, pants); u.rect(cx + 0.5f, top + 46, 8.5f, 26, pants);\n            }\n        };\n        ClickGuiView view = new ClickGuiView(model, host, cat, false);\n        float mx = W / sc * mxr, my = H / sc * myr;\n        int frames = 110;\n        for (int f = 0; f < frames; f++) {\n            Motion.advanceManual(1 / 60f);\n            if (f == 20) act.run(view);\n            boolean last = f == frames - 1;\n            if (last || f % 10 == 0) cv.backdrop(bg);\n            ui.begin(cv);\n            view.render(ui, mx, my);\n        }\n        cv.save(dir + \"/\" + name + \".png\");\n        System.out.println(name + \" sounds=\" + sounds + \" ops=\" + cv.ops);\n    }\n}\nEOF\ncd /tmp/w/tools/preview && rm -rf cls && UI=/tmp/w/out/src/main/java/com/valkyrie/client/ui && java /tmp/w/tools/Javac.java cls \"\" $UI/color $UI/motion $UI/render $UI/text $UI/icon $UI/theme $UI/clickgui src 2>&1 | grep -v JAVA_TOOL | tail -20 && time java -Djava.awt.headless=true -cp cls:/tmp/w/preview_res preview.ClickGuiPreview /tmp/w/png 1 2>&1 | grep -v JAVA_TOOL | tail -5; cp /tmp/w/png/clickgui_visuals_light_x2.png /files/conversation/previews/","timeoutMs":120000,"description":"Render first ClickGUI preview"}
