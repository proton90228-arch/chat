  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui && python3 - <<'EOF'\nimport re\np='motion/Spring.java'; s=open(p).read()\ns=s.replace(\"\"\"            x = decay * (x0 * cos + b * sin);\n            v = decay * (v0 * cos - x0 * wd * sin) - zeta * omega * x;\n            // Производная: d/dt[e^{-ζωt}(x0 cos + b sin)] = -ζω x + e^{-ζωt}(-x0 wd sin + b wd cos)\n            v = -zeta * omega * x + decay * (-x0 * wd * sin + b * wd * cos);\"\"\",\"\"\"            x = decay * (x0 * cos + b * sin);\n            // d/dt[e^{-ζωt}(x0·cos + b·sin)] = -ζω·x + e^{-ζωt}·wd·(b·cos − x0·sin)\n            v = -zeta * omega * x + decay * wd * (b * cos - x0 * sin);\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > render/Mask.java <<'EOF'\npackage com.valkyrie.client.ui.render;\n\n/**\n * Маска покрытия (альфа 0..255) в физических пикселях. Цвет задаётся при отрисовке\n * тонированием, поэтому одна маска обслуживает все цвета схемы.\n * <p>\n * Реализация {@link Canvas} сама решает, как держать маску на GPU; для этого здесь\n * есть поля {@link #handle} и {@link #uploadedVersion}. {@link #version} растёт при\n * изменении пикселей (страницы атласа глифов дописываются по ходу работы).\n */\npublic final class Mask {\n    public final int width;\n    public final int height;\n    public final byte[] alpha;\n    public final String name;\n    public int version;\n    /** Данные реализации холста (текстура). */\n    public Object handle;\n    public int uploadedVersion = -1;\n\n    public Mask(String name, int width, int height) {\n        this.name = name;\n        this.width = Math.max(1, width);\n        this.height = Math.max(1, height);\n        this.alpha = new byte[this.width * this.height];\n    }\n\n    public int get(int x, int y) {\n        return alpha[y * width + x] & 0xFF;\n    }\n\n    public void set(int x, int y, int a) {\n        alpha[y * width + x] = (byte) (a < 0 ? 0 : Math.min(255, a));\n    }\n\n    /** Запись покрытия 0..1. */\n    public void setCoverage(int x, int y, double coverage) {\n        alpha[y * width + x] = (byte) Math.round(Math.max(0.0, Math.min(1.0, coverage)) * 255.0);\n    }\n\n    public void touch() {\n        version++;\n    }\n}\nEOF\ncat > render/Canvas.java <<'EOF'\npackage com.valkyrie.client.ui.render;\n\n/**\n * Минимальная поверхность рисования в физических пикселях окна. Её реализуют\n * {@code GuiCanvas} (Minecraft {@code GuiGraphics}) и {@code ImageCanvas} (PNG-превью\n * в песочнице) — поэтому весь интерфейс над ней можно проверять без игры.\n * Смешивание — обычное «source over» с непремультиплицированной альфой, как в GUI Minecraft.\n */\npublic interface Canvas {\n    /** Физических пикселей на единицу GUI (масштаб интерфейса Minecraft). */\n    float scale();\n\n    /** Ширина области GUI в физических пикселях. */\n    int width();\n\n    int height();\n\n    void fill(int x0, int y0, int x1, int y1, int argb);\n\n    void gradient(int x0, int y0, int x1, int y1, int argbTop, int argbBottom);\n\n    /**\n     * Рисует область {@code (sx, sy, sw, sh)} маски в прямоугольник {@code (dx, dy, dw, dh)}\n     * c ближайшей выборкой, тонируя цветом {@code argb} (альфа цвета умножается на покрытие).\n     */\n    void mask(Mask mask, int dx, int dy, int dw, int dh, int sx, int sy, int sw, int sh, int argb);\n\n    /** Прямоугольная обрезка; вложенные области пересекаются. */\n    void pushClip(int x0, int y0, int x1, int y1);\n\n    void popClip();\n}\nEOF\ncat > render/Raster.java <<'EOF'\npackage com.valkyrie.client.ui.render;\n\n/**\n * Аналитический растеризатор форм. Покрытие считается по знаковому расстоянию\n * до границы с шириной перехода в 1 физический пиксель, поэтому края одинаково\n * гладкие при любом масштабе GUI. Тени — честная гауссова свёртка формы.\n */\npublic final class Raster {\n    private Raster() {\n    }\n\n    private static double coverage(double signedDistance) {\n        double c = 0.5 - signedDistance;\n        return c <= 0.0 ? 0.0 : c >= 1.0 ? 1.0 : c;\n    }\n\n    /**\n     * Диск диаметром {@code d} пикселей. Его четверти — это углы скругления радиуса d/2,\n     * поэтому одна маска обслуживает и круги, и скругления прямоугольников.\n     */\n    public static Mask disc(int d) {\n        Mask mask = new Mask(\"disc\" + d, d, d);\n        double r = d / 2.0;\n        // 4×4 суперсэмплинг на границе: точная площадь даже для крошечных кругов.\n        for (int y = 0; y < d; y++) {\n            for (int x = 0; x < d; x++) {\n                double px = x + 0.5 - r;\n                double py = y + 0.5 - r;\n                double dist = Math.sqrt(px * px + py * py) - r;\n                if (dist < -1.0) {\n                    mask.set(x, y, 255);\n                } else if (dist > 1.0) {\n                    mask.set(x, y, 0);\n                } else {\n                    mask.setCoverage(x, y, superSampleDisc(x, y, r, r, r, -1.0));\n                }\n            }\n        }\n        return mask;\n    }\n\n    /** Кольцо: внешний диаметр {@code d}, толщина {@code stroke} (внутрь). */\n    public static Mask ring(int d, float stroke) {\n        Mask mask = new Mask(\"ring\" + d + \"_\" + stroke, d, d);\n        double r = d / 2.0;\n        double inner = Math.max(0.0, r - stroke);\n        for (int y = 0; y < d; y++) {\n            for (int x = 0; x < d; x++) {\n                double outer = superSampleDisc(x, y, r, r, r, -1.0);\n                double hole = inner > 0.0 ? superSampleDisc(x, y, r, r, inner, -1.0) : 0.0;\n                mask.setCoverage(x, y, outer - hole);\n            }\n        }\n        return mask;\n    }\n\n    private static double superSampleDisc(int x, int y, double cx, double cy, double radius, double unused) {\n        int inside = 0;\n        double r2 = radius * radius;\n        for (int sy = 0; sy < 4; sy++) {\n            for (int sx = 0; sx < 4; sx++) {\n                double px = x + (sx + 0.5) / 4.0 - cx;\n                double py = y + (sy + 0.5) / 4.0 - cy;\n                if (px * px + py * py <= r2) {\n                    inside++;\n                }\n            }\n        }\n        // Смесь 16 сэмплов и SDF-оценки сглаживает «ступеньки» суперсэмплинга.\n        double px = x + 0.5 - cx;\n        double py = y + 0.5 - cy;\n        double sdf = coverage(Math.sqrt(px * px + py * py) - radius);\n        return (inside / 16.0) * 0.5 + sdf * 0.5;\n    }\n\n    /** Покрытие скруглённого прямоугольника {@code w×h} с радиусом {@code r}, полностью. */\n    public static Mask roundRect(int w, int h, float r) {\n        Mask mask = new Mask(\"rr\" + w + \"x\" + h + \"r\" + r, w, h);\n        double hw = w / 2.0;\n        double hh = h / 2.0;\n        double rr = Math.min(r, Math.min(hw, hh));\n        for (int y = 0; y < h; y++) {\n            for (int x = 0; x < w; x++) {\n                mask.setCoverage(x, y, coverage(sdRoundRect(x + 0.5 - hw, y + 0.5 - hh, hw, hh, rr)));\n            }\n        }\n        return mask;\n    }\n\n    /** Знаковое расстояние до скруглённого прямоугольника с полуразмерами (hw, hh). */\n    public static double sdRoundRect(double px, double py, double hw, double hh, double r) {\n        double qx = Math.abs(px) - hw + r;\n        double qy = Math.abs(py) - hh + r;\n        double ox = Math.max(qx, 0.0);\n        double oy = Math.max(qy, 0.0);\n        return Math.sqrt(ox * ox + oy * oy) + Math.min(Math.max(qx, qy), 0.0) - r;\n    }\n\n    /**\n     * Тень скруглённого прямоугольника для 9-slice: размытая гауссом (σ) форма\n     * размера {@code 2(r+e)} с полем {@code e = ⌈3σ⌉} со всех сторон. Четверти маски —\n     * углы тени, центральные строка и столбец — профили краёв.\n     * Размер маски {@code 2P × 2P}, где {@code P = r + 2e}.\n     */\n    public static Mask shadowSheet(int r, float sigma) {\n        int e = Math.max(1, (int) Math.ceil(sigma * 3.0f));\n        int inner = 2 * (r + e);\n        return blurredRoundRect(\"shadow\" + r + \"s\" + sigma, inner, inner, r, sigma, e);\n    }\n\n    /** Полная размытая маска для маленьких элементов, где 9-slice не помещается. */\n    public static Mask shadowFull(int w, int h, int r, float sigma) {\n        int e = Math.max(1, (int) Math.ceil(sigma * 3.0f));\n        return blurredRoundRect(\"shadowF\" + w + \"x\" + h + \"r\" + r + \"s\" + sigma, w, h, r, sigma, e);\n    }\n\n    public static int shadowExtent(float sigma) {\n        return Math.max(1, (int) Math.ceil(sigma * 3.0f));\n    }\n\n    private static Mask blurredRoundRect(String name, int w, int h, int r, float sigma, int e) {\n        int mw = w + 2 * e;\n        int mh = h + 2 * e;\n        float[] src = new float[mw * mh];\n        double hw = w / 2.0;\n        double hh = h / 2.0;\n        double rr = Math.min(r, Math.min(hw, hh));\n        for (int y = 0; y < mh; y++) {\n            for (int x = 0; x < mw; x++) {\n                double px = x + 0.5 - e - hw;\n                double py = y + 0.5 - e - hh;\n                src[y * mw + x] = (float) coverage(sdRoundRect(px, py, hw, hh, rr));\n            }\n        }\n        float[] kernel = gaussian(sigma, e);\n        float[] tmp = new float[mw * mh];\n        // Горизонтальный проход (за краем — ноль).\n        for (int y = 0; y < mh; y++) {\n            for (int x = 0; x < mw; x++) {\n                float acc = 0.0f;\n                for (int k = -e; k <= e; k++) {\n                    int sx = x + k;\n                    if (sx >= 0 && sx < mw) {\n                        acc += src[y * mw + sx] * kernel[k + e];\n                    }\n                }\n                tmp[y * mw + x] = acc;\n            }\n        }\n        Mask mask = new Mask(name, mw, mh);\n        for (int y = 0; y < mh; y++) {\n            for (int x = 0; x < mw; x++) {\n                float acc = 0.0f;\n                for (int k = -e; k <= e; k++) {\n                    int sy = y + k;\n                    if (sy >= 0 && sy < mh) {\n                        acc += tmp[sy * mw + x] * kernel[k + e];\n                    }\n                }\n                mask.setCoverage(x, y, acc);\n            }\n        }\n        return mask;\n    }\n\n    private static float[] gaussian(float sigma, int radius) {\n        float[] kernel = new float[radius * 2 + 1];\n        double sum = 0.0;\n        double s = Math.max(0.3, sigma);\n        for (int i = -radius; i <= radius; i++) {\n            double v = Math.exp(-(i * i) / (2.0 * s * s));\n            kernel[i + radius] = (float) v;\n            sum += v;\n        }\n        for (int i = 0; i < kernel.length; i++) {\n            kernel[i] /= (float) sum;\n        }\n        return kernel;\n    }\n}\nEOF\necho ok","description":"Write Mask, Canvas, Raster"}
