[] times = {0.016f, 0.05f, 0.10f, 0.16f, 0.30f};\n        int[] strip = new int[W * times.length / 2 * H / 2];\n        int SW = W / 2 * times.length, SH = H / 2;\n        ImageCanvas out = new ImageCanvas(SW, SH * 2, 1f);\n        out.clear(0xFF101014);\n        for (int row = 0; row < 2; row++) for (int k = 0; k < times.length; k++) {\n            FakeModel model = new FakeModel();\n            UiTheme.set(Scheme.Preset.SAKURA.seed, row == 1);\n            int[] bg = Backdrop.make(W, H, row == 1);\n            ImageCanvas cv = new ImageCanvas(W, H, sc);\n            ClickGuiView view = new ClickGuiView(model, new ClickGuiView.Host() { public void sound(ClickGuiView.Sound s) {} public void close() {} }, 1, false);\n            Ui ui = Ui.get();\n            float t = 0; boolean expanded = row == 1;\n            if (expanded) { for (int f = 0; f < 40; f++) { Motion.advanceManual(1 / 60f); ui.begin(cv); view.render(ui, 0, 0); } view.debugExpand(\"Tracers\"); }\n            while (t < times[k]) { Motion.advanceManual(1 / 120f); t += 1 / 120f; cv.backdrop(bg); ui.begin(cv); view.render(ui, 0, 0); }\n            for (int y = 0; y < SH; y++) for (int x = 0; x < W / 2; x++) {\n                int c = cv.px[(y * 2) * W + x * 2];\n                out.px[(row * SH + y) * SW + k * (W / 2) + x] = c;\n            }\n        }\n        out.save(dir + \"/clickgui_motion_filmstrip.png\");\n        System.out.println(\"filmstrip ok\");\n    }\"\"\")\nopen(p,'w').write(s)\nEOF\ncd /tmp/w/tools/preview && rm -rf cls && UI=/tmp/w/out/src/main/java/com/valkyrie/client/ui && java /tmp/w/tools/Javac.java cls \"\" $UI/color $UI/motion $UI/render $UI/text $UI/icon $UI/theme $UI/clickgui src 2>&1 | grep -v JAVA_TOOL | tail -3 && for i in 1 2 3 4 5 6 7; do java -Djava.awt.headless=true -cp cls:/tmp/w/preview_res preview.ClickGuiPreview /tmp/w/png $i 2>&1 | grep -v JAVA_TOOL | tail -1 & done; wait; cp /tmp/w/png/clickgui_*.png /files/conversation/previews/; ls /files/conversation/previews","t