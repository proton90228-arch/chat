  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client && python3 - <<'EOF'\np='ui/clickgui/ClickGuiView.java'; s=open(p).read()\ns=s.replace(\"\"\"    public boolean searchFocused() {\n        return searchFocus;\n    }\"\"\",\"\"\"    public boolean searchFocused() {\n        return searchFocus;\n    }\n\n    /** Прозрачность появления окна 0..1 (для фона экрана). */\n    public float appearAlpha() {\n        return clamp01(appear.value());\n    }\"\"\")\ns=s.replace(\"\"\"        // Мягкий скрим поверх размытого мира: читаемость без «чёрного занавеса».\n        ui.gradient(0, 0, sw, sh, c(Role.SCRIM, 0.10f * alpha), c(Role.SCRIM, 0.28f * alpha));\"\"\",\"\"\"        // Вуаль поверх размытого мира: светлая в светлой схеме, тёмная — в тёмной.\n        if (UiTheme.dark()) {\n            ui.gradient(0, 0, sw, sh, c(Role.SCRIM, 0.18f * alpha), c(Role.SCRIM, 0.38f * alpha));\n        } else {\n            ui.gradient(0, 0, sw, sh, c(Role.SURFACE, 0.14f * alpha), c(Role.SURFACE, 0.30f * alpha));\n        }\"\"\")\nopen(p,'w').write(s)\np='gui/ValkyrieGuiScreen.java'; s=open(p).read()\ns=s.replace(\"\"\"        // Размытие всего, что нарисовано раньше, — «стекло» под окном.\n        guiGraphics.blurBeforeThisStratum();\n    }\"\"\",\"\"\"        // Размытие всего, что нарисовано раньше, — «стекло» под окном; лепестки — за окном.\n        guiGraphics.blurBeforeThisStratum();\n        float alpha = view == null ? 0.0f : view.appearAlpha();\n        com.valkyrie.client.gui.particle.SakuraParticles.render(guiGraphics, partialTick, 0.85f * alpha);\n    }\"\"\")\nopen(p,'w').write(s)\nEOF\nmkdir -p /tmp/w/stubs/src/com/valkyrie/client/gui/particle && cat > /tmp/w/stubs/src/com/valkyrie/client/gui/particle/SakuraParticles.java <<'EOF'\npackage com.valkyrie.client.gui.particle;\npublic final class SakuraParticles { public static void render(net.minecraft.client.gui.GuiGraphics g, float pt, float a) {} }\nEOF\nC=/tmp/w/out/src/main/java/com/valkyrie/client; cd /tmp/