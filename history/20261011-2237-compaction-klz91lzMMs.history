  Input: {"command":"mkdir -p /tmp/w/tools/preview/src/preview && cd /tmp/w/tools/preview/src/preview && cat > ImageCanvas.java <<'EOF'\npackage preview;\n\nimport com.valkyrie.client.ui.render.Canvas;\nimport com.valkyrie.client.ui.render.Mask;\nimport java.awt.image.BufferedImage;\nimport java.io.File;\nimport java.util.ArrayDeque;\nimport java.util.Deque;\nimport javax.imageio.ImageIO;\n\n/** Программный холст: то же «source over» смешивание в sRGB, что у GUI Minecraft. */\npublic final class ImageCanvas implements Canvas {\n    final int w, h; final float scale; final int[] px;\n    private int cx0, cy0, cx1, cy1;\n    private final Deque<int[]> clips = new ArrayDeque<>();\n    public long ops;\n\n    public ImageCanvas(int w, int h, float scale) {\n        this.w = w; this.h = h; this.scale = scale; this.px = new int[w * h];\n        cx0 = 0; cy0 = 0; cx1 = w; cy1 = h;\n    }\n    @Override public float scale() { return scale; }\n    @Override public int width() { return w; }\n    @Override public int height() { return h; }\n\n    private void blend(int i, int argb, int a) {\n        if (a <= 0) return;\n        int d = px[i];\n        if (a >= 255) { px[i] = 0xFF000000 | (argb & 0xFFFFFF); return; }\n        int ia = 255 - a;\n        int r = (((argb >> 16) & 0xFF) * a + ((d >> 16) & 0xFF) * ia + 127) / 255;\n        int g = (((argb >> 8) & 0xFF) * a + ((d >> 8) & 0xFF) * ia + 127) / 255;\n        int b = ((argb & 0xFF) * a + (d & 0xFF) * ia + 127) / 255;\n        px[i] = 0xFF000000 | (r << 16) | (g << 8) | b;\n    }\n    @Override public void fill(int x0, int y0, int x1, int y1, int argb) {\n        ops++;\n        int a = argb >>> 24; if (a == 0) return;\n        int ax = Math.max(x0, cx0), ay = Math.max(y0, cy0), bx = Math.min(x1, cx1), by = Math.min(y1, cy1);\n        for (int y = ay; y < by; y++) for (int x = ax; x < bx; x++) blend(y * w + x, argb, a);\n    }\n    @Override public void gradient(int x0, int y0, int x1, int y1, int top, int bottom) {\n        ops++;\n        int ay = Math.max(y0, cy0), by = Math.min(y1, cy1), ax = Math.max(x0, cx0), bx = Math.min(x1, cx1);\n        for (int y = ay; y < by; y++) {\n            float t = (y - y0 + 0.5f) / Math.max(1, y1 - y0);\n            int c = mix(top, bottom, t);\n            for (int x = ax; x < bx; x++) blend(y * w + x, c, c >>> 24);\n        }\n    }\n    static int mix(int a, int b, float t) {\n        int aa = Math.round((a >>> 24) + ((b >>> 24) - (a >>> 24)) * t);\n        int r = Math.round(((a >> 16) & 255) + (((b >> 16) & 255) - ((a >> 16) & 255)) * t);\n        int g = Math.round(((a >> 8) & 255) + (((b >> 8) & 255) - ((a >> 8) & 255)) * t);\n        int bb = Math.round((a & 255) + ((b & 255) - (a & 255)) * t);\n        return (aa << 24) | (r << 16) | (g << 8) | bb;\n    }\n    @Override public void mask(Mask m, int dx, int dy, int dw, int dh, int sx, int sy, int sw, int sh, int argb) {\n        ops++;\n        int ca = argb >>> 24; if (ca == 0 || dw <= 0 || dh <= 0) return;\n        int ax = Math.max(dx, cx0), ay = Math.max(dy, cy0), bx = Math.min(dx + dw, cx1), by = Math.min(dy + dh, cy1);\n        for (int y = ay; y < by; y++) {\n            int my = sy + (int) Math.floor((y - dy + 0.5) * sh / dh);\n            if (my < 0 || my >= m.height) continue;\n            for (int x = ax; x < bx; x++) {\n                int mx = sx + (int) Math.floor((x - dx + 0.5) * sw / dw);\n                if (mx < 0 || mx >= m.width) continue;\n                int cov = m.alpha[my * m.width + mx] & 0xFF;\n                if (cov == 0) continue;\n                blend(y * w + x, argb, (ca * cov + 127) / 255);\n            }\n        }\n    }\n    @Override public void pushClip(int x0, int y0, int x1, int y1) {\n        clips.push(new int[] {cx0, cy0, cx1, cy1});\n        cx0 = Math.max(cx0, x0); cy0 = Math.max(cy0, y0); cx1 = Math.min(cx1, x1); cy1 = Math.min(cy1, y1);\n    }\n    @Override public void popClip() {\n        int[] c = clips.pop(); cx0 = c[0]; cy0 = c[1]; cx1 = c[2]; cy1 = c[3];\n    }\n    public void clear(int argb) { java.util.Arrays.fill(px, argb | 0xFF000000); }\n    public void backdrop(int[] src) { System.arraycopy(src, 0, px, 0, px.length); }\n    public void save(String path) throws Exception {\n        BufferedImage img = new BufferedImage(w, h, BufferedImage.TYPE_INT_RGB);\n        img.setRGB(0, 0, w, h, px, 0, w);\n        ImageIO.write(img, \"png\", new File(path));\n    }\n}\nEOF\ncat > Backdrop.java <<'EOF'\npackage preview;\n\n/** Размытый «игровой мир» за интерфейсом: небо, горы, деревья, солнце. */\npublic final class Backdrop {\n    public static int[] make(int w, int h, boolean night) {\n        int[] p = new int[w * h];\n        java.util.Random rnd = new java.util.Random(7);\n        for (int y = 0; y < h; y++) {\n            float t = y / (float) h;\n            int top = night ? 0x1B2140 : 0x8EC5F0, mid = night ? 0x3A3260 : 0xCFE6F7;\n            int c = ImageCanvas.mix(0xFF000000 | top, 0xFF000000 | mid, Math.min(1, t * 1.6f));\n            for (int x = 0; x < w; x++) p[y * w + x] = c;\n        }\n        // Горы и лес.\n        for (int layer = 0; layer < 3; layer++) {\n            int col = night ? new int[] {0x2C3355, 0x232845, 0x1A1E33}[layer] : new int[] {0x8FB0C8, 0x6E9A6A, 0x4E7A47}[layer];\n            double base = h * (0.52 + layer * 0.12), amp = h * (0.10 - layer * 0.02), f = 2.0 + layer * 1.7, ph = layer * 1.3;\n            for (int x = 0; x < w; x++) {\n                double yy = base - amp * (0.6 * Math.sin(x / (double) w * Math.PI * f + ph) + 0.4 * Math.sin(x / (double) w * Math.PI * f * 2.3 + ph * 2));\n                for (int y = (int) Math.max(0, yy); y < h; y++) p[y * w + x] = 0xFF000000 | col;\n            }\n        }\n        // Пятна света (солнце/луна, цветущие деревья).\n        blob(p, w, h, (int) (w * 0.78), (int) (h * 0.2), h * 0.09, night ? 0xFFE9E4F5 : 0xFFFFF4D6, 0.9f);\n        for (int i = 0; i < 14; i++) blob(p, w, h, rnd.nextInt(w), (int) (h * (0.62 + rnd.nextFloat() * 0.25)), h * (0.03 + rnd.nextFloat() * 0.04), night ? 0xFF8F6BA8 : 0xFFF2B8C9, 0.8f);\n        return boxBlur(boxBlur(boxBlur(p, w, h, 18), w, h, 18), w, h, 18);\n    }\n    static void blob(int[] p, int w, int h, int cx, int cy, double r, int col, float a) {\n        for (int y = Math.max(0, (int) (cy - r)); y < Math.min(h, cy + r); y++)\n            for (int x = Math.max(0, (int) (cx - r)); x < Math.min(w, cx + r); x++) {\n                double d = Math.hypot(x - cx, y - cy) / r; if (d > 1) continue;\n                p[y * w + x] = ImageCanvas.mix(p[y * w + x], col, (float) (a * (1 - d * d)));\n            }\n    }\n    static int[] boxBlur(int[] src, int w, int h, int r) {\n        int[] tmp = new int[src.length], out = new int[src.length];\n        for (int pass = 0; pass < 2; pass++) {\n            int[] in = pass == 0 ? src : tmp, o = pass == 0 ? tmp : out;\n            int len = pass == 0 ? w : h, lines = pass == 0 ? h : w;\n            for (int l = 0; l < lines; l++) {\n                long sr = 0, sg = 0, sb = 0; int n = 0;\n                int[] buf = new int[len];\n                for (int i = 0; i < len; i++) buf[i] = in[pass == 0 ? l * w + i : i * w + l];\n                for (int i = -r; i <= r; i++) { int c = buf[Math.max(0, Math.min(len - 1, i))]; sr += (c >> 16) & 255; sg += (c >> 8) & 255; sb += c & 255; n++; }\n                for (int i = 0; i < len; i++) {\n                    int idx = pass == 0 ? l * w + i : i * w + l;\n                    o[idx] = 0xFF000000 | ((int) (sr / n) << 16) | ((int) (sg / n) << 8) | (int) (sb / n);\n                    int add = buf[Math.min(len - 1, i + r + 1)], rem = buf[Math.max(0, i - r)];\n                    sr += ((add >> 16) & 255) - ((rem >> 16) & 255); sg += ((add >> 8) & 255) - ((rem >> 8) & 255); sb += (add & 255) - (rem & 255);\n                }\n            }\n        }\n        return out;\n    }\n}\nEOF\ncat > ComponentSheet.java <<'EOF'\npackage preview;\n\nimport com.valkyrie.client.ui.color.*;\nimport com.valkyrie.client.ui.icon.Icon;\nimport com.valkyrie.client.ui.motion.Motion;\nimport com.valkyrie.client.ui.render.Ui;\nimport com.valkyrie.client.ui.text.TypeStyle;\nimport com.valkyrie.client.ui.theme.*;\n\npublic final class ComponentSheet {\n    public static void main(String[] a) throws Exception {\n        for (boolean dark : new boolean[] {false, true}) for (float sc : new float[] {2f, 3f}) render(dark, sc, a[0]);\n    }\n    static void render(boolean dark, float sc, String dir) throws Exception {\n        int W = (int) (520 * sc), H = (int) (330 * sc);\n        ImageCanvas cv = new ImageCanvas(W, H, sc);\n        UiTheme.set(Scheme.Preset.SAKURA.seed, dark);\n        Motion.beginFrame();\n        Ui ui = Ui.get().begin(cv);\n        cv.clear(UiTheme.c(Role.SURFACE_CONTAINER));\n        // Роли.\n        Role[] show = {Role.PRIMARY, Role.PRIMARY_CONTAINER, Role.SECONDARY_CONTAINER, Role.TERTIARY_CONTAINER, Role.SURFACE_CONTAINER_LOWEST, Role.SURFACE_CONTAINER_HIGH, Role.SURFACE_CONTAINER_HIGHEST, Role.OUTLINE_VARIANT, Role.ERROR, Role.SUCCESS};\n        for (int i = 0; i < show.length; i++) { ui.round(10 + i * 30, 10, 26, 18, 6, UiTheme.c(show[i])); }\n        // Карточки с тенями всех уровней.\n        Elevation[] lv = Elevation.values();\n        for (int i = 1; i < lv.length; i++) {\n            float x = 10 + (i - 1) * 62, y = 40;\n            ui.elevation(x, y, 52, 40, 12, lv[i]);\n            ui.round(x, y, 52, 40, 12, UiTheme.c(Role.SURFACE_CONTAINER_LOWEST));\n            ui.text(TypeStyle.LABEL_MEDIUM, \"Level \" + i, x + 8, y + 6, UiTheme.c(Role.ON_SURFACE_VARIANT));\n        }\n        // Пилюли, кольца, обводки.\n        ui.pill(330, 40, 60, 16, UiTheme.c(Role.PRIMARY));\n        ui.text(TypeStyle.LABEL_LARGE, \"Готово\", 343, 43, UiTheme.c(Role.ON_PRIMARY));\n        ui.pill(330, 62, 60, 16, UiTheme.c(Role.SECONDARY_CONTAINER));\n        ui.text(TypeStyle.LABEL_LARGE, \"Tonal\", 346, 65, UiTheme.c(Role.ON_SECONDARY_CONTAINER));\n        ui.outline(396, 40, 60, 16, 8, 0.5f, UiTheme.c(Role.OUTLINE));\n        ui.text(TypeStyle.LABEL_LARGE, \"Outline\", 409, 43, UiTheme.c(Role.PRIMARY));\n        ui.circle(410, 70, 7, UiTheme.c(Role.PRIMARY));\n        ui.ring(430, 70, 7, 1, UiTheme.c(Role.PRIMARY));\n        ui.circle(450, 70, 3, UiTheme.c(Role.TERTIARY));\n        // Переключатели (M3): выкл/вкл.\n        float sx = 470;\n        ui.pill(sx, 40, 26, 15, UiTheme.c(Role.SURFACE_CONTAINER_HIGHEST)); ui.outline(sx, 40, 26, 15, 7.5f, 1f, UiTheme.c(Role.OUTLINE)); ui.circle(sx + 7.5f, 47.5f, 4, UiTheme.c(Role.OUTLINE));\n        ui.pill(sx, 60, 26, 15, UiTheme.c(Role.PRIMARY)); ui.circle(sx + 18.5f, 67.5f, 6, UiTheme.c(Role.ON_PRIMARY)); ui.icon(Icon.CHECK, sx + 14.5f, 63.5f, 8, UiTheme.c(Role.ON_PRIMARY_CONTAINER));\n        // Типографика.\n        float ty = 92;\n        TypeStyle[] st = {TypeStyle.DISPLAY_SMALL, TypeStyle.HEADLINE_MEDIUM, TypeStyle.HEADLINE_SMALL, TypeStyle.TITLE_LARGE, TypeStyle.TITLE_MEDIUM, TypeStyle.TITLE_SMALL, TypeStyle.BODY_LARGE, TypeStyle.BODY_MEDIUM, TypeStyle.BODY_SMALL, TypeStyle.LABEL_LARGE, TypeStyle.LABEL_MEDIUM, TypeStyle.LABEL_SMALL};\n        for (TypeStyle s : st) {\n            ui.rect(10, ty, 2, s.lineHeight, UiTheme.c(Role.PRIMARY, 0.35f));\n            ui.text(s, s.name().toLowerCase() + \" · Valkyrie Сакура AVATAR 0123\", 16, ty, UiTheme.c(Role.ON_SURFACE));\n            ty += s.lineHeight + 2;\n        }\n        // Иконки.\n        Icon[] icons = Icon.values();\n        for (int i = 0; i < icons.length; i++) {\n            float x = 300 + (i % 11) * 19, y = 96 + (i / 11) * 19;\n            ui.round(x, y, 16, 16, 5, UiTheme.c(Role.SURFACE_CONTAINER_HIGH));\n            ui.icon(icons[i], x + 2, y + 2, 12, UiTheme.c(Role.ON_SURFACE_VARIANT));\n        }\n        // Слайдер M3 Expressive.\n        float slx = 300, sly = 210, slw = 200, val = 0.62f;\n        float hx = slx + slw * val;\n        ui.round(slx, sly, hx - slx - 3, 8, 4, 2, 2, 4, UiTheme.c(Role.PRIMARY));\n        ui.round(hx + 3, sly, slx + slw - hx - 3, 8, 2, 4, 4, 2, UiTheme.c(Role.SECONDARY_CONTAINER));\n        ui.circle(slx + slw - 4, sly + 4, 1, UiTheme.c(Role.ON_SECONDARY_CONTAINER));\n        ui.pill(hx - 1, sly - 5, 2, 18, UiTheme.c(Role.PRIMARY));\n        ui.pill(hx - 12, sly - 22, 24, 13, UiTheme.c(Role.INVERSE_SURFACE));\n        ui.textCentered(TypeStyle.LABEL_MEDIUM, \"62%\", hx, sly - 19.5f, UiTheme.c(Role.INVERSE_ON_SURFACE));\n        // Сакура-логотип.\n        ui.icon(Icon.SAKURA, 300, 240, 40, UiTheme.c(Role.BRAND));\n        ui.icon(Icon.SAKURA, 345, 250, 20, UiTheme.c(Role.PETAL));\n        ui.text(TypeStyle.HEADLINE_MEDIUM, \"Valkyrie\", 372, 250, UiTheme.c(Role.ON_SURFACE));\n        String name = dir + \"/sheet_\" + (dark ? \"dark\" : \"light\") + \"_x\" + (int) sc + \".png\";\n        cv.save(name);\n        System.out.println(name + \" ops=\" + cv.ops);\n    }\n}\nEOF\ncd /tmp/w/tools/preview && rm -rf cls && UI=/tmp/w/out/src/main/java/com/valkyrie/client/ui && java /tmp/w/tools/Javac.java cls \"\" $UI/color $UI/motion $UI/render $UI/text $UI/icon $UI/theme src 2>&1 | grep -v JAVA_TOOL | tail -20 && mkdir -p /tmp/w/png && time java -Djava.awt.headless=true -cp cls:/tmp/w/preview_res preview.ComponentSheet /tmp/w/png 2>&1 | grep -v JAVA_TOOL","timeoutMs":120000,"description":"Build preview canvas and render component sheets"}
