  Input: {"command":"cd /tmp/w && cat > /tmp/w/fetch_repo.py <<'EOF'\nimport sys,json,os,concurrent.futures as cf\nsys.path.insert(0,'/tmp/w')\nfrom fetch import fetch\ndef run(base, files, outdir, batch=8):\n    todo=[(p,s) for p,s in files]\n    bad=[]\n    batches=[todo[i:i+batch] for i in range(0,len(todo),batch)]\n    def work(b):\n        o=fetch([base+p for p,_ in b])\n        res=[]\n        for p,s in b:\n            v=o.get(base+p)\n            if not v: res.append((p,s,None)); continue\n            code,t=v[0]\n            res.append((p,s,t))\n        return res\n    with cf.ThreadPoolExecutor(4) as ex:\n        for res in ex.map(work,batches):\n            for p,s,t in res:\n                if t is None: bad.append((p,s,'missing')); continue\n                data=t.encode()\n                fn=os.path.join(outdir,p); os.makedirs(os.path.dirname(fn),exist_ok=True)\n                open(fn,'wb').write(data)\n                if s is not None and len(data)!=s: bad.append((p,s,len(data)))\n    return bad\nif __name__=='__main__':\n    meta=json.load(open(sys.argv[1])); base=sys.argv[2]; outdir=sys.argv[3]\n    files=[(p,s) for p,s in meta['files'] if p.startswith(tuple(sys.argv[4].split(','))) and not p.endswith(('.ttf','.png','.ogg','.ico','.wav','.jar'))]\n    print(len(files),'files')\n    bad=run(base,files,outdir)\n    print('bad',bad)\nEOF\ntime python3 fetch_repo.py client_files.json \"https://raw.githubusercontent.com/Maminoradost184/valkyrieclient/b303bd5ef6f0f7a9d032ccd78661e5b740a3fad1/\" /tmp/w/client \"src/,README.md,CHANGELOG.md,RELEASE,build.gradle,gradle.properties,settings.gradle,THIRD_PARTY,.gitignore\"","timeoutMs":120000,"description":"Download all client source files"}
