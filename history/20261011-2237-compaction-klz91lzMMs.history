  Input: {"command":"mkdir -p /tmp/w/tools/test/src && cd /tmp/w/tools/test && python3 -c \"\nimport json\nd=json.load(open('/tmp/w/chat/valkyrie-launcher/ui/tests/fixtures/schemes.json'))\nlines=[]\nfor name,v in d.items():\n  for mode in ('light','dark'):\n    for role,hexv in v[mode].items():\n      lines.append(f'{v[\\\"seed\\\"]} {mode} {role} {hexv}')\nopen('/tmp/w/tools/test/golden.txt','w').write('\\n'.join(lines)+'\\n')\nprint(len(lines))\n\" && cat > src/GoldenSchemeTest.java <<'EOF'\nimport com.valkyrie.client.ui.color.*;\nimport java.nio.file.*; import java.util.*;\npublic class GoldenSchemeTest { public static void main(String[] a) throws Exception {\n  int ok=0, bad=0, missing=0; Map<String,Role> byToken=new HashMap<>(); for (Role r: Role.all()) byToken.put(r.token,r);\n  for (String line: Files.readAllLines(Paths.get(a[0]))) { if(line.isBlank()) continue; String[] p=line.split(\" \");\n    int seed=0xFF000000|Integer.parseInt(p[0].substring(1),16); boolean dark=p[1].equals(\"dark\"); Role role=byToken.get(p[2]);\n    if(role==null){missing++; System.out.println(\"no role \"+p[2]); continue;}\n    int got=Scheme.of(seed,dark).get(role); String gs=String.format(\"#%06X\",got&0xFFFFFF);\n    if(gs.equalsIgnoreCase(p[3])) ok++; else {bad++; if(bad<15) System.out.println(\"MISMATCH \"+line+\" got \"+gs);} }\n  System.out.println(\"golden ok=\"+ok+\" bad=\"+bad+\" missingRoles=\"+missing+\" totalRoles=\"+Role.all().length);\n}}\nEOF\nrm -rf cls && java /tmp/w/tools/Javac.java cls \"\" /tmp/w/out/src/main/java/com/valkyrie/client/ui/color src 2>&1 | tail -5 && java -cp cls GoldenSchemeTest golden.txt","timeoutMs":120000,"description":"Run golden scheme test vs launcher"}
