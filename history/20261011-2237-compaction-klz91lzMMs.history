  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/icon && cat > SvgPath.java <<'EOF'\npackage com.valkyrie.client.ui.icon;\n\nimport java.awt.geom.Path2D;\n\n/** Небольшой парсер SVG path data (M L H V C S Q T A Z, абсолютные и относительные). */\npublic final class SvgPath {\n    private final String d;\n    private int pos;\n\n    private SvgPath(String d) {\n        this.d = d;\n    }\n\n    public static Path2D.Float parse(String data) {\n        return new SvgPath(data).run();\n    }\n\n    private Path2D.Float run() {\n        Path2D.Float path = new Path2D.Float();\n        float x = 0;\n        float y = 0;\n        float startX = 0;\n        float startY = 0;\n        float lastCx = 0;\n        float lastCy = 0;\n        char cmd = 0;\n        char prev = 0;\n        while (true) {\n            skipSeparators();\n            if (pos >= d.length()) {\n                break;\n            }\n            char c = d.charAt(pos);\n            if (Character.isLetter(c)) {\n                cmd = c;\n                pos++;\n            } else if (cmd == 0) {\n                throw new IllegalArgumentException(\"path must start with a command: \" + d);\n            }\n            boolean rel = Character.isLowerCase(cmd);\n            switch (Character.toUpperCase(cmd)) {\n                case 'M' -> {\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    path.moveTo(nx, ny);\n                    x = startX = nx;\n                    y = startY = ny;\n                    cmd = rel ? 'l' : 'L'; // последующие пары — lineto\n                }\n                case 'L' -> {\n                    x = num() + (rel ? x : 0);\n                    y = num() + (rel ? y : 0);\n                    path.lineTo(x, y);\n                }\n                case 'H' -> {\n                    x = num() + (rel ? x : 0);\n                    path.lineTo(x, y);\n                }\n                case 'V' -> {\n                    y = num() + (rel ? y : 0);\n                    path.lineTo(x, y);\n                }\n                case 'C' -> {\n                    float x1 = num() + (rel ? x : 0);\n                    float y1 = num() + (rel ? y : 0);\n                    float x2 = num() + (rel ? x : 0);\n                    float y2 = num() + (rel ? y : 0);\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    path.curveTo(x1, y1, x2, y2, nx, ny);\n                    lastCx = x2;\n                    lastCy = y2;\n                    x = nx;\n                    y = ny;\n                }\n                case 'S' -> {\n                    boolean smooth = \"CcSs\".indexOf(prev) >= 0;\n                    float x1 = smooth ? 2 * x - lastCx : x;\n                    float y1 = smooth ? 2 * y - lastCy : y;\n                    float x2 = num() + (rel ? x : 0);\n                    float y2 = num() + (rel ? y : 0);\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    path.curveTo(x1, y1, x2, y2, nx, ny);\n                    lastCx = x2;\n                    lastCy = y2;\n                    x = nx;\n                    y = ny;\n                }\n                case 'Q' -> {\n                    float x1 = num() + (rel ? x : 0);\n                    float y1 = num() + (rel ? y : 0);\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    path.quadTo(x1, y1, nx, ny);\n                    lastCx = x1;\n                    lastCy = y1;\n                    x = nx;\n                    y = ny;\n                }\n                case 'T' -> {\n                    boolean smooth = \"QqTt\".indexOf(prev) >= 0;\n                    float x1 = smooth ? 2 * x - lastCx : x;\n                    float y1 = smooth ? 2 * y - lastCy : y;\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    path.quadTo(x1, y1, nx, ny);\n                    lastCx = x1;\n                    lastCy = y1;\n                    x = nx;\n                    y = ny;\n                }\n                case 'A' -> {\n                    float rx = num();\n                    float ry = num();\n                    float rotation = num();\n                    boolean large = flag();\n                    boolean sweep = flag();\n                    float nx = num() + (rel ? x : 0);\n                    float ny = num() + (rel ? y : 0);\n                    arc(path, x, y, rx, ry, rotation, large, sweep, nx, ny);\n                    x = nx;\n                    y = ny;\n                }\n                case 'Z' -> {\n                    path.closePath();\n                    x = startX;\n                    y = startY;\n                }\n                default -> throw new IllegalArgumentException(\"unsupported command \" + cmd);\n            }\n            prev = cmd;\n        }\n        return path;\n    }\n\n    private void skipSeparators() {\n        while (pos < d.length()) {\n            char c = d.charAt(pos);\n            if (c == ' ' || c == ',' || c == '\\n' || c == '\\t' || c == '\\r') {\n                pos++;\n            } else {\n                break;\n            }\n        }\n    }\n\n    private boolean flag() {\n        skipSeparators();\n        char c = d.charAt(pos++);\n        return c == '1';\n    }\n\n    private float num() {\n        skipSeparators();\n        int start = pos;\n        if (pos < d.length() && (d.charAt(pos) == '-' || d.charAt(pos) == '+')) {\n            pos++;\n        }\n        boolean dot = false;\n        while (pos < d.length()) {\n            char c = d.charAt(pos);\n            if (Character.isDigit(c)) {\n                pos++;\n            } else if (c == '.' && !dot) {\n                dot = true;\n                pos++;\n            } else if ((c == 'e' || c == 'E') && pos + 1 < d.length()) {\n                pos++;\n                if (d.charAt(pos) == '-' || d.charAt(pos) == '+') {\n                    pos++;\n                }\n            } else {\n                break;\n            }\n        }\n        return Float.parseFloat(d.substring(start, pos));\n    }\n\n    /** Эллиптическая дуга SVG → кубические кривые (W3C SVG, приложение F.6). */\n    private static void arc(Path2D.Float path, float x0, float y0, float rx, float ry, float angle,\n                            boolean large, boolean sweep, float x, float y) {\n        if (rx == 0 || ry == 0) {\n            path.lineTo(x, y);\n            return;\n        }\n        double phi = Math.toRadians(angle);\n        double cos = Math.cos(phi);\n        double sin = Math.sin(phi);\n        double dx = (x0 - x) / 2.0;\n        double dy = (y0 - y) / 2.0;\n        double x1p = cos * dx + sin * dy;\n        double y1p = -sin * dx + cos * dy;\n        double arx = Math.abs(rx);\n        double ary = Math.abs(ry);\n        double lambda = (x1p * x1p) / (arx * arx) + (y1p * y1p) / (ary * ary);\n        if (lambda > 1) {\n            arx *= Math.sqrt(lambda);\n            ary *= Math.sqrt(lambda);\n        }\n        double num = arx * arx * ary * ary - arx * arx * y1p * y1p - ary * ary * x1p * x1p;\n        double den = arx * arx * y1p * y1p + ary * ary * x1p * x1p;\n        double coef = Math.sqrt(Math.max(0, num / den)) * (large == sweep ? -1 : 1);\n        double cxp = coef * (arx * y1p / ary);\n        double cyp = coef * -(ary * x1p / arx);\n        double cx = cos * cxp - sin * cyp + (x0 + x) / 2.0;\n        double cy = sin * cxp + cos * cyp + (y0 + y) / 2.0;\n        double theta1 = angle((x1p - cxp) / arx, (y1p - cyp) / ary);\n        double delta = angle((x1p - cxp) / arx, (y1p - cyp) / ary, (-x1p - cxp) / arx, (-y1p - cyp) / ary);\n        if (!sweep && delta > 0) {\n            delta -= 2 * Math.PI;\n        } else if (sweep && delta < 0) {\n            delta += 2 * Math.PI;\n        }\n        int segments = (int) Math.ceil(Math.abs(delta) / (Math.PI / 2) - 1e-7);\n        double step = delta / Math.max(1, segments);\n        double t = 4.0 / 3.0 * Math.tan(step / 4);\n        double a = theta1;\n        for (int i = 0; i < segments; i++) {\n            double c1 = Math.cos(a);\n            double s1 = Math.sin(a);\n            double c2 = Math.cos(a + step);\n            double s2 = Math.sin(a + step);\n            double[] p1 = map(cx, cy, arx, ary, cos, sin, c1 - t * s1, s1 + t * c1);\n            double[] p2 = map(cx, cy, arx, ary, cos, sin, c2 + t * s2, s2 - t * c2);\n            double[] p3 = map(cx, cy, arx, ary, cos, sin, c2, s2);\n            path.curveTo(p1[0], p1[1], p2[0], p2[1], p3[0], p3[1]);\n            a += step;\n        }\n    }\n\n    private static double[] map(double cx, double cy, double rx, double ry, double cos, double sin, double ux, double uy) {\n        double px = ux * rx;\n        double py = uy * ry;\n        return new double[] {cx + cos * px - sin * py, cy + sin * px + cos * py};\n    }\n\n    private static double angle(double ux, double uy) {\n        return Math.atan2(uy, ux);\n    }\n\n    private static double angle(double ux, double uy, double vx, double vy) {\n        return Math.atan2(ux * vy - uy * vx, ux * vx + uy * vy);\n    }\n}\nEOF\necho ok","description":"Write SVG path parser"}
