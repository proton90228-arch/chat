  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/color && cat > Hct.java <<'EOF'\npackage com.valkyrie.client.ui.color;\n\n/**\n * HCT (Hue · Chroma · Tone) из Material Color Utilities: CAM16 + CIE L*.\n * <p>\n * Порт {@code valkyrie-launcher/ui/src/theme/hct.ts} с тем же порядком операций,\n * поэтому клиент и лаунчер получают из одного seed-цвета байт-в-байт одинаковые\n * схемы (проверяется тестом против {@code schemes.json} лаунчера).\n * Стандартные условия просмотра MCU: sRGB, D65, L* фона 50, surround 2.\n */\npublic final class Hct {\n    private static final double[] WHITE = {95.047, 100.0, 108.883};\n    private static final double[][] SRGB_TO_XYZ = {\n        {0.41233895, 0.35762064, 0.18051042},\n        {0.2126, 0.7152, 0.0722},\n        {0.01932141, 0.11916382, 0.95034478},\n    };\n    private static final double[][] XYZ_TO_SRGB = {\n        {3.2413774792388685, -1.5376652402851851, -0.49885366846268053},\n        {-0.9691452513005321, 1.8758853451067872, 0.04156585616912061},\n        {0.05562093689691305, -0.20395524564742123, 1.0571799111220335},\n    };\n    private static final double[][] XYZ_TO_CAM16RGB = {\n        {0.401288, 0.650173, -0.051461},\n        {-0.250268, 1.204414, 0.045854},\n        {-0.002079, 0.048952, 0.953127},\n    };\n    private static final double DEG_TO_RAD = Math.PI / 180.0;\n    private static final double RAD_TO_DEG = 180.0 / Math.PI;\n\n    // Условия просмотра (ViewingConditions.DEFAULT).\n    private static final double NC;\n    private static final double C;\n    private static final double[] RGB_D;\n    private static final double FL;\n    private static final double N;\n    private static final double Z;\n    private static final double NBB;\n    private static final double NCB;\n    private static final double AW;\n\n    static {\n        double adapting = ((200.0 / Math.PI) * yFromLstar(50.0)) / 100.0;\n        double[] w = mul(XYZ_TO_CAM16RGB, WHITE);\n        double f = 0.8 + 2.0 / 10.0;\n        double c = f >= 0.9 ? 0.59 + (0.69 - 0.59) * ((f - 0.9) * 10) : 0.525 + (0.59 - 0.525) * ((f - 0.8) * 10);\n        double d = f * (1 - (1 / 3.6) * Math.exp((-adapting - 42) / 92));\n        d = Math.max(0, Math.min(1, d));\n        double[] rgbD = {d * (100 / w[0]) + 1 - d, d * (100 / w[1]) + 1 - d, d * (100 / w[2]) + 1 - d};\n        double k = 1 / (5 * adapting + 1);\n        double k4 = k * k * k * k;\n        double k4F = 1 - k4;\n        double fl = k4 * adapting + 0.1 * k4F * k4F * Math.cbrt(5 * adapting);\n        double n = yFromLstar(50.0) / WHITE[1];\n        double z = 1.48 + Math.sqrt(n);\n        double nbb = 0.725 / Math.pow(n, 0.2);\n        double[] rgbA = new double[3];\n        for (int i = 0; i < 3; i++) {\n            double fac = Math.pow((fl * rgbD[i] * w[i]) / 100, 0.42);\n            rgbA[i] = (400 * fac) / (fac + 27.13);\n        }\n        NC = f;\n        C = c;\n        RGB_D = rgbD;\n        FL = fl;\n        N = n;\n        Z = z;\n        NBB = nbb;\n        NCB = nbb;\n        AW = (2 * rgbA[0] + rgbA[1] + 0.05 * rgbA[2]) * nbb;\n    }\n\n    private Hct() {\n    }\n\n    // ─── Публичное API ───────────────────────────────────────────────────────\n\n    /** {hue, chroma, tone} цвета ARGB (альфа игнорируется). */\n    public static double[] fromArgb(int argb) {\n        double[] lin = {linearized((argb >> 16) & 0xFF), linearized((argb >> 8) & 0xFF), linearized(argb & 0xFF)};\n        double[] xyz = mul(SRGB_TO_XYZ, lin);\n        double[] cam = cam16FromXyz(xyz[0], xyz[1], xyz[2]);\n        return new double[] {cam[0], cam[1], lstarFromY(xyz[1])};\n    }\n\n    /** Цвет с заданными hue/tone и максимально достижимой chroma ≤ запрошенной; непрозрачный ARGB. */\n    public static int toArgb(double hue, double chroma, double tone) {\n        if (tone <= 0.0001) {\n            return 0xFF000000;\n        }\n        if (tone >= 99.9999) {\n            return 0xFFFFFFFF;\n        }\n        double[] lin = linearRgb(hue, chroma, tone);\n        if (!inGamut(lin)) {\n            double lo = 0.0;\n            double hi = chroma;\n            for (int i = 0; i < 40; i++) {\n                double mid = (lo + hi) / 2;\n                if (inGamut(linearRgb(hue, mid, tone))) {\n                    lo = mid;\n                } else {\n                    hi = mid;\n                }\n            }\n            lin = linearRgb(hue, lo, tone);\n        }\n        int r = delinearized(clamp100(lin[0]));\n        int g = delinearized(clamp100(lin[1]));\n        int b = delinearized(clamp100(lin[2]));\n        return 0xFF000000 | (r << 16) | (g << 8) | b;\n    }\n\n    /** M3 Blend.harmonize: поворот hue к источнику на min(15°, разница/2). Возвращает {hue, chroma, tone}. */\n    public static double[] harmonize(int design, int source) {\n        double[] d = fromArgb(design);\n        double[] s = fromArgb(source);\n        double diff = 180 - Math.abs(Math.abs(d[0] - s[0]) - 180);\n        double rotation = Math.min(diff * 0.5, 15.0);\n        double direction = mod360(s[0] - d[0]) < 180 ? 1 : -1;\n        return new double[] {mod360(d[0] + rotation * direction), d[1], d[2]};\n    }\n\n    /** Контраст WCAG 2.x между двумя цветами. */\n    public static double contrast(int a, int b) {\n        double la = luminance(a);\n        double lb = luminance(b);\n        double hi = Math.max(la, lb);\n        double lo = Math.min(la, lb);\n        return (hi + 0.05) / (lo + 0.05);\n    }\n\n    /** Относительная яркость WCAG (0..1). */\n    public static double luminance(int argb) {\n        double r = linearized((argb >> 16) & 0xFF) / 100;\n        double g = linearized((argb >> 8) & 0xFF) / 100;\n        double b = linearized(argb & 0xFF) / 100;\n        return 0.2126 * r + 0.7152 * g + 0.0722 * b;\n    }\n\n    /** Остаток как в Python: всегда в [0, 360). */\n    public static double mod360(double value) {\n        double r = value % 360;\n        return r < 0 ? r + 360 : r;\n    }\n\n    public static double yFromLstar(double l) {\n        return 100.0 * labInvF((l + 16) / 116);\n    }\n\n    public static double lstarFromY(double y) {\n        return 116 * labF(y / 100) - 16;\n    }\n\n    // ─── CAM16 ───────────────────────────────────────────────────────────────\n\n    private static double[] cam16FromXyz(double x, double y, double z) {\n        double[] rgbC = mul(XYZ_TO_CAM16RGB, new double[] {x, y, z});\n        double rA = adapt(RGB_D[0] * rgbC[0]);\n        double gA = adapt(RGB_D[1] * rgbC[1]);\n        double bA = adapt(RGB_D[2] * rgbC[2]);\n        double a = (11 * rA - 12 * gA + bA) / 11;\n        double b = (rA + gA - 2 * bA) / 9;\n        double u = (20 * rA + 20 * gA + 21 * bA) / 20;\n        double p2 = (40 * rA + 20 * gA + bA) / 20;\n        double hue = mod360(RAD_TO_DEG * Math.atan2(b, a));\n        double ac = p2 * NBB;\n        double j = 100 * Math.pow(ac / AW, C * Z);\n        double hp = hue < 20.14 ? hue + 360 : hue;\n        double eHue = 0.25 * (Math.cos(DEG_TO_RAD * hp + 2) + 3.8);\n        double p1 = (50000.0 / 13) * eHue * NC * NCB;\n        double t = (p1 * Math.hypot(a, b)) / (u + 0.305);\n        double alpha = Math.pow(t, 0.9) * Math.pow(1.64 - Math.pow(0.29, N), 0.73);\n        return new double[] {hue, alpha * Math.sqrt(j / 100), j};\n    }\n\n    private static double adapt(double v) {\n        double af = Math.pow((FL * Math.abs(v)) / 100, 0.42);\n        return (sign(v) * 400 * af) / (af + 27.13);\n    }\n\n    private static double[] xyzFromJch(double j, double chroma, double hue) {\n        double alpha = chroma == 0 || j == 0 ? 0 : chroma / Math.sqrt(j / 100);\n        double t = Math.pow(alpha / Math.pow(1.64 - Math.pow(0.29, N), 0.73), 1 / 0.9);\n        double h = DEG_TO_RAD * hue;\n        double eHue = 0.25 * (Math.cos(h + 2) + 3.8);\n        double ac = AW * Math.pow(j / 100, 1 / C / Z);\n        double p1 = eHue * (50000.0 / 13) * NC * NCB;\n        double p2 = ac / NBB;\n        double hs = Math.sin(h);\n        double hc = Math.cos(h);\n        double gamma = (23 * (p2 + 0.305) * t) / (23 * p1 + 11 * t * hc + 108 * t * hs);\n        double a = gamma * hc;\n        double b = gamma * hs;\n        double rA = (460 * p2 + 451 * a + 288 * b) / 1403;\n        double gA = (460 * p2 - 891 * a - 261 * b) / 1403;\n        double bA = (460 * p2 - 220 * a - 6300 * b) / 1403;\n        double rF = unadapt(rA) / RGB_D[0];\n        double gF = unadapt(gA) / RGB_D[1];\n        double bF = unadapt(bA) / RGB_D[2];\n        return new double[] {\n            1.86206786 * rF - 1.01125463 * gF + 0.14918677 * bF,\n            0.38752654 * rF + 0.62144744 * gF - 0.00897398 * bF,\n            -0.0158415 * rF - 0.03412294 * gF + 1.04996444 * bF,\n        };\n    }\n\n    private static double unadapt(double v) {\n        double base = Math.max(0, (27.13 * Math.abs(v)) / (400 - Math.abs(v)));\n        return sign(v) * (100 / FL) * Math.pow(base, 1 / 0.42);\n    }\n\n    private static double solveJForY(double hue, double chroma, double yTarget) {\n        double lo = 0.0;\n        double hi = 100.0;\n        for (int i = 0; i < 60; i++) {\n            double mid = (lo + hi) / 2;\n            double y = xyzFromJch(mid, chroma, hue)[1];\n            if (y < yTarget) {\n                lo = mid;\n            } else {\n                hi = mid;\n            }\n        }\n        return (lo + hi) / 2;\n    }\n\n    private static double[] linearRgb(double hue, double chroma, double tone) {\n        double j = solveJForY(hue, chroma, yFromLstar(tone));\n        return mul(XYZ_TO_SRGB, xyzFromJch(j, chroma, hue));\n    }\n\n    private static boolean inGamut(double[] lin) {\n        double eps = 0.01;\n        for (double c : lin) {\n            if (c < -eps || c > 100 + eps) {\n                return false;\n            }\n        }\n        return true;\n    }\n\n    // ─── sRGB ────────────────────────────────────────────────────────────────\n\n    static double linearized(int c8) {\n        double n = c8 / 255.0;\n        return (n <= 0.040449936 ? n / 12.92 : Math.pow((n + 0.055) / 1.055, 2.4)) * 100;\n    }\n\n    private static int delinearized(double c) {\n        double n = c / 100.0;\n        double v = n <= 0.0031308 ? n * 12.92 : 1.055 * Math.pow(n, 1 / 2.4) - 0.055;\n        return (int) Math.max(0, Math.min(255, roundHalfEven(v * 255)));\n    }\n\n    /** Банковское округление, как {@code round()} в Python (и как в лаунчере). */\n    private static double roundHalfEven(double x) {\n        double r = Math.floor(x + 0.5); // Math.round из JS: половина — вверх\n        double frac = Math.abs(x % 1);\n        return frac == 0.5 && r % 2 != 0 ? r - 1 : r;\n    }\n\n    private static double labF(double t) {\n        double e = 216.0 / 24389.0;\n        double k = 24389.0 / 27.0;\n        return t > e ? Math.pow(t, 1.0 / 3.0) : (k * t + 16) / 116;\n    }\n\n    private static double labInvF(double ft) {\n        double e = 216.0 / 24389.0;\n        double k = 24389.0 / 27.0;\n        double ft3 = ft * ft * ft;\n        return ft3 > e ? ft3 : (116 * ft - 16) / k;\n    }\n\n    private static double clamp100(double v) {\n        return Math.max(0, Math.min(100, v));\n    }\n\n    private static double sign(double v) {\n        return v < 0 ? -1 : 1;\n    }\n\n    private static double[] mul(double[][] m, double[] v) {\n        return new double[] {\n            m[0][0] * v[0] + m[0][1] * v[1] + m[0][2] * v[2],\n            m[1][0] * v[0] + m[1][1] * v[1] + m[1][2] * v[2],\n            m[2][0] * v[0] + m[2][1] * v[1] + m[2][2] * v[2],\n        };\n    }\n}\nEOF\ncat > TonalPalette.java <<'EOF'\npackage com.valkyrie.client.ui.color;\n\nimport java.util.HashMap;\nimport java.util.Map;\n\n/** Тональная палитра: фиксированные hue и chroma, тон 0..100. Значения кэшируются. */\npublic final class TonalPalette {\n    private final double hue;\n    private final double chroma;\n    private final Map<Integer, Integer> cache = new HashMap<>();\n\n    public TonalPalette(double hue, double chroma) {\n        this.hue = Hct.mod360(hue);\n        this.chroma = chroma;\n    }\n\n    public double hue() {\n        return hue;\n    }\n\n    public double chroma() {\n        return chroma;\n    }\n\n    /** Непрозрачный ARGB для тона (целого — как в токенах лаунчера). */\n    public int tone(int tone) {\n        return cache.computeIfAbsent(tone, t -> Hct.toArgb(hue, chroma, t));\n    }\n}\nEOF\necho ok","description":"Write Hct and TonalPalette"}
