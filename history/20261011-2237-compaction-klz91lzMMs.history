  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui && python3 - <<'EOF'\np='render/Ui.java'; s=open(p).read()\ns=s.replace(\"\"\"    public float alpha() {\n        return alpha;\n    }\"\"\",\"\"\"    public float alpha() {\n        return alpha;\n    }\n\n    /** Текущее смещение (GUI) — нужно, чтобы вставить в кадр чужую отрисовку (модель игрока). */\n    public float offsetX() {\n        return tx;\n    }\n\n    public float offsetY() {\n        return ty;\n    }\"\"\")\nopen(p,'w').write(s)\np='text/TypeStyle.java'; s=open(p).read()\ns=s.replace(\"\"\"    MONO(Fonts.Face.MONO, 6.0f, 9.0f, 0.0f);\"\"\",\"\"\"    MONO(Fonts.Face.MONO, 6.0f, 9.0f, 0.0f),\n    /** Совместимость со старыми экранами: строка высотой 9 как у прежнего шрифта. */\n    UI_TEXT(Fonts.Face.INTER_REGULAR, 7.0f, 9.0f, 0.0f),\n    UI_TITLE(Fonts.Face.JOST_MEDIUM, 7.75f, 9.0f, 0.006f);\"\"\")\nopen(p,'w').write(s)\np='clickgui/ClickGuiView.java'; s=open(p).read()\ns=s.replace(\"\"\"    public boolean closing() {\n        return closing;\n    }\"\"\",\"\"\"    public boolean closing() {\n        return closing;\n    }\n\n    public boolean searchFocused() {\n        return searchFocus;\n    }\"\"\")\nopen(p,'w').write(s)\nEOF\nmkdir -p mc && cat > mc/GuiCanvas.java <<'EOF'\npackage com.valkyrie.client.ui.mc;\n\nimport com.mojang.blaze3d.platform.NativeImage;\nimport com.mojang.blaze3d.platform.Window;\nimport com.valkyrie.client.ui.render.Canvas;\nimport com.valkyrie.client.ui.render.Mask;\nimport java.util.ArrayList;\nimport java.util.Iterator;\nimport java.util.List;\nimport net.minecraft.client.Minecraft;\nimport net.minecraft.client.gui.GuiGraphics;\nimport net.minecraft.client.renderer.RenderPipelines;\nimport net.minecraft.client.renderer.texture.DynamicTexture;\nimport net.minecraft.resources.ResourceLocation;\n\n/**\n * {@link Canvas} поверх {@link GuiGraphics}: на время отрисовки поза масштабируется\n * на {@code 1/guiScale}, и все координаты — это физические пиксели окна.\n * Маски живут в {@link DynamicTexture}; изменённые страницы атласа догружаются\n * в конце прохода (GUI в 1.21.6+ рисуется отложенно, в конце кадра).\n */\npublic final class GuiCanvas implements Canvas {\n    private static final GuiCanvas INSTANCE = new GuiCanvas();\n    private static final long EVICT_NANOS = 30_000_000_000L;\n\n    private GuiGraphics g;\n    private float scale = 1.0f;\n    private int width;\n    private int height;\n    private int depth;\n    private int counter;\n    private long lastEvict;\n    private final List<Mask> live = new ArrayList<>();\n    private final List<Mask> dirty = new ArrayList<>();\n\n    private static final class Tex {\n        ResourceLocation id;\n        DynamicTexture texture;\n        NativeImage image;\n        long lastUsed;\n    }\n\n    private GuiCanvas() {\n    }\n\n    public static GuiCanvas get() {\n        return INSTANCE;\n    }\n\n    /** {@code true}, если это внешний вызов (вложенные используют уже настроенную позу). */\n    public boolean begin(GuiGraphics graphics) {\n        if (depth++ > 0) {\n            return false;\n        }\n        g = graphics;\n        Window window = Minecraft.getInstance().getWindow();\n        int gw = Math.max(1, window.getGuiScaledWidth());\n        int gh = Math.max(1, window.getGuiScaledHeight());\n        scale = Math.max(1, Math.round((float) window.getWidth() / gw));\n        width = gw * Math.round(scale);\n        height = gh * Math.round(scale);\n        g.pose().pushMatrix();\n        g.pose().scale(1.0f / scale, 1.0f / scale);\n        return true;\n    }\n\n    public void end() {\n        if (--depth > 0) {\n            return;\n        }\n        depth = 0;\n        g.pose().popMatrix();\n        flush();\n        evict();\n        g = null;\n    }\n\n    public boolean active() {\n        return depth > 0;\n    }\n\n    @Override\n    public float scale() {\n        return scale;\n    }\n\n    @Override\n    public int width() {\n        return width;\n    }\n\n    @Override\n    public int height() {\n        return height;\n    }\n\n    @Override\n    public void fill(int x0, int y0, int x1, int y1, int argb) {\n        if (x1 > x0 && y1 > y0) {\n            g.fill(x0, y0, x1, y1, argb);\n        }\n    }\n\n    @Override\n    public void gradient(int x0, int y0, int x1, int y1, int argbTop, int argbBottom) {\n        if (x1 > x0 && y1 > y0) {\n            g.fillGradient(x0, y0, x1, y1, argbTop, argbBottom);\n        }\n    }\n\n    @Override\n    public void mask(Mask mask, int dx, int dy, int dw, int dh, int sx, int sy, int sw, int sh, int argb) {\n        if (dw <= 0 || dh <= 0) {\n            return;\n        }\n        g.blit(RenderPipelines.GUI_TEXTURED, texture(mask), dx, dy, (float) sx, (float) sy, dw, dh, sw, sh, mask.width, mask.height, argb);\n    }\n\n    /**\n     * Ножницы задаются в единицах GUI при исходной позе: границы {@code Ui.clip}\n     * уже выровнены по сетке GUI, поэтому деление точное.\n     */\n    @Override\n    public void pushClip(int x0, int y0, int x1, int y1) {\n        g.pose().pushMatrix();\n        g.pose().scale(scale, scale);\n        g.enableScissor(Math.round(x0 / scale), Math.round(y0 / scale), Math.round(x1 / scale), Math.round(y1 / scale));\n        g.pose().popMatrix();\n    }\n\n    @Override\n    public void popClip() {\n        g.disableScissor();\n    }\n\n    private ResourceLocation texture(Mask mask) {\n        Tex tex = mask.handle instanceof Tex t ? t : null;\n        if (tex == null || tex.texture == null) {\n            tex = new Tex();\n            tex.id = ResourceLocation.fromNamespaceAndPath(\"valkyrieclient\", \"ui/mask_\" + (counter++));\n            tex.image = new NativeImage(NativeImage.Format.RGBA, mask.width, mask.height, false);\n            write(mask, tex.image);\n            String label = \"valkyrie ui \" + mask.name;\n            tex.texture = new DynamicTexture(() -> label, tex.image);\n            tex.texture.setFilter(false, false);\n            tex.texture.upload();\n            Minecraft.getInstance().getTextureManager().register(tex.id, tex.texture);\n            mask.handle = tex;\n            mask.uploadedVersion = mask.version;\n            live.add(mask);\n        } else if (mask.uploadedVersion != mask.version && !dirty.contains(mask)) {\n            dirty.add(mask);\n        }\n        tex.lastUsed = System.nanoTime();\n        return tex.id;\n    }\n\n    private static void write(Mask mask, NativeImage image) {\n        byte[] alpha = mask.alpha;\n        int w = mask.width;\n        for (int y = 0; y < mask.height; y++) {\n            int row = y * w;\n            for (int x = 0; x < w; x++) {\n                image.setPixelABGR(x, y, ((alpha[row + x] & 0xFF) << 24) | 0x00FFFFFF);\n            }\n        }\n    }\n\n    private void flush() {\n        for (Mask mask : dirty) {\n            if (mask.handle instanceof Tex tex && tex.texture != null) {\n                write(mask, tex.image);\n                tex.texture.upload();\n                mask.uploadedVersion = mask.version;\n            }\n        }\n        dirty.clear();\n    }\n\n    private void evict() {\n        long now = System.nanoTime();\n        if (now - lastEvict < 5_000_000_000L) {\n            return;\n        }\n        lastEvict = now;\n        Iterator<Mask> it = live.iterator();\n        while (it.hasNext()) {\n            Mask mask = it.next();\n            if (mask.handle instanceof Tex tex && now - tex.lastUsed > EVICT_NANOS) {\n                Minecraft.getInstance().getTextureManager().release(tex.id);\n                tex.texture = null;\n                mask.handle = null;\n                mask.uploadedVersion = -1;\n                it.remove();\n            }\n        }\n    }\n}\nEOF\ncat > mc/McUi.java <<'EOF'\npackage com.valkyrie.client.ui.mc;\n\nimport com.valkyrie.client.module.ModuleRegistry;\nimport com.valkyrie.client.module.impl.AppearanceModule;\nimport com.valkyrie.client.module.impl.DarkThemeModule;\nimport com.valkyrie.client.ui.color.Role;\nimport com.valkyrie.client.ui.motion.Motion;\nimport com.valkyrie.client.ui.render.Ui;\nimport com.valkyrie.client.ui.text.TypeStyle;\nimport com.valkyrie.client.ui.theme.UiTheme;\nimport net.minecraft.client.Minecraft;\nimport net.minecraft.client.gui.GuiGraphics;\n\n/** Точка входа нового интерфейса для кода Minecraft. */\npublic final class McUi {\n    private static long lastSync;\n\n    private McUi() {\n    }\n\n    /** Начать рисование: часы кадра, тема, холст в физических пикселях. Парный вызов — {@link #end()}. */\n    public static Ui begin(GuiGraphics graphics) {\n        GuiCanvas canvas = GuiCanvas.get();\n        if (canvas.begin(graphics)) {\n            syncTheme(true);\n            return Ui.get().begin(canvas);\n        }\n        return Ui.get();\n    }\n\n    public static void end() {\n        GuiCanvas.get().end();\n    }\n\n    /** Цвет роли текущей схемы (с синхронизацией настроек не чаще раза в 50 мс). */\n    public static int role(Role role) {\n        syncTheme(false);\n        return UiTheme.c(role);\n    }\n\n    public static int role(Role role, float alpha) {\n        syncTheme(false);\n        return UiTheme.c(role, alpha);\n    }\n\n    public static void syncTheme(boolean frame) {\n        long now = System.nanoTime();\n        if (!frame && now - lastSync < 50_000_000L) {\n            return;\n        }\n        lastSync = now;\n        Motion.beginFrame();\n        try {\n            AppearanceModule appearance = ModuleRegistry.get(AppearanceModule.class);\n            DarkThemeModule dark = ModuleRegistry.get(DarkThemeModule.class);\n            int accent = appearance.accent.value();\n            UiTheme.sync((accent >>> 24) == 0 ? 0xFFDF91AA : accent, dark != null && dark.isEnabled());\n            Motion.setReduced(appearance.reducedMotion.value());\n        } catch (RuntimeException ignored) {\n            // Реестр ещё не готов (ранняя загрузка) — остаёмся на текущей схеме.\n        }\n    }\n\n    /** Ширина строки в GUI без активного кадра (для совместимых API шрифтов). */\n    public static float textWidth(TypeStyle style, String text) {\n        if (GuiCanvas.get().active()) {\n            return Ui.get().textWidth(style, text);\n        }\n        var window = Minecraft.getInstance().getWindow();\n        float scale = Math.max(1, Math.round((float) window.getWidth() / Math.max(1, window.getGuiScaledWidth())));\n        if (Ui.get().canvas() == null || Ui.get().scale() != scale) {\n            return measure(style, text, scale);\n        }\n        return Ui.get().textWidth(style, text);\n    }\n\n    private static float measure(TypeStyle style, String text, float scale) {\n        if (text == null || text.isEmpty()) {\n            return 0.0f;\n        }\n        var font = com.valkyrie.client.ui.text.Fonts.get(style).at(style.size * scale);\n        var layout = font.layout(text);\n        float tracking = style.tracking * style.size * scale;\n        return (layout.width + tracking * Math.max(0, layout.count() - 1)) / scale;\n    }\n}\nEOF\necho ok","description":"Write GuiCanvas and McUi adapters"}
