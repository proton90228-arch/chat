  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/icon && cat > Icon.java <<'EOF'\npackage com.valkyrie.client.ui.icon;\n\n/**\n * Векторные иконки на сетке 24×24 в стиле Material Symbols Rounded (обводка 2, круглые концы).\n * Мини-язык: {@code P} — обводка пути, {@code F} — заливка пути, {@code C cx cy r} — окружность,\n * {@code D cx cy r} — диск, {@code R x y w h r} — скруглённый прямоугольник (обводка),\n * {@code B x y w h r} — он же залитый. Команды разделяются {@code ;}.\n */\npublic enum Icon {\n    // ─── Интерфейс ────────────────────────────────────────────────────────────\n    SEARCH(\"C 10.5 10.5 6; P M15 15l5 5\"),\n    CLOSE(\"P M6.5 6.5l11 11; P M17.5 6.5l-11 11\"),\n    CHECK(\"P M5.5 12.5l4 4 9-9\"),\n    CHEVRON_DOWN(\"P M7 10l5 5 5-5\"),\n    CHEVRON_UP(\"P M7 14l5-5 5 5\"),\n    CHEVRON_RIGHT(\"P M10 7l5 5-5 5\"),\n    CHEVRON_LEFT(\"P M14 7l-5 5 5 5\"),\n    PLUS(\"P M12 5v14; P M5 12h14\"),\n    MINUS(\"P M5 12h14\"),\n    DOCK_CLOSE(\"R 3.5 4.5 17 15 3.5; P M9 5v14; P M15.5 9.5l-2.5 2.5 2.5 2.5\"),\n    DOCK_OPEN(\"R 3.5 4.5 17 15 3.5; P M9 5v14; P M13 9.5l2.5 2.5-2.5 2.5\"),\n    RESET(\"P M19.5 12a7.5 7.5 0 1 1-2.2-5.3; P M19.5 4.5v3.8h-3.8\"),\n    SPARKLE(\"F M12 2.5c.7 4.7 2.6 6.8 7 7.5-4.4.7-6.3 2.8-7 7.5-.7-4.7-2.6-6.8-7-7.5 4.4-.7 6.3-2.8 7-7.5z; F M18.5 15.5c.3 1.6.9 2.3 2.5 2.5-1.6.3-2.2.9-2.5 2.5-.3-1.6-.9-2.2-2.5-2.5 1.6-.2 2.2-.9 2.5-2.5z\"),\n    KEYBOARD(\"R 2.5 6 19 12 3; P M6.5 10h.01; P M10 10h.01; P M14 10h.01; P M17.5 10h.01; P M8 14h8\"),\n    MOUSE(\"R 6 3 12 18 6; P M12 7v3\"),\n\n    // ─── Категории ───────────────────────────────────────────────────────────\n    DASHBOARD(\"R 3.5 3.5 7.5 9 2.2; R 13 3.5 7.5 5.5 2.2; R 13 11 7.5 9.5 2.2; R 3.5 14.5 7.5 6 2.2\"),\n    EYE(\"P M2.5 12c2.3-4.6 5.6-7 9.5-7s7.2 2.4 9.5 7c-2.3 4.6-5.6 7-9.5 7s-7.2-2.4-9.5-7z; C 12 12 3\"),\n    SWORD(\"P M19.5 4.5v4L10 18l-4-4 9.5-9.5z; P M4.5 13l6.5 6.5; P M7 17l-3.5 3.5\"),\n    TUNE(\"P M4 7h9; P M19 7h1; C 16 7 2.5; P M4 17h2; P M12 17h8; C 9 17 2.5\"),\n\n    // ─── Модули ──────────────────────────────────────────────────────────────\n    TAG(\"P M3.5 12.2V5.5a2 2 0 0 1 2-2h6.7l8.3 8.3a2 2 0 0 1 0 2.8l-5.9 5.9a2 2 0 0 1-2.8 0z; D 8.2 8.2 1.5\"),\n    INFO(\"C 12 12 8.5; P M12 11v5; P M12 7.9v.01\"),\n    SHIELD(\"P M12 3.5l7 2.8v5.2c0 4.6-3 8-7 9.5-4-1.5-7-4.9-7-9.5V6.3z\"),\n    FLASK(\"P M9 3.5h6; P M10.5 3.5v5.5l-5 8.6c-.8 1.4.2 2.9 1.8 2.9h9.4c1.6 0 2.6-1.5 1.8-2.9l-5-8.6V3.5; P M7.6 14.5h8.8\"),\n    MOVE(\"P M12 3.5v17; P M3.5 12h17; P M9.5 6l2.5-2.5L14.5 6; P M9.5 18l2.5 2.5 2.5-2.5; P M6 9.5L3.5 12 6 14.5; P M18 9.5l2.5 2.5-2.5 2.5\"),\n    PERSON(\"C 12 8 3.5; P M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5\"),\n    CUBE(\"P M12 3l8 4.5v9L12 21l-8-4.5v-9z; P M4 7.5l8 4.5 8-4.5; P M12 12v9\"),\n    TRACERS(\"P M12 20.5L5.5 6; P M12 20.5L18.5 6; P M12 20.5V4.5; D 5.5 5 1.7; D 18.5 5 1.7; D 12 3.8 1.7\"),\n    HITMARKER(\"P M5 5l4 4; P M19 5l-4 4; P M5 19l4-4; P M19 19l-4-4\"),\n    DROP(\"P M12 3.5c3.5 4.2 6 7.4 6 10.5a6 6 0 0 1-12 0c0-3.1 2.5-6.3 6-10.5z\"),\n    CROSSHAIR(\"P M12 3.5v5; P M12 15.5v5; P M3.5 12h5; P M15.5 12h5; D 12 12 1.3\"),\n    SUN(\"C 12 12 4; P M12 2.5v2; P M12 19.5v2; P M2.5 12h2; P M19.5 12h2; P M5.3 5.3l1.4 1.4; P M17.3 17.3l1.4 1.4; P M5.3 18.7l1.4-1.4; P M17.3 6.7l1.4-1.4\"),\n    MOON(\"P M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z\"),\n    GLOW(\"D 12 12 3.2; C 12 12 7.5; P M12 1.8v1; P M12 21.2v1; P M1.8 12h1; P M21.2 12h1\"),\n    STARS(\"D 6 7.5 1.8; D 17.5 5 1.8; D 19 15.5 1.8; D 8.5 18.5 1.8; P M7.7 7.1l8-1.7; P M17.8 6.8l1 6.9; P M17.3 16.2l-7 2; P M8.1 16.7L6.4 9.3\"),\n    LENS(\"C 10.5 10.5 6.5; P M15.5 15.5l5 5; P M7.5 10.5h6; P M11.5 8.5l2 2-2 2\"),\n    HISTORY(\"P M4.5 12a7.5 7.5 0 1 0 2.2-5.3; P M4.5 4.5v3.8h3.8; P M12 8v4.5l3 2\"),\n    SELECT(\"P M4.5 9V7a2.5 2.5 0 0 1 2.5-2.5h2; P M15 4.5h2A2.5 2.5 0 0 1 19.5 7v2; P M19.5 15v2a2.5 2.5 0 0 1-2.5 2.5h-2; P M9 19.5H7A2.5 2.5 0 0 1 4.5 17v-2; B 9 9 6 6 1.5\"),\n    ORBIT(\"P M5 18.5c2.5-7 7.5-11 14.5-11.5; D 5 18.5 2.3; C 19 7 1.8\"),\n    TRAIL(\"P M3.5 19c3.5-.5 5.5-3 7.5-5.5s4.5-5 8-5.5; D 18.8 8 2.6; D 7.3 16.6 1; D 10.3 13.6 1.1\"),\n    MOTION(\"C 15 9 5; P M9.4 7.6a5.5 5.5 0 0 0 7 7; P M5.6 11.6a5.5 5.5 0 0 0 7 7\"),\n    CAMERA(\"P M4 8.5a2 2 0 0 1 2-2h2l1.5-2h5l1.5 2h2a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z; C 12 12.5 3.5\"),\n    CHEST(\"R 3.5 5 17 14 2.5; P M3.5 10.5h17; B 10.5 9 3 4 1\"),\n    PALETTE(\"P M12 3.5a8.5 8.5 0 1 0 0 17c1.2 0 1.8-.8 1.8-1.7 0-1.2-1-1.6-1-2.6 0-.9.7-1.6 1.6-1.6h2.1c2.3 0 4-1.8 4-4.1 0-3.9-3.8-7-8.5-7z; D 7.8 11.5 1.35; D 9.6 7.6 1.35; D 14 7.1 1.35; D 16.8 10.3 1.35\"),\n    AIM(\"C 12 12 7.5; D 12 12 2; P M12 2.5v3; P M12 18.5v3; P M2.5 12h3; P M18.5 12h3\"),\n    BOLT(\"P M13 3L5.5 13.5h6L10.5 21l8-10.5h-6z\"),\n    SWAP(\"P M7 4.5l-3 3 3 3; P M4 7.5h12.5; P M17 13.5l3 3-3 3; P M20 16.5H7.5\"),\n    HEART(\"P M12 20s-7.5-4.6-7.5-10.1A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.7C19.5 15.4 12 20 12 20z\"),\n    BURST(\"P M12 3.5l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L12 15.9l-5 2.7 1.2-5.5L4 9.3l5.6-.6z\"),\n    HOME(\"P M4.5 10.5L12 4.5l7.5 6V19a1.5 1.5 0 0 1-1.5 1.5h-3.5V15h-5v5.5H6A1.5 1.5 0 0 1 4.5 19z\"),\n    FOCUS(\"P M4 8.5V6a2 2 0 0 1 2-2h2.5; P M15.5 4H18a2 2 0 0 1 2 2v2.5; P M20 15.5V18a2 2 0 0 1-2 2h-2.5; P M8.5 20H6a2 2 0 0 1-2-2v-2.5; C 12 12 3\"),\n    LAYERS(\"P M12 4l8.5 4.5L12 13 3.5 8.5z; P M3.5 12.5L12 17l8.5-4.5; P M3.5 16.5L12 21l8.5-4.5\"),\n    TOOLTIP(\"R 3.5 4 17 12.5 3; P M10 16.5l2 3 2-3; P M8 9h8; P M8 12h5\"),\n    SAKURA(null);\n\n    final String source;\n\n    Icon(String source) {\n        this.source = source;\n    }\n}\nEOF\ncat > IconRaster.java <<'EOF'\npackage com.valkyrie.client.ui.icon;\n\nimport com.valkyrie.client.ui.render.Mask;\nimport java.awt.BasicStroke;\nimport java.awt.Color;\nimport java.awt.Graphics2D;\nimport java.awt.RenderingHints;\nimport java.awt.Shape;\nimport java.awt.geom.AffineTransform;\nimport java.awt.geom.Ellipse2D;\nimport java.awt.geom.Path2D;\nimport java.awt.geom.RoundRectangle2D;\nimport java.awt.image.BufferedImage;\nimport java.awt.image.DataBufferByte;\nimport java.util.ArrayList;\nimport java.util.EnumMap;\nimport java.util.List;\nimport java.util.Map;\n\n/** Растеризует иконки в маски нужного пиксельного размера (Java2D, сглаживание, «чистые» штрихи). */\npublic final class IconRaster {\n    private record Op(char kind, Shape shape) {\n    }\n\n    private static final Map<Icon, List<Op>> PARSED = new EnumMap<>(Icon.class);\n\n    private IconRaster() {\n    }\n\n    public static Mask render(Icon icon, int px) {\n        return render(icon, px, 1.0f);\n    }\n\n    /** {@code weight} — множитель толщины штриха (1 — стандарт, 1.15 — активная иконка). */\n    public static Mask render(Icon icon, int px, float weight) {\n        int size = Math.max(4, px);\n        BufferedImage image = new BufferedImage(size, size, BufferedImage.TYPE_BYTE_GRAY);\n        Graphics2D g = image.createGraphics();\n        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);\n        g.setRenderingHint(RenderingHints.KEY_STROKE_CONTROL, RenderingHints.VALUE_STROKE_PURE);\n        g.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);\n        g.setColor(Color.WHITE);\n        float scale = size / 24.0f;\n        AffineTransform transform = AffineTransform.getScaleInstance(scale, scale);\n        // Минимальная толщина ~1.25 px, чтобы мелкие иконки не «рассыпались».\n        float stroke = Math.max(1.25f, 2.0f * scale * weight);\n        g.setStroke(new BasicStroke(stroke, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));\n        for (Op op : ops(icon)) {\n            Shape shape = transform.createTransformedShape(op.shape());\n            if (op.kind() == 'F') {\n                g.fill(shape);\n            } else {\n                g.draw(shape);\n            }\n        }\n        g.dispose();\n        Mask mask = new Mask(icon.name() + \"@\" + size, size, size);\n        byte[] gray = ((DataBufferByte) image.getRaster().getDataBuffer()).getData();\n        System.arraycopy(gray, 0, mask.alpha, 0, gray.length);\n        return mask;\n    }\n\n    private static synchronized List<Op> ops(Icon icon) {\n        return PARSED.computeIfAbsent(icon, IconRaster::parse);\n    }\n\n    private static List<Op> parse(Icon icon) {\n        List<Op> ops = new ArrayList<>();\n        if (icon == Icon.SAKURA) {\n            ops.add(new Op('F', sakura()));\n            return ops;\n        }\n        for (String part : icon.source.split(\";\")) {\n            String p = part.trim();\n            if (p.isEmpty()) {\n                continue;\n            }\n            char kind = p.charAt(0);\n            String rest = p.substring(1).trim();\n            switch (kind) {\n                case 'P' -> ops.add(new Op('S', SvgPath.parse(rest)));\n                case 'F' -> ops.add(new Op('F', SvgPath.parse(rest)));\n                case 'C', 'D' -> {\n                    float[] v = numbers(rest);\n                    Shape s = new Ellipse2D.Float(v[0] - v[2], v[1] - v[2], v[2] * 2, v[2] * 2);\n                    ops.add(new Op(kind == 'C' ? 'S' : 'F', s));\n                }\n                case 'R', 'B' -> {\n                    float[] v = numbers(rest);\n                    Shape s = new RoundRectangle2D.Float(v[0], v[1], v[2], v[3], v[4] * 2, v[4] * 2);\n                    ops.add(new Op(kind == 'R' ? 'S' : 'F', s));\n                }\n                default -> throw new IllegalArgumentException(\"bad icon op \" + p);\n            }\n        }\n        return ops;\n    }\n\n    private static float[] numbers(String s) {\n        String[] parts = s.trim().split(\"[\\\\s,]+\");\n        float[] out = new float[parts.length];\n        for (int i = 0; i < parts.length; i++) {\n            out[i] = Float.parseFloat(parts[i]);\n        }\n        return out;\n    }\n\n    /** Цветок сакуры: пять лепестков с выемкой на конце, повёрнутых на 72°. */\n    static Shape sakura() {\n        Path2D.Float petal = new Path2D.Float();\n        // Лепесток вверх от центра (12,12): основание узкое, вершина с вырезом.\n        petal.moveTo(12.0f, 12.6f);\n        petal.curveTo(9.0f, 10.4f, 8.1f, 6.6f, 9.6f, 3.6f);\n        petal.curveTo(10.6f, 3.0f, 11.3f, 3.0f, 12.0f, 4.6f);\n        petal.curveTo(12.7f, 3.0f, 13.4f, 3.0f, 14.4f, 3.6f);\n        petal.curveTo(15.9f, 6.6f, 15.0f, 10.4f, 12.0f, 12.6f);\n        petal.closePath();\n        Path2D.Float flower = new Path2D.Float(Path2D.WIND_NON_ZERO);\n        for (int i = 0; i < 5; i++) {\n            AffineTransform r = AffineTransform.getRotateInstance(Math.toRadians(i * 72.0), 12.0, 12.4);\n            flower.append(r.createTransformedShape(petal), false);\n        }\n        return flower;\n    }\n}\nEOF\necho ok","description":"Write icon set and rasterizer"}
