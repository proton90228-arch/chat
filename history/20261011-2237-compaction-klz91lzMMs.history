  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/text && cat > FontFace.java <<'EOF'\npackage com.valkyrie.client.ui.text;\n\nimport java.awt.Font;\nimport java.awt.FontFormatException;\nimport java.awt.font.TextAttribute;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.util.HashMap;\nimport java.util.Map;\n\n/**\n * Начертание шрифта (один TTF). Растеризованные размеры создаются по требованию:\n * размер в физических пикселях = размер стиля в GUI × масштаб интерфейса, поэтому\n * текст всегда рисуется 1:1 с пикселями экрана, без растяжения атласа.\n */\npublic final class FontFace {\n    public final String name;\n    final Font base;\n    final FontFace fallback;\n    private final Map<Integer, SizedFont> sizes = new HashMap<>();\n\n    FontFace(String name, Font base, FontFace fallback) {\n        this.name = name;\n        Map<TextAttribute, Object> attributes = new HashMap<>();\n        attributes.put(TextAttribute.KERNING, TextAttribute.KERNING_ON);\n        this.base = base.deriveFont(attributes);\n        this.fallback = fallback;\n    }\n\n    /** Загружает TTF из ресурсов мода; при ошибке возвращает {@code fallback} (или системный Sans). */\n    public static FontFace load(String name, String resourcePath, FontFace fallback) {\n        try (InputStream in = FontFace.class.getResourceAsStream(resourcePath)) {\n            if (in != null) {\n                return new FontFace(name, Font.createFont(Font.TRUETYPE_FONT, in), fallback == null ? system() : fallback);\n            }\n        } catch (FontFormatException | IOException | RuntimeException ignored) {\n            // Ниже — запасной вариант.\n        }\n        return fallback != null ? fallback : system();\n    }\n\n    private static FontFace system;\n\n    /** Системный логический шрифт: покрывает иероглифы и всё, чего нет в бренд-шрифтах. */\n    public static synchronized FontFace system() {\n        if (system == null) {\n            system = new FontFace(\"system\", new Font(Font.SANS_SERIF, Font.PLAIN, 12), null);\n        }\n        return system;\n    }\n\n    /** Растр размера {@code px} (квантуется до 1/4 пикселя). */\n    public SizedFont at(float px) {\n        int key = Math.max(4, Math.round(px * 4.0f));\n        SizedFont sized = sizes.get(key);\n        if (sized == null) {\n            sized = new SizedFont(this, key / 4.0f);\n            sizes.put(key, sized);\n        }\n        return sized;\n    }\n\n    /** Сбрасывает растры (например, после смены масштаба GUI старые размеры не нужны). */\n    public void trim(int keepAtMost) {\n        if (sizes.size() > keepAtMost) {\n            sizes.clear();\n        }\n    }\n}\nEOF\ncat > SizedFont.java <<'EOF'\npackage com.valkyrie.client.ui.text;\n\nimport com.valkyrie.client.ui.render.Mask;\nimport java.awt.Color;\nimport java.awt.Font;\nimport java.awt.Graphics2D;\nimport java.awt.Rectangle;\nimport java.awt.RenderingHints;\nimport java.awt.font.FontRenderContext;\nimport java.awt.font.GlyphVector;\nimport java.awt.font.LineMetrics;\nimport java.awt.image.BufferedImage;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * Шрифт конкретного пиксельного размера: атлас глифов (страницы-маски) и кэш раскладок.\n * Раскладка строки делается движком AWT с кернингом из GPOS, позиции дробные;\n * при выводе перо округляется до 1/3 пикселя (три варианта растра глифа).\n */\npublic final class SizedFont {\n    static final int SUBPIXEL_BINS = 3;\n    private static final int PAGE = 512;\n    private static final FontRenderContext FRC = new FontRenderContext(null, true, true);\n\n    public final FontFace face;\n    public final float px;\n    final Font font;\n    public final float ascent;\n    public final float descent;\n    public final float capHeight;\n    public final float xHeight;\n\n    private final List<Mask> pages = new ArrayList<>();\n    private int shelfX;\n    private int shelfY;\n    private int shelfH;\n    private final Map<Long, Glyph> glyphs = new HashMap<>();\n    private final LinkedHashMap<String, Layout> layouts = new LinkedHashMap<>(256, 0.75f, true) {\n        @Override\n        protected boolean removeEldestEntry(Map.Entry<String, Layout> eldest) {\n            return size() > 1024;\n        }\n    };\n    private SizedFont fallbackSized;\n\n    SizedFont(FontFace face, float px) {\n        this.face = face;\n        this.px = px;\n        this.font = face.base.deriveFont(px);\n        LineMetrics metrics = font.getLineMetrics(\"Hgx\", FRC);\n        this.ascent = metrics.getAscent();\n        this.descent = metrics.getDescent();\n        this.capHeight = inkHeight('H');\n        this.xHeight = inkHeight('x');\n    }\n\n    private float inkHeight(char c) {\n        if (!font.canDisplay(c)) {\n            return ascent * 0.7f;\n        }\n        GlyphVector gv = font.createGlyphVector(FRC, new char[] {c});\n        return (float) -gv.getGlyphOutline(0).getBounds2D().getMinY();\n    }\n\n    /** Раскладка строки (кэшируется). */\n    public Layout layout(String text) {\n        Layout layout = layouts.get(text);\n        if (layout == null) {\n            layout = build(text);\n            layouts.put(text, layout);\n        }\n        return layout;\n    }\n\n    public float width(String text) {\n        return text == null || text.isEmpty() ? 0.0f : layout(text).width;\n    }\n\n    private SizedFont fallback() {\n        if (fallbackSized == null) {\n            FontFace fb = face.fallback != null ? face.fallback : FontFace.system();\n            fallbackSized = fb == face ? this : fb.at(px);\n        }\n        return fallbackSized;\n    }\n\n    private Layout build(String text) {\n        Layout out = new Layout();\n        int n = text.length();\n        int start = 0;\n        float pen = 0.0f;\n        while (start < n) {\n            boolean primary = font.canDisplay(text.codePointAt(start)) || fallback() == this;\n            int end = start;\n            while (end < n) {\n                int cp = text.codePointAt(end);\n                boolean can = font.canDisplay(cp) || fallback() == this;\n                if (can != primary) {\n                    break;\n                }\n                end += Character.charCount(cp);\n            }\n            SizedFont run = primary ? this : fallback();\n            char[] chars = text.substring(start, end).toCharArray();\n            GlyphVector gv = run.font.layoutGlyphVector(FRC, chars, 0, chars.length, Font.LAYOUT_LEFT_TO_RIGHT);\n            int count = gv.getNumGlyphs();\n            for (int i = 0; i < count; i++) {\n                out.add(run, gv.getGlyphCode(i), pen + (float) gv.getGlyphPosition(i).getX());\n            }\n            pen += (float) gv.getGlyphPosition(count).getX();\n            start = end;\n        }\n        out.width = pen;\n        return out;\n    }\n\n    /** Растр глифа для варианта: {@code bin} — доля пикселя (0..2), {@code light} — светлый текст на тёмном. */\n    public Glyph glyph(int code, int bin, boolean light) {\n        long key = ((long) code << 8) | ((long) bin << 1) | (light ? 1 : 0);\n        Glyph glyph = glyphs.get(key);\n        if (glyph == null) {\n            glyph = rasterize(code, bin, light);\n            glyphs.put(key, glyph);\n        }\n        return glyph;\n    }\n\n    private Glyph rasterize(int code, int bin, boolean light) {\n        GlyphVector gv = font.createGlyphVector(FRC, new int[] {code});\n        float shift = bin / (float) SUBPIXEL_BINS;\n        Rectangle bounds = gv.getGlyphPixelBounds(0, FRC, shift, 0.0f);\n        if (bounds.isEmpty()) {\n            return Glyph.EMPTY;\n        }\n        int w = bounds.width + 2;\n        int h = bounds.height + 2;\n        BufferedImage image = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);\n        Graphics2D g = image.createGraphics();\n        g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);\n        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);\n        g.setRenderingHint(RenderingHints.KEY_FRACTIONALMETRICS, RenderingHints.VALUE_FRACTIONALMETRICS_ON);\n        g.setRenderingHint(RenderingHints.KEY_STROKE_CONTROL, RenderingHints.VALUE_STROKE_PURE);\n        g.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);\n        g.setColor(Color.WHITE);\n        g.drawGlyphVector(gv, shift - bounds.x + 1, -bounds.y + 1);\n        g.dispose();\n\n        Mask page = place(w, h);\n        int u = shelfX - w - 1;\n        int v = shelfY;\n        byte[] gray = ((java.awt.image.DataBufferByte) image.getRaster().getDataBuffer()).getData();\n        for (int y = 0; y < h; y++) {\n            for (int x = 0; x < w; x++) {\n                int a = gray[y * w + x] & 0xFF;\n                if (light && a > 0 && a < 255) {\n                    // Светлый текст на тёмном фоне при sRGB-смешивании выглядит тоньше — слегка уплотняем.\n                    a = (int) Math.round(255.0 * Math.pow(a / 255.0, 0.80));\n                }\n                page.set(u + x, v + y, a);\n            }\n        }\n        page.touch();\n        return new Glyph(page, u, v, w, h, bounds.x - 1, bounds.y - 1);\n    }\n\n    private Mask place(int w, int h) {\n        if (pages.isEmpty() || shelfX + w + 1 > PAGE) {\n            shelfX = 0;\n            shelfY += shelfH + 1;\n            shelfH = 0;\n        }\n        if (pages.isEmpty() || shelfY + h + 1 > PAGE) {\n            pages.add(new Mask(face.name + \"@\" + px + \"#\" + pages.size(), PAGE, PAGE));\n            shelfX = 0;\n            shelfY = 0;\n            shelfH = 0;\n        }\n        shelfX += w + 1;\n        shelfH = Math.max(shelfH, h);\n        return pages.get(pages.size() - 1);\n    }\n\n    /** Растеризованный глиф: позиция в странице и смещение от пера/базовой линии. */\n    public record Glyph(Mask page, int u, int v, int w, int h, int offsetX, int offsetY) {\n        static final Glyph EMPTY = new Glyph(null, 0, 0, 0, 0, 0, 0);\n    }\n\n    /** Раскладка: шрифт, код глифа и дробная позиция каждого глифа. */\n    public static final class Layout {\n        SizedFont[] fonts = new SizedFont[8];\n        int[] codes = new int[8];\n        float[] xs = new float[8];\n        int count;\n        public float width;\n\n        void add(SizedFont font, int code, float x) {\n            if (count == codes.length) {\n                fonts = java.util.Arrays.copyOf(fonts, count * 2);\n                codes = java.util.Arrays.copyOf(codes, count * 2);\n                xs = java.util.Arrays.copyOf(xs, count * 2);\n            }\n            fonts[count] = font;\n            codes[count] = code;\n            xs[count] = x;\n            count++;\n        }\n\n        public int count() {\n            return count;\n        }\n\n        public SizedFont font(int i) {\n            return fonts[i];\n        }\n\n        public int code(int i) {\n            return codes[i];\n        }\n\n        public float x(int i) {\n            return xs[i];\n        }\n    }\n}\nEOF\ncat > TypeStyle.java <<'EOF'\npackage com.valkyrie.client.ui.text;\n\n/**\n * Типографическая шкала клиента (M3 type scale в единицах GUI Minecraft).\n * Как в лаунчере: Jost — дисплейные строки, заголовки и подписи; Inter — основной текст.\n * Размеры подобраны так, чтобы при масштабе GUI 2 текст совпадал с лаунчером на 100%.\n */\npublic enum TypeStyle {\n    DISPLAY_SMALL(Fonts.Face.JOST_LIGHT, 18.0f, 22.0f, -0.01f),\n    HEADLINE_MEDIUM(Fonts.Face.JOST_LIGHT, 15.0f, 18.0f, -0.005f),\n    HEADLINE_SMALL(Fonts.Face.JOST_REGULAR, 12.5f, 16.0f, 0.0f),\n    TITLE_LARGE(Fonts.Face.JOST_REGULAR, 10.5f, 13.0f, 0.0f),\n    TITLE_MEDIUM(Fonts.Face.JOST_MEDIUM, 8.0f, 11.0f, 0.006f),\n    TITLE_SMALL(Fonts.Face.JOST_MEDIUM, 7.0f, 10.0f, 0.008f),\n    BODY_LARGE(Fonts.Face.INTER_REGULAR, 7.5f, 11.0f, 0.0f),\n    BODY_MEDIUM(Fonts.Face.INTER_REGULAR, 6.5f, 9.5f, 0.0f),\n    BODY_SMALL(Fonts.Face.INTER_REGULAR, 5.75f, 8.5f, 0.01f),\n    LABEL_LARGE(Fonts.Face.JOST_MEDIUM, 7.0f, 10.0f, 0.01f),\n    LABEL_MEDIUM(Fonts.Face.JOST_MEDIUM, 6.25f, 8.5f, 0.02f),\n    LABEL_SMALL(Fonts.Face.JOST_MEDIUM, 5.5f, 7.5f, 0.03f),\n    NUMERIC(Fonts.Face.JOST_MEDIUM, 6.5f, 9.0f, 0.0f),\n    MONO(Fonts.Face.MONO, 6.0f, 9.0f, 0.0f);\n\n    public final Fonts.Face face;\n    /** Кегль (em) в единицах GUI. */\n    public final float size;\n    /** Высота строки в единицах GUI. */\n    public final float lineHeight;\n    /** Трекинг в долях em. */\n    public final float tracking;\n\n    TypeStyle(Fonts.Face face, float size, float lineHeight, float tracking) {\n        this.face = face;\n        this.size = size;\n        this.lineHeight = lineHeight;\n        this.tracking = tracking;\n    }\n}\nEOF\ncat > Fonts.java <<'EOF'\npackage com.valkyrie.client.ui.text;\n\nimport java.util.EnumMap;\nimport java.util.Map;\n\n/** Реестр шрифтов клиента. Файлы лежат в {@code assets/valkyrieclient/font/}. */\npublic final class Fonts {\n    public enum Face {\n        JOST_LIGHT(\"jost-light.ttf\"),\n        JOST_REGULAR(\"jost-regular.ttf\"),\n        JOST_MEDIUM(\"jost-medium.ttf\"),\n        JOST_SEMIBOLD(\"jost-semibold.ttf\"),\n        INTER_REGULAR(\"inter-regular.ttf\"),\n        INTER_BOLD(\"inter-bold.ttf\"),\n        NUNITO(\"nunito.ttf\"),\n        MONO(\"jetbrains-mono.ttf\");\n\n        public final String file;\n\n        Face(String file) {\n            this.file = file;\n        }\n    }\n\n    private static final String ROOT = \"/assets/valkyrieclient/font/\";\n    private static final Map<Face, FontFace> FACES = new EnumMap<>(Face.class);\n\n    private Fonts() {\n    }\n\n    public static synchronized FontFace get(Face face) {\n        FontFace loaded = FACES.get(face);\n        if (loaded == null) {\n            FontFace fallback = switch (face) {\n                case NUNITO, MONO -> FontFace.system();\n                case INTER_REGULAR, INTER_BOLD -> get(Face.NUNITO);\n                case JOST_REGULAR -> get(Face.INTER_REGULAR);\n                default -> get(Face.JOST_REGULAR);\n            };\n            loaded = FontFace.load(face.name().toLowerCase(), ROOT + face.file, fallback);\n            FACES.put(face, loaded);\n        }\n        return loaded;\n    }\n\n    public static FontFace get(TypeStyle style) {\n        return get(style.face);\n    }\n}\nEOF\necho ok","description":"Write text package"}
