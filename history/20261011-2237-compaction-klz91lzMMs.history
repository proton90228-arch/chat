  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui && cat > theme/UiTheme.java <<'EOF'\npackage com.valkyrie.client.ui.theme;\n\nimport com.valkyrie.client.ui.color.Argb;\nimport com.valkyrie.client.ui.color.Role;\nimport com.valkyrie.client.ui.color.Scheme;\nimport com.valkyrie.client.ui.motion.Spring;\nimport com.valkyrie.client.ui.motion.SpringSpec;\n\n/**\n * Текущая схема интерфейса. Смена акцента или режима не «щёлкает», а перетекает\n * в OKLab за ~300 мс — вся палитра клиента меняется одной плавной волной.\n */\npublic final class UiTheme {\n    private static final Role[] ROLES = Role.all();\n    private static Scheme target = Scheme.of(Scheme.Preset.SAKURA.seed, false);\n    private static final int[] from = new int[ROLES.length];\n    private static final int[] colors = new int[ROLES.length];\n    private static final Spring progress = new Spring(1.0f, SpringSpec.SLOW_EFFECTS, 0.002f);\n    private static float lastProgress = 1.0f;\n\n    static {\n        for (Role role : ROLES) {\n            colors[role.ordinal()] = target.get(role);\n            from[role.ordinal()] = colors[role.ordinal()];\n        }\n    }\n\n    private UiTheme() {\n    }\n\n    /** Синхронизация с настройками; вызывается каждый кадр — без изменений ничего не делает. */\n    public static void sync(int seed, boolean dark) {\n        Scheme next = Scheme.of(seed, dark);\n        if (next == target) {\n            return;\n        }\n        // Старт перехода с текущих (возможно, промежуточных) цветов.\n        refresh();\n        System.arraycopy(colors, 0, from, 0, colors.length);\n        target = next;\n        progress.snap(0.0f).target(1.0f);\n        lastProgress = -1.0f;\n    }\n\n    /** Мгновенно применить схему (превью, тесты). */\n    public static void set(int seed, boolean dark) {\n        target = Scheme.of(seed, dark);\n        progress.snap(1.0f);\n        for (Role role : ROLES) {\n            colors[role.ordinal()] = target.get(role);\n        }\n        lastProgress = 1.0f;\n    }\n\n    private static void refresh() {\n        float t = progress.value01();\n        if (t == lastProgress) {\n            return;\n        }\n        lastProgress = t;\n        for (Role role : ROLES) {\n            int i = role.ordinal();\n            colors[i] = t >= 1.0f ? target.get(role) : Argb.mixOklab(from[i], target.get(role), t);\n        }\n    }\n\n    public static int c(Role role) {\n        refresh();\n        return colors[role.ordinal()];\n    }\n\n    /** Цвет роли с альфой 0..1. */\n    public static int c(Role role, float alpha) {\n        return Argb.withAlpha(c(role), alpha);\n    }\n\n    public static boolean dark() {\n        return target.dark;\n    }\n\n    public static int seed() {\n        return target.seed;\n    }\n\n    public static Scheme scheme() {\n        return target;\n    }\n}\nEOF\ncat > theme/Elevation.java <<'EOF'\npackage com.valkyrie.client.ui.theme;\n\n/**\n * Уровни высоты M3. Каждый — две тени (ключевая и рассеянная), значения в единицах GUI\n * (≈ dp при масштабе GUI 2), как {@code box-shadow} уровней в Material Web.\n */\npublic enum Elevation {\n    LEVEL0(0, 0, 0, 0, 0, 0, 0, 0),\n    LEVEL1(1, 1.0f, 0.30f, 0, 1, 1.5f, 0.15f, 1),\n    LEVEL2(1, 1.0f, 0.30f, 0, 2, 3.0f, 0.15f, 2),\n    LEVEL3(1, 1.5f, 0.30f, 0, 4, 4.0f, 0.15f, 3),\n    LEVEL4(2, 1.5f, 0.30f, 0, 6, 5.0f, 0.15f, 4),\n    LEVEL5(4, 2.0f, 0.30f, 0, 8, 6.0f, 0.15f, 6);\n\n    public final float keyY;\n    public final float keySigma;\n    public final float keyAlpha;\n    public final float keySpread;\n    public final float ambientY;\n    public final float ambientSigma;\n    public final float ambientAlpha;\n    public final float ambientSpread;\n\n    Elevation(float keyY, float keySigma, float keyAlpha, float keySpread,\n              float ambientY, float ambientSigma, float ambientAlpha, float ambientSpread) {\n        this.keyY = keyY;\n        this.keySigma = keySigma;\n        this.keyAlpha = keyAlpha;\n        this.keySpread = keySpread;\n        this.ambientY = ambientY;\n        this.ambientSigma = ambientSigma;\n        this.ambientAlpha = ambientAlpha;\n        this.ambientSpread = ambientSpread;\n    }\n}\nEOF\necho ok","description":"Write UiTheme and Elevation tokens"}
  Output: <stdout>
ok

</stdout>
