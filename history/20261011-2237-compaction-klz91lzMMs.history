  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client && cat > ui/mc/ModuleGuiModel.java <<'EOF'\npackage com.valkyrie.client.ui.mc;\n\nimport com.valkyrie.client.gui.CompanionReactions;\nimport com.valkyrie.client.module.Category;\nimport com.valkyrie.client.module.Module;\nimport com.valkyrie.client.module.ModuleRegistry;\nimport com.valkyrie.client.module.Setting;\nimport com.valkyrie.client.module.impl.DarkThemeModule;\nimport com.valkyrie.client.ui.clickgui.GuiModel;\nimport com.valkyrie.client.ui.clickgui.ModuleIcons;\nimport com.valkyrie.client.ui.color.Scheme;\nimport com.valkyrie.client.ui.icon.Icon;\nimport java.util.ArrayList;\nimport java.util.IdentityHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/** {@link GuiModel} поверх {@link ModuleRegistry}: новый модуль появляется в ClickGUI сам. */\npublic final class ModuleGuiModel implements GuiModel {\n    private static final int[] ACCENT_SWATCHES = presets();\n    private static final int[] COLOR_SWATCHES = {\n        0xFFDF91AA, 0xFFB3A0D2, 0xFF8FB4DE, 0xFF93B47E, 0xFFE39A6E, 0xFFF2D28C, 0xFFFFFFFF,\n    };\n\n    private final List<GuiModel.Category> categories = new ArrayList<>();\n    private final Map<Setting<?>, Option> options = new IdentityHashMap<>();\n\n    public ModuleGuiModel() {\n        for (Category category : Category.values()) {\n            List<Module> modules = ModuleRegistry.byCategory(category);\n            if (modules.isEmpty()) {\n                continue;\n            }\n            List<GuiModel.Module> items = new ArrayList<>();\n            for (Module module : modules) {\n                items.add(new ModuleItem(module));\n            }\n            categories.add(new CategoryItem(category.title(), ModuleIcons.forCategory(category.title()), items));\n        }\n    }\n\n    private static int[] presets() {\n        Scheme.Preset[] values = Scheme.Preset.values();\n        int[] out = new int[values.length];\n        for (int i = 0; i < values.length; i++) {\n            out[i] = values[i].seed;\n        }\n        return out;\n    }\n\n    @Override\n    public List<GuiModel.Category> categories() {\n        return categories;\n    }\n\n    @Override\n    public boolean dark() {\n        return ModuleRegistry.get(DarkThemeModule.class).isEnabled();\n    }\n\n    @Override\n    public void setDark(boolean dark) {\n        ModuleRegistry.get(DarkThemeModule.class).setEnabled(dark);\n    }\n\n    private record CategoryItem(String title, Icon icon, List<GuiModel.Module> modules) implements GuiModel.Category {\n    }\n\n    private final class ModuleItem implements GuiModel.Module {\n        private final Module module;\n        private final List<Option> visible = new ArrayList<>();\n\n        ModuleItem(Module module) {\n            this.module = module;\n        }\n\n        @Override\n        public String name() {\n            return module.name();\n        }\n\n        @Override\n        public String description() {\n            return module.description();\n        }\n\n        @Override\n        public Icon icon() {\n            return ModuleIcons.forModule(module.name());\n        }\n\n        @Override\n        public boolean toggleable() {\n            return module.hasToggle() && !module.isAction();\n        }\n\n        @Override\n        public boolean enabled() {\n            return module.isEnabled();\n        }\n\n        @Override\n        public void toggle() {\n            module.toggle();\n            CompanionReactions.moduleToggled(module.isEnabled());\n        }\n\n        @Override\n        public String actionLabel() {\n            return module.isAction() ? module.actionLabel() : null;\n        }\n\n        @Override\n        public void action() {\n            module.runAction();\n        }\n\n        @Override\n        public List<Option> options() {\n            visible.clear();\n            for (Setting<?> setting : module.settings()) {\n                Option option = options.computeIfAbsent(setting, ModuleGuiModel::wrap);\n                if (option != null) {\n                    visible.add(option);\n                }\n            }\n            return visible;\n        }\n\n        @Override\n        public boolean expanded() {\n            return module.isExpanded();\n        }\n\n        @Override\n        public void setExpanded(boolean expanded) {\n            module.setExpanded(expanded);\n        }\n    }\n\n    private static Option wrap(Setting<?> setting) {\n        if (setting instanceof Setting.Bool bool) {\n            return new BoolOption() {\n                public String name() { return bool.name(); }\n                public String description() { return bool.description() == null ? \"\" : bool.description(); }\n                public boolean visible() { return bool.visible(); }\n                public boolean value() { return bool.value(); }\n                public void set(boolean value) {\n                    bool.set(value);\n                    CompanionReactions.settingChanged();\n                }\n            };\n        }\n        if (setting instanceof Setting.Slider slider) {\n            return new SliderOption() {\n                public String name() { return slider.name(); }\n                public boolean visible() { return slider.visible(); }\n                public float min() { return slider.min(); }\n                public float max() { return slider.max(); }\n                public float value() { return slider.value(); }\n                public void set(float value) { slider.set(value); }\n                public String label() { return slider.label(); }\n            };\n        }\n        if (setting instanceof Setting.Mode mode) {\n            return new ModeOption() {\n                public String name() { return mode.name(); }\n                public boolean visible() { return mode.visible(); }\n                public List<String> modes() { return mode.options(); }\n                public String value() { return mode.value(); }\n                public void set(String value) {\n                    mode.set(value);\n                    CompanionReactions.settingChanged();\n                }\n            };\n        }\n        if (setting instanceof Setting.Color color) {\n            boolean accent = \"accent\".equals(color.key());\n            return new ColorOption() {\n                public String name() { return color.name(); }\n                public boolean visible() { return color.visible(); }\n                public int value() { return color.value(); }\n                public void set(int value) {\n                    color.set(value);\n                    CompanionReactions.settingChanged();\n                }\n                public int[] swatches() { return accent ? ACCENT_SWATCHES : COLOR_SWATCHES; }\n            };\n        }\n        return null;\n    }\n}\nEOF\ncat > gui/ValkyrieGuiScreen.java <<'EOF'\npackage com.valkyrie.client.gui;\n\nimport com.valkyrie.client.ValkyrieKeyMappings;\nimport com.valkyrie.client.config.ValkyrieOptionsManager;\nimport com.valkyrie.client.gui.notify.Notifications;\nimport com.valkyrie.client.gui.notify.ValkyrieQuotes;\nimport com.valkyrie.client.gui.thunder.ThunderRender;\nimport com.valkyrie.client.module.ModuleRegistry;\nimport com.valkyrie.client.module.impl.AppearanceModule;\nimport com.valkyrie.client.ui.clickgui.ClickGuiView;\nimport com.valkyrie.client.ui.mc.McUi;\nimport com.valkyrie.client.ui.mc.ModuleGuiModel;\nimport com.valkyrie.client.ui.render.Ui;\nimport net.minecraft.client.gui.GuiGraphics;\nimport net.minecraft.client.gui.screens.Screen;\nimport net.minecraft.client.gui.screens.inventory.InventoryScreen;\nimport net.minecraft.client.input.CharacterEvent;\nimport net.minecraft.client.input.KeyEvent;\nimport net.minecraft.client.input.MouseButtonEvent;\nimport net.minecraft.network.chat.Component;\n\n/**\n * ClickGUI Valkyrie: тонкая оболочка над {@link ClickGuiView} — размытие мира,\n * ввод, модель игрока, звуки и сохранение состояния. Весь дизайн — в {@code ui.clickgui}.\n */\npublic final class ValkyrieGuiScreen extends Screen implements ClickGuiView.Host {\n    private ClickGuiView view;\n    private GuiGraphics graphics;\n    private int mouseX;\n    private int mouseY;\n    private boolean finished;\n\n    public ValkyrieGuiScreen() {\n        super(Component.literal(\"Valkyrie\"));\n    }\n\n    @Override\n    protected void init() {\n        if (view == null) {\n            var options = ValkyrieOptionsManager.OPTIONS;\n            view = new ClickGuiView(new ModuleGuiModel(), this, options.clickGuiCategory, options.clickGuiCollapsed);\n            ValkyrieUiFeedback.open();\n            ValkyrieQuotes.onOpenGui();\n            CompanionReactions.greeting();\n        }\n    }\n\n    @Override\n    public void renderBackground(GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTick) {\n        // Размытие всего, что нарисовано раньше, — «стекло» под окном.\n        guiGraphics.blurBeforeThisStratum();\n    }\n\n    @Override\n    public void render(GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTick) {\n        ThunderRender.beginFrame();\n        this.graphics = guiGraphics;\n        this.mouseX = mouseX;\n        this.mouseY = mouseY;\n        Ui ui = McUi.begin(guiGraphics);\n        try {\n            view.render(ui, mouseX, mouseY);\n        } finally {\n            McUi.end();\n        }\n        this.graphics = null;\n        if (!finished) {\n            ValkyrieQuotes.render(guiGraphics, this.font, ThunderRender.frameSeconds());\n            Notifications.render(guiGraphics, this.font);\n        }\n    }\n\n    // ─── ClickGuiView.Host ──────────────────────────────────────────────────\n\n    @Override\n    public void sound(ClickGuiView.Sound sound) {\n        switch (sound) {\n            case TOGGLE_ON -> ValkyrieUiFeedback.toggleOn();\n            case TOGGLE_OFF -> ValkyrieUiFeedback.toggleOff();\n            case SLIDER -> ValkyrieUiFeedback.tick();\n            case CLOSE -> ValkyrieUiFeedback.close();\n            case OPEN -> ValkyrieUiFeedback.open();\n            default -> ValkyrieUiFeedback.click();\n        }\n    }\n\n    @Override\n    public void close() {\n        if (finished) {\n            return;\n        }\n        finished = true;\n        ValkyrieOptionsManager.save();\n        super.onClose();\n    }\n\n    @Override\n    public String playerName() {\n        return this.minecraft != null && this.minecraft.player != null ? this.minecraft.player.getName().getString() : \"Player\";\n    }\n\n    @Override\n    public void companion(Ui ui, float x, float y, float w, float h, float alpha) {\n        if (graphics == null || this.minecraft == null || this.minecraft.player == null || alpha < 0.55f) {\n            return;\n        }\n        AppearanceModule appearance = ModuleRegistry.get(AppearanceModule.class);\n        float motion = appearance.reducedMotion.value() ? 0.30f : 1.0f;\n        float lookX = mouseX + CompanionReactions.lookX() * motion;\n        float lookY = mouseY + CompanionReactions.lookY() * motion;\n        float scale = ui.scale();\n        // Модель игрока рисуется в единицах GUI: временно возвращаем исходную позу.\n        graphics.pose().pushMatrix();\n        graphics.pose().scale(scale, scale);\n        graphics.pose().translate(ui.offsetX(), ui.offsetY() + CompanionReactions.bob() * motion);\n        InventoryScreen.renderEntityInInventoryFollowsMouse(\n            graphics,\n            Math.round(x + 2),\n            Math.round(y + 6),\n            Math.round(x + w - 2),\n            Math.round(y + h - 2),\n            38,\n            0.0625f,\n            lookX,\n            lookY,\n            this.minecraft.player\n        );\n        graphics.pose().popMatrix();\n    }\n\n    @Override\n    public void stateChanged(int category, boolean folded) {\n        ValkyrieOptionsManager.OPTIONS.clickGuiCategory = category;\n        ValkyrieOptionsManager.OPTIONS.clickGuiCollapsed = folded;\n        CompanionReactions.settingChanged();\n    }\n\n    // ─── Ввод ───────────────────────────────────────────────────────────────\n\n    @Override\n    public boolean mouseClicked(MouseButtonEvent event, boolean doubleClick) {\n        view.mouseClicked(event.x(), event.y(), event.button());\n        return true;\n    }\n\n    @Override\n    public boolean mouseReleased(MouseButtonEvent event) {\n        if (view.mouseReleased(event.x(), event.y(), event.button())) {\n            CompanionReactions.settingChanged();\n        }\n        return true;\n    }\n\n    @Override\n    public boolean mouseDragged(MouseButtonEvent event, double dragX, double dragY) {\n        view.mouseDragged(event.x(), event.y(), event.button());\n        return true;\n    }\n\n    @Override\n    public boolean mouseScrolled(double mouseX, double mouseY, double scrollX, double scrollY) {\n        return view.mouseScrolled(mouseX, mouseY, scrollY);\n    }\n\n    @Override\n    public boolean keyPressed(KeyEvent event) {\n        boolean ctrl = (event.modifiers() & 0x0002) != 0;\n        if (view.keyPressed(event.key(), ctrl)) {\n            return true;\n        }\n        // Клавиша открытия закрывает окно, если не идёт ввод в поиск.\n        if (!view.searchFocused() && ValkyrieKeyMappings.OPEN_GUI.matches(event)) {\n            view.requestClose();\n            return true;\n        }\n        return super.keyPressed(event);\n    }\n\n    @Override\n    public boolean charTyped(CharacterEvent event) {\n        int codepoint = event.codepoint();\n        if (Character.isBmpCodePoint(codepoint) && view.charTyped((char) codepoint)) {\n            return true;\n        }\n        return super.charTyped(event);\n    }\n\n    @Override\n    public void onClose() {\n        view.requestClose();\n    }\n\n    @Override\n    public boolean isPauseScreen() {\n        return false;\n    }\n}\nEOF\npython3 - <<'EOF'\nimport re\nbase='/tmp/w/out/src/main/java/com/valkyrie/client/'\n# ValkyrieOptions: новое поле категории\np=base+'config/ValkyrieOptions.java'; s=open(p).read()\ns=s.replace('    public boolean clickGuiCollapsed = false;','    public boolean clickGuiCollapsed = false;\\n    /** Последняя открытая категория ClickGUI (индекс в рейле). */\\n    public int clickGuiCategory = 0;')\nopen(p,'w').write(s)\n# Accent по умолчанию = пресет «Сакура»\np=base+'module/impl/AppearanceModule.java'; s=open(p).read()\ns=s.replace('new Setting.Color(\"accent\", \"Accent\", 0xFFE8A0B4)','new Setting.Color(\"accent\", \"Accent\", 0xFFDF91AA)')\nopen(p,'w').write(s)\n# Theme: цвета из ролей Sakura You\np=base+'gui/theme/Theme.java'; s=open(p).read()\nmapping={\n 'SURFACE':'McUi.role(Role.SURFACE_CONTAINER, isDark() ? 0.94f : 0.91f)',\n 'SURFACE_RAISED':'McUi.role(isDark() ? Role.SURFACE_CONTAINER_HIGH : Role.SURFACE_CONTAINER_LOWEST)',\n 'SURFACE_MUTED':'McUi.role(Role.PRIMARY, isDark() ? 0.10f : 0.07f)',\n 'SURFACE_HOVER':'McUi.role(Role.ON_SURFACE, isDark() ? 0.10f : 0.07f)',\n 'BORDER':'McUi.role(Role.OUTLINE_VARIANT, isDark() ? 0.75f : 0.65f)',\n 'TEXT_PRIMARY':'McUi.role(Role.ON_SURFACE)',\n 'TEXT_SECONDARY':'McUi.role(Role.ON_SURFACE_VARIANT)',\n 'TEXT_TERTIARY':'McUi.role(Role.OUTLINE)',\n 'TEXT_ON_ACCENT':'McUi.role(Role.ON_BRAND)',\n 'SHADOW':'Ui.shadowColor()',\n 'DANGER':'McUi.role(Role.ERROR)',\n 'SUCCESS':'McUi.role(Role.SUCCESS)',\n 'SCRIM_TOP':'McUi.role(Role.SURFACE, isDark() ? 0.25f : 0.21f)',\n 'SCRIM_BOTTOM':'McUi.role(Role.SURFACE, isDark() ? 0.40f : 0.36f)',\n 'HUD_SURFACE':'McUi.role(Role.SURFACE_CONTAINER, isDark() ? 0.90f : 0.91f)',\n 'HUD_KEY_SURFACE':'McUi.role(Role.SURFACE_CONTAINER_HIGH, isDark() ? 0.82f : 0.85f)',\n 'KNOB':'McUi.role(isDark() ? Role.ON_SURFACE : Role.SURFACE_CONTAINER_LOWEST)',\n 'TRACK_OFF':'McUi.role(Role.OUTLINE_VARIANT, 0.55f)',\n}\nn=0\nfor name,expr in mapping.items():\n    pat=re.compile(r'(public static int '+name+r'\\(\\) \\{\\s*)return [^;]*;')\n    s,k=pat.subn(lambda m: m.group(1)+'return '+expr+';', s)\n    n+=k\nprint('theme replaced',n)\ns=s.replace(\"\"\"        int accent = ModuleRegistry.get(AppearanceModule.class).accent.value();\n        return (accent >>> 24) == 0 ? ACCENT_FALLBACK : accent;\"\"\",\"\"\"        // Акцент интерфейса — роль «brand» схемы, построенной из выбранного seed-цвета.\n        return McUi.role(Role.BRAND);\"\"\")\ns=re.sub(r'(public static final int ACCENT_FALLBACK = )0xFFE8A0B4;',r'\\g<1>0xFFDF91AA;',s)\ns=s.replace('package com.valkyrie.client.gui.theme;\\n','package com.valkyrie.client.gui.theme;\\n\\nimport com.valkyrie.client.ui.color.Role;\\nimport com.valkyrie.client.ui.mc.McUi;\\nimport com.valkyrie.client.ui.render.Ui;\\n',1)\nopen(p,'w').write(s)\n# ThunderRender: чёткие формы через Ui\np=base+'gui/thunder/ThunderRender.java'; s=open(p).read()\ndef replace_method(src, signature_start, new_body):\n    i=src.index(signature_start)\n    j=src.index('{',i)\n    depth=0;k=j\n    while True:\n        if src[k]=='{': depth+=1\n        elif src[k]=='}':\n            depth-=1\n            if depth==0: break\n        k+=1\n    return src[:j]+'{\\n'+new_body+'\\n    }'+src[k+1:]\ns=replace_method(s,'public static void drawRoundRect(GuiGraphics g, int x, int y, int w, int h, int r, int color)','''        if (w <= 0 || h <= 0 || (color >>> 24) == 0) {\n            return;\n        }\n        Ui ui = McUi.begin(g);\n        try {\n            ui.round(x, y, w, h, r, color);\n        } finally {\n            McUi.end();\n        }''')\ns=replace_method(s,'public static void drawRound(GuiGraphics g, float x, float y, float w, float h, float r, int color)','''        if (w <= 0 || h <= 0 || (color >>> 24) == 0) {\n            return;\n        }\n        Ui ui = McUi.begin(g);\n        try {\n            ui.round(x, y, w, h, r, color);\n        } finally {\n            McUi.end();\n        }''')\ns=replace_method(s,'public static void drawRoundOutline(GuiGraphics g, int x, int y, int w, int h, int r, int color)','''        if (w <= 0 || h <= 0 || (color >>> 24) == 0) {\n            return;\n        }\n        Ui ui = McUi.begin(g);\n        try {\n            ui.outline(x, y, w, h, r, 0.75f, color);\n        } finally {\n            McUi.end();\n        }''')\ns=replace_method(s,'public static void drawElevation(GuiGraphics g, int x, int y, int w, int h, int radius, int elevation, float strength)','''        if (w <= 0 || h <= 0 || strength <= 0.0f) {\n            return;\n        }\n        Elevation level = elevation <= 2 ? Elevation.LEVEL1 : elevation <= 4 ? Elevation.LEVEL2\n            : elevation <= 6 ? Elevation.LEVEL3 : elevation <= 9 ? Elevation.LEVEL4 : Elevation.LEVEL5;\n        Ui ui = McUi.begin(g);\n        try {\n            ui.elevation(x, y, w, h, radius, level, strength);\n        } finally {\n            McUi.end();\n        }''')\ns=s.replace('package com.valkyrie.client.gui.thunder;\\n','package com.valkyrie.client.gui.thunder;\\n\\nimport com.valkyrie.client.ui.mc.McUi;\\nimport com.valkyrie.client.ui.render.Ui;\\nimport com.valkyrie.client.ui.theme.Elevation;\\n',1)\nopen(p,'w').write(s)\n# ValkyrieFonts: новый текст (Inter/Jost в физических пикселях)\np=base+'render/ValkyrieFonts.java'; s=open(p).read()\ns=replace_method(s,'public static void draw(GuiGraphics guiGraphics, Font font, String value, int x, int y, int color)','        text(guiGraphics, TypeStyle.UI_TEXT, value, x, y, color, false);')\ns=replace_method(s,'public static void drawTitle(GuiGraphics guiGraphics, Font font, String value, int x, int y, int color)','        text(guiGraphics, TypeStyle.UI_TITLE, value, x, y, color, false);')\ns=replace_method(s,'public static void drawCentered(GuiGraphics guiGraphics, Font font, String value, int centerX, int y, int color)','        text(guiGraphics, TypeStyle.UI_TEXT, value, centerX, y, color, true);')\ns=replace_method(s,'public static void drawCenteredTitle(GuiGraphics guiGraphics, Font font, String value, int centerX, int y, int color)','        text(guiGraphics, TypeStyle.UI_TITLE, value, centerX, y, color, true);')\ns=replace_method(s,'public static int width(Font font, String value)','        return (int) Math.ceil(McUi.textWidth(TypeStyle.UI_TEXT, value));')\ns=replace_method(s,'public static int titleWidth(Font font, String value)','        return (int) Math.ceil(McUi.textWidth(TypeStyle.UI_TITLE, value));')\ns=replace_method(s,'public static int lineHeight(Font font)','        return Math.round(TypeStyle.UI_TEXT.lineHeight);')\ns=s.rstrip()\nassert s.endswith('}')\ns=s[:-1]+'''\n    /** Вывод через новый текстовый рендер; альфа 0 трактуется как непрозрачный (как у ванильного drawString). */\n    private static void text(GuiGraphics guiGraphics, TypeStyle style, String value, int x, int y, int color, boolean centered) {\n        if (value == null || value.isEmpty()) {\n            return;\n        }\n        int argb = (color & 0xFC000000) == 0 ? color | 0xFF000000 : color;\n        Ui ui = McUi.begin(guiGraphics);\n        try {\n            if (centered) {\n                ui.textCentered(style, value, x, y, argb);\n            } else {\n                ui.text(style, value, x, y, argb);\n            }\n        } finally {\n            McUi.end();\n        }\n    }\n}\n'''\ns=s.replace('package com.valkyrie.client.render;\\n','package com.valkyrie.client.render;\\n\\nimport com.valkyrie.client.ui.mc.McUi;\\nimport com.valkyrie.client.ui.render.Ui;\\nimport com.valkyrie.client.ui.text.TypeStyle;\\n',1)\nopen(p,'w').write(s)\nprint('ok')\nEOF\ngrep -n 'ACCENT_PALETTE = {' -A 9 gui/theme/Theme.java | head -12","description":"Write adapter, new screen, and compat patches"}
