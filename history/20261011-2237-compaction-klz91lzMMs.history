  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui && cat > render/Ui.java <<'EOF'\npackage com.valkyrie.client.ui.render;\n\nimport com.valkyrie.client.ui.color.Argb;\nimport com.valkyrie.client.ui.color.Role;\nimport com.valkyrie.client.ui.icon.Icon;\nimport com.valkyrie.client.ui.icon.IconRaster;\nimport com.valkyrie.client.ui.text.Fonts;\nimport com.valkyrie.client.ui.text.SizedFont;\nimport com.valkyrie.client.ui.text.TypeStyle;\nimport com.valkyrie.client.ui.theme.Elevation;\nimport com.valkyrie.client.ui.theme.UiTheme;\nimport java.util.HashMap;\nimport java.util.Map;\n\n/**\n * Рисование интерфейса в единицах GUI поверх {@link Canvas} в физических пикселях.\n * <p>\n * Все координаты переводятся в пиксели экрана и округляются там, а не в GUI:\n * края, тени, иконки и текст получаются чёткими при любом масштабе интерфейса.\n * Формы собираются по схеме 9-slice из закэшированных аналитических масок.\n */\npublic final class Ui {\n    private static final Ui INSTANCE = new Ui();\n\n    private Canvas canvas;\n    private float s = 1.0f;\n    private float tx;\n    private float ty;\n    private float alpha = 1.0f;\n    private final float[] stack = new float[96];\n    private int depth;\n    private final float[] alphaStack = new float[32];\n    private int alphaDepth;\n    private final Map<Long, Mask> masks = new HashMap<>();\n    private final Map<String, Mask> bigMasks = new HashMap<>();\n\n    private Ui() {\n    }\n\n    /** Общий экземпляр (интерфейс рисуется только из потока отрисовки). */\n    public static Ui get() {\n        return INSTANCE;\n    }\n\n    public Ui begin(Canvas canvas) {\n        this.canvas = canvas;\n        float scale = canvas.scale();\n        if (scale != s) {\n            masks.clear();\n            bigMasks.clear();\n        }\n        this.s = scale;\n        tx = 0.0f;\n        ty = 0.0f;\n        depth = 0;\n        alpha = 1.0f;\n        alphaDepth = 0;\n        if (masks.size() > 1500) {\n            masks.clear();\n        }\n        if (bigMasks.size() > 300) {\n            bigMasks.clear();\n        }\n        return this;\n    }\n\n    public Canvas canvas() {\n        return canvas;\n    }\n\n    public float scale() {\n        return s;\n    }\n\n    /** Ширина экрана в единицах GUI. */\n    public float width() {\n        return canvas.width() / s;\n    }\n\n    public float height() {\n        return canvas.height() / s;\n    }\n\n    /** Округление до физического пикселя (для выравнивания линий). */\n    public float snap(float v) {\n        return Math.round(v * s) / s;\n    }\n\n    // ─── Состояние ──────────────────────────────────────────────────────────\n\n    public void push(float dx, float dy) {\n        stack[depth++] = tx;\n        stack[depth++] = ty;\n        tx += dx;\n        ty += dy;\n    }\n\n    public void pop() {\n        ty = stack[--depth];\n        tx = stack[--depth];\n    }\n\n    public void pushAlpha(float factor) {\n        alphaStack[alphaDepth++] = alpha;\n        alpha *= Math.max(0.0f, Math.min(1.0f, factor));\n    }\n\n    public void popAlpha() {\n        alpha = alphaStack[--alphaDepth];\n    }\n\n    public float alpha() {\n        return alpha;\n    }\n\n    private int px(float gx) {\n        return Math.round((gx + tx) * s);\n    }\n\n    private int py(float gy) {\n        return Math.round((gy + ty) * s);\n    }\n\n    private int color(int argb) {\n        return alpha >= 1.0f ? argb : Argb.fade(argb, alpha);\n    }\n\n    // ─── Обрезка ────────────────────────────────────────────────────────────\n\n    /** Прямоугольная обрезка; границы выравниваются по сетке GUI (так её понимает ножницы Minecraft). */\n    public void clip(float x, float y, float w, float h) {\n        int x0 = (int) Math.floor(x + tx);\n        int y0 = (int) Math.floor(y + ty);\n        int x1 = (int) Math.ceil(x + tx + w);\n        int y1 = (int) Math.ceil(y + ty + h);\n        canvas.pushClip(Math.round(x0 * s), Math.round(y0 * s), Math.round(x1 * s), Math.round(y1 * s));\n    }\n\n    public void unclip() {\n        canvas.popClip();\n    }\n\n    // ─── Прямоугольники ─────────────────────────────────────────────────────\n\n    public void rect(float x, float y, float w, float h, int argb) {\n        int c = color(argb);\n        if ((c >>> 24) == 0) {\n            return;\n        }\n        canvas.fill(px(x), py(y), px(x + w), py(y + h), c);\n    }\n\n    public void gradient(float x, float y, float w, float h, int top, int bottom) {\n        canvas.gradient(px(x), py(y), px(x + w), py(y + h), color(top), color(bottom));\n    }\n\n    /** Скруглённый прямоугольник с одинаковыми радиусами. */\n    public void round(float x, float y, float w, float h, float r, int argb) {\n        int c = color(argb);\n        if ((c >>> 24) == 0 || w <= 0 || h <= 0) {\n            return;\n        }\n        int x0 = px(x);\n        int y0 = py(y);\n        int x1 = px(x + w);\n        int y1 = py(y + h);\n        int rp = Math.round(r * s);\n        roundPx(x0, y0, x1, y1, rp, rp, rp, rp, c);\n    }\n\n    /** Полностью скруглённая «пилюля». */\n    public void pill(float x, float y, float w, float h, int argb) {\n        round(x, y, w, h, Math.min(w, h) / 2.0f, argb);\n    }\n\n    /** Скругление с разными радиусами углов (по часовой от левого верхнего). */\n    public void round(float x, float y, float w, float h, float tl, float tr, float br, float bl, int argb) {\n        int c = color(argb);\n        if ((c >>> 24) == 0 || w <= 0 || h <= 0) {\n            return;\n        }\n        roundPx(px(x), py(y), px(x + w), py(y + h), Math.round(tl * s), Math.round(tr * s), Math.round(br * s), Math.round(bl * s), c);\n    }\n\n    private void roundPx(int x0, int y0, int x1, int y1, int tl, int tr, int br, int bl, int c) {\n        int w = x1 - x0;\n        int h = y1 - y0;\n        if (w <= 0 || h <= 0) {\n            return;\n        }\n        int limit = Math.min(w, h) / 2;\n        tl = Math.max(0, Math.min(tl, limit));\n        tr = Math.max(0, Math.min(tr, limit));\n        br = Math.max(0, Math.min(br, limit));\n        bl = Math.max(0, Math.min(bl, limit));\n        if (tl > 0) {\n            Mask m = disc(tl * 2);\n            canvas.mask(m, x0, y0, tl, tl, 0, 0, tl, tl, c);\n        }\n        if (tr > 0) {\n            Mask m = disc(tr * 2);\n            canvas.mask(m, x1 - tr, y0, tr, tr, tr, 0, tr, tr, c);\n        }\n        if (br > 0) {\n            Mask m = disc(br * 2);\n            canvas.mask(m, x1 - br, y1 - br, br, br, br, br, br, br, c);\n        }\n        if (bl > 0) {\n            Mask m = disc(bl * 2);\n            canvas.mask(m, x0, y1 - bl, bl, bl, 0, bl, bl, bl, c);\n        }\n        // Остальное — горизонтальные полосы между угловыми зонами.\n        int[] ys = {y0, y0 + tl, y0 + tr, y1 - bl, y1 - br, y1};\n        java.util.Arrays.sort(ys);\n        for (int i = 0; i < ys.length - 1; i++) {\n            int a = ys[i];\n            int b = ys[i + 1];\n            if (b <= a) {\n                continue;\n            }\n            int left = x0 + (a < y0 + tl ? tl : b > y1 - bl ? bl : 0);\n            int right = x1 - (a < y0 + tr ? tr : b > y1 - br ? br : 0);\n            if (right > left) {\n                canvas.fill(left, a, right, b, c);\n            }\n        }\n    }\n\n    /** Обводка внутрь формы толщиной {@code stroke} (в GUI; минимум 1 физический пиксель). */\n    public void outline(float x, float y, float w, float h, float r, float stroke, int argb) {\n        int c = color(argb);\n        if ((c >>> 24) == 0) {\n            return;\n        }\n        int x0 = px(x);\n        int y0 = py(y);\n        int x1 = px(x + w);\n        int y1 = py(y + h);\n        int sw = Math.max(1, Math.round(stroke * s));\n        int rp = Math.max(sw, Math.min(Math.round(r * s), Math.min(x1 - x0, y1 - y0) / 2));\n        if (x1 - x0 < 2 * rp || y1 - y0 < 2 * rp) {\n            return;\n        }\n        Mask ring = ringMask(rp * 2, sw);\n        canvas.mask(ring, x0, y0, rp, rp, 0, 0, rp, rp, c);\n        canvas.mask(ring, x1 - rp, y0, rp, rp, rp, 0, rp, rp, c);\n        canvas.mask(ring, x1 - rp, y1 - rp, rp, rp, rp, rp, rp, rp, c);\n        canvas.mask(ring, x0, y1 - rp, rp, rp, 0, rp, rp, rp, c);\n        canvas.fill(x0 + rp, y0, x1 - rp, y0 + sw, c);\n        canvas.fill(x0 + rp, y1 - sw, x1 - rp, y1, c);\n        canvas.fill(x0, y0 + rp, x0 + sw, y1 - rp, c);\n        canvas.fill(x1 - sw, y0 + rp, x1, y1 - rp, c);\n    }\n\n    // ─── Круги ──────────────────────────────────────────────────────────────\n\n    public void circle(float cx, float cy, float radius, int argb) {\n        int c = color(argb);\n        int d = Math.round(radius * 2.0f * s);\n        if ((c >>> 24) == 0 || d <= 0) {\n            return;\n        }\n        int x0 = Math.round((cx + tx) * s - d / 2.0f);\n        int y0 = Math.round((cy + ty) * s - d / 2.0f);\n        Mask m = disc(d);\n        canvas.mask(m, x0, y0, d, d, 0, 0, d, d, c);\n    }\n\n    public void ring(float cx, float cy, float radius, float stroke, int argb) {\n        int c = color(argb);\n        int d = Math.round(radius * 2.0f * s);\n        if ((c >>> 24) == 0 || d <= 0) {\n            return;\n        }\n        int sw = Math.max(1, Math.round(stroke * s));\n        int x0 = Math.round((cx + tx) * s - d / 2.0f);\n        int y0 = Math.round((cy + ty) * s - d / 2.0f);\n        Mask m = ringMask(d, sw);\n        canvas.mask(m, x0, y0, d, d, 0, 0, d, d, c);\n    }\n\n    // ─── Тени ───────────────────────────────────────────────────────────────\n\n    /** Тень уровня M3 под формой со скруглением {@code r}. Цвет — роль {@code shadow} схемы. */\n    public void elevation(float x, float y, float w, float h, float r, Elevation level) {\n        elevation(x, y, w, h, r, level, 1.0f);\n    }\n\n    public void elevation(float x, float y, float w, float h, float r, Elevation level, float strength) {\n        if (level == Elevation.LEVEL0 || strength <= 0.0f) {\n            return;\n        }\n        int base = shadowColor();\n        float boost = UiTheme.dark() ? 1.6f : 1.0f;\n        shadow(x - level.ambientSpread, y - level.ambientSpread + level.ambientY, w + level.ambientSpread * 2, h + level.ambientSpread * 2,\n            r + level.ambientSpread, level.ambientSigma, Argb.withAlpha(base, Math.min(1.0f, level.ambientAlpha * strength * boost)));\n        shadow(x - level.keySpread, y + level.keyY, w + level.keySpread * 2, h, r, level.keySigma,\n            Argb.withAlpha(base, Math.min(1.0f, level.keyAlpha * strength * boost)));\n    }\n\n    /** Цвет теней: в светлой схеме — глубокий тон бренда (тени «тёплые»), в тёмной — чёрный. */\n    public static int shadowColor() {\n        return UiTheme.dark() ? 0xFF000000 : Argb.mixOklab(0xFF000000, UiTheme.c(Role.ON_PRIMARY_FIXED), 0.55f);\n    }\n\n    /** Размытая тень прямоугольника: {@code sigma} — гауссово σ в GUI. */\n    public void shadow(float x, float y, float w, float h, float r, float sigma, int argb) {\n        int c = color(argb);\n        if ((c >>> 24) == 0 || w <= 0 || h <= 0) {\n            return;\n        }\n        float sig = Math.max(0.5f, Math.round(sigma * s * 2.0f) / 2.0f);\n        int x0 = px(x);\n        int y0 = py(y);\n        int x1 = px(x + w);\n        int y1 = py(y + h);\n        int rp = Math.max(0, Math.min(Math.round(r * s), Math.min(x1 - x0, y1 - y0) / 2));\n        int e = Raster.shadowExtent(sig);\n        int p = rp + 2 * e;\n        if (x1 - x0 < 2 * (rp + e) || y1 - y0 < 2 * (rp + e)) {\n            String key = \"sf\" + (x1 - x0) + \"x\" + (y1 - y0) + \"r\" + rp + \"s\" + sig;\n            Mask m = bigMasks.get(key);\n            if (m == null) {\n                m = Raster.shadowFull(x1 - x0, y1 - y0, rp, sig);\n                bigMasks.put(key, m);\n            }\n            canvas.mask(m, x0 - e, y0 - e, m.width, m.height, 0, 0, m.width, m.height, c);\n            return;\n        }\n        long key = key(3, rp, Math.round(sig * 2), 0);\n        Mask sheet = masks.get(key);\n        if (sheet == null) {\n            sheet = Raster.shadowSheet(rp, sig);\n            masks.put(key, sheet);\n        }\n        int left = x0 - e;\n        int top = y0 - e;\n        int right = x1 + e;\n        int bottom = y1 + e;\n        // Углы.\n        canvas.mask(sheet, left, top, p, p, 0, 0, p, p, c);\n        canvas.mask(sheet, right - p, top, p, p, p, 0, p, p, c);\n        canvas.mask(sheet, right - p, bottom - p, p, p, p, p, p, p, c);\n        canvas.mask(sheet, left, bottom - p, p, p, 0, p, p, p, c);\n        // Края: растягиваем центральные столбец и строку.\n        int mid = p - 1;\n        if (right - left > 2 * p) {\n            canvas.mask(sheet, left + p, top, right - left - 2 * p, p, mid, 0, 1, p, c);\n            canvas.mask(sheet, left + p, bottom - p, right - left - 2 * p, p, mid, p, 1, p, c);\n        }\n        if (bottom - top > 2 * p) {\n            canvas.mask(sheet, left, top + p, p, bottom - top - 2 * p, 0, mid, p, 1, c);\n            canvas.mask(sheet, right - p, top + p, p, bottom - top - 2 * p, p, mid, p, 1, c);\n        }\n        if (right - left > 2 * p && bottom - top > 2 * p) {\n            canvas.fill(left + p, top + p, right - p, bottom - p, c);\n        }\n    }\n\n    // ─── Иконки ─────────────────────────────────────────────────────────────\n\n    public void icon(Icon icon, float x, float y, float size, int argb) {\n        icon(icon, x, y, size, argb, 1.0f);\n    }\n\n    /** Иконка в квадрате {@code size}; {@code weight} утолщает штрих (активные состояния). */\n    public void icon(Icon icon, float x, float y, float size, int argb, float weight) {\n        int c = color(argb);\n        int d = Math.round(size * s);\n        if ((c >>> 24) == 0 || d <= 0) {\n            return;\n        }\n        long key = key(4, icon.ordinal(), d, Math.round(weight * 100));\n        Mask m = masks.get(key);\n        if (m == null) {\n            m = IconRaster.render(icon, d, weight);\n            masks.put(key, m);\n        }\n        int x0 = Math.round((x + tx) * s);\n        int y0 = Math.round((y + ty) * s);\n        canvas.mask(m, x0, y0, d, d, 0, 0, d, d, c);\n    }\n\n    // ─── Текст ──────────────────────────────────────────────────────────────\n\n    public SizedFont font(TypeStyle style) {\n        return Fonts.get(style).at(style.size * s);\n    }\n\n    /** Ширина строки в GUI. */\n    public float textWidth(TypeStyle style, String text) {\n        if (text == null || text.isEmpty()) {\n            return 0.0f;\n        }\n        SizedFont f = font(style);\n        SizedFont.Layout layout = f.layout(text);\n        float tracking = style.tracking * style.size * s;\n        return (layout.width + tracking * Math.max(0, layout.count() - 1)) / s;\n    }\n\n    /**\n     * Строка в «строчном боксе» стиля: {@code y} — верх бокса высотой {@code style.lineHeight};\n     * текст оптически центрирован по высоте прописных и строчных. Возвращает ширину в GUI.\n     */\n    public float text(TypeStyle style, String text, float x, float y, int argb) {\n        if (text == null || text.isEmpty()) {\n            return 0.0f;\n        }\n        int c = color(argb);\n        SizedFont f = font(style);\n        SizedFont.Layout layout = f.layout(text);\n        float tracking = style.tracking * style.size * s;\n        if ((c >>> 24) == 0) {\n            return (layout.width + tracking * Math.max(0, layout.count() - 1)) / s;\n        }\n        float originX = (x + tx) * s;\n        float top = (y + ty) * s;\n        int baseline = Math.round(top + style.lineHeight * s * 0.5f + (f.capHeight + f.xHeight) * 0.25f);\n        boolean light = Argb.luminance(c) > 0.42f;\n        int count = layout.count();\n        for (int i = 0; i < count; i++) {\n            float pen = originX + layout.x(i) + tracking * i;\n            int ip = (int) Math.floor(pen);\n            int bin = Math.min(2, (int) ((pen - ip) * 3.0f));\n            SizedFont.Glyph g = layout.font(i).glyph(layout.code(i), bin, light);\n            if (g.page() == null) {\n                continue;\n            }\n            canvas.mask(g.page(), ip + g.offsetX(), baseline + g.offsetY(), g.w(), g.h(), g.u(), g.v(), g.w(), g.h(), c);\n        }\n        return (layout.width + tracking * Math.max(0, count - 1)) / s;\n    }\n\n    public float textCentered(TypeStyle style, String text, float cx, float y, int argb) {\n        float w = textWidth(style, text);\n        text(style, text, cx - w / 2.0f, y, argb);\n        return w;\n    }\n\n    public float textRight(TypeStyle style, String text, float right, float y, int argb) {\n        float w = textWidth(style, text);\n        text(style, text, right - w, y, argb);\n        return w;\n    }\n\n    /** Обрезка строки с многоточием под ширину {@code max}. */\n    public String ellipsize(TypeStyle style, String text, float max) {\n        if (text == null || textWidth(style, text) <= max) {\n            return text;\n        }\n        String dots = \"…\";\n        int lo = 0;\n        int hi = text.length();\n        while (lo < hi) {\n            int mid = (lo + hi + 1) / 2;\n            if (textWidth(style, text.substring(0, mid).stripTrailing() + dots) <= max) {\n                lo = mid;\n            } else {\n                hi = mid - 1;\n            }\n        }\n        return lo <= 0 ? dots : text.substring(0, lo).stripTrailing() + dots;\n    }\n\n    /** Перенос по словам; не более {@code maxLines} строк (последняя — с многоточием). */\n    public java.util.List<String> wrap(TypeStyle style, String text, float max, int maxLines) {\n        java.util.List<String> lines = new java.util.ArrayList<>();\n        if (text == null || text.isBlank()) {\n            return lines;\n        }\n        String[] words = text.trim().split(\"\\\\s+\");\n        StringBuilder line = new StringBuilder();\n        for (int i = 0; i < words.length; i++) {\n            String candidate = line.isEmpty() ? words[i] : line + \" \" + words[i];\n            if (textWidth(style, candidate) <= max || line.isEmpty()) {\n                line.setLength(0);\n                line.append(candidate);\n            } else {\n                if (lines.size() == maxLines - 1) {\n                    StringBuilder rest = new StringBuilder(line);\n                    for (int j = i; j < words.length; j++) {\n                        rest.append(' ').append(words[j]);\n                    }\n                    lines.add(ellipsize(style, rest.toString(), max));\n                    return lines;\n                }\n                lines.add(line.toString());\n                line.setLength(0);\n                line.append(words[i]);\n            }\n        }\n        if (!line.isEmpty()) {\n            lines.add(ellipsize(style, line.toString(), max));\n        }\n        return lines;\n    }\n\n    // ─── Кэш масок ──────────────────────────────────────────────────────────\n\n    private static long key(int type, int a, int b, int c) {\n        return ((long) type << 56) | ((long) (a & 0xFFFF) << 32) | ((long) (b & 0xFFFF) << 16) | (c & 0xFFFF);\n    }\n\n    private Mask disc(int d) {\n        long key = key(1, d, 0, 0);\n        Mask m = masks.get(key);\n        if (m == null) {\n            m = Raster.disc(d);\n            masks.put(key, m);\n        }\n        return m;\n    }\n\n    private Mask ringMask(int d, int stroke) {\n        long key = key(2, d, stroke, 0);\n        Mask m = masks.get(key);\n        if (m == null) {\n            m = Raster.ring(d, stroke);\n            masks.put(key, m);\n        }\n        return m;\n    }\n}\nEOF\ncd /tmp/w/tools/test && rm -rf cls && java /tmp/w/tools/Javac.java cls \"\" /tmp/w/out/src/main/java/com/valkyrie/client/ui/color /tmp/w/out/src/main/java/com/valkyrie/client/ui/motion /tmp/w/out/src/main/java/com/valkyrie/client/ui/render /tmp/w/out/src/main/java/com/valkyrie/client/ui/text /tmp/w/out/src/main/java/com/valkyrie/client/ui/icon /tmp/w/out/src/main/java/com/valkyrie/client/ui/theme src 2>&1 | grep -v JAVA_TOOL | tail -20","timeoutMs":120000,"description":"Write Ui facade and compile foundation"}
