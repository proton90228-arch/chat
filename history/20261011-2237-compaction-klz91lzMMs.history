  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/clickgui && cat > GuiModel.java <<'EOF'\npackage com.valkyrie.client.ui.clickgui;\n\nimport com.valkyrie.client.ui.icon.Icon;\nimport java.util.List;\n\n/**\n * Модель ClickGUI без зависимостей от Minecraft: в игре её реализует адаптер над\n * {@code ModuleRegistry}, в песочнице — данные для PNG-превью.\n */\npublic interface GuiModel {\n    List<Category> categories();\n\n    /** Тёмная схема (модуль Dark mode) — быстрый переключатель в рейле. */\n    boolean dark();\n\n    void setDark(boolean dark);\n\n    interface Category {\n        String title();\n\n        Icon icon();\n\n        List<Module> modules();\n    }\n\n    interface Module {\n        String name();\n\n        String description();\n\n        Icon icon();\n\n        /** Есть ли переключатель (у «действий» вроде Edit layout его нет). */\n        boolean toggleable();\n\n        boolean enabled();\n\n        void toggle();\n\n        /** Подпись кнопки действия или {@code null}. */\n        default String actionLabel() {\n            return null;\n        }\n\n        default void action() {\n        }\n\n        List<Option> options();\n    }\n\n    interface Option {\n        String name();\n\n        default String description() {\n            return \"\";\n        }\n\n        default boolean visible() {\n            return true;\n        }\n    }\n\n    interface BoolOption extends Option {\n        boolean value();\n\n        void set(boolean value);\n    }\n\n    interface SliderOption extends Option {\n        float min();\n\n        float max();\n\n        float value();\n\n        void set(float value);\n\n        /** Текст значения (через форматтер настройки). */\n        String label();\n    }\n\n    interface ModeOption extends Option {\n        List<String> modes();\n\n        String value();\n\n        void set(String value);\n    }\n\n    interface ColorOption extends Option {\n        int value();\n\n        void set(int value);\n\n        /** Образцы цветов; для акцента — пресеты Sakura You. */\n        int[] swatches();\n    }\n}\nEOF\necho ok","description":"Write ClickGUI model interfaces"}
