  Input: {"command":"cd /tmp/w/out/src/main/java/com/valkyrie/client/ui/motion && cat > SpringSpec.java <<'EOF'\npackage com.valkyrie.client.ui.motion;\n\n/**\n * Параметры пружины M3 (androidx Expressive/Standard motion tokens): коэффициент\n * затухания ζ и жёсткость k при единичной массе. Те же значения, что в {@code tokens.css} лаунчера.\n */\npublic record SpringSpec(float dampingRatio, float stiffness) {\n    /** Быстрые пространственные движения с заметным перелётом (~9%): переключатели, индикаторы. */\n    public static final SpringSpec EXPRESSIVE_FAST_SPATIAL = new SpringSpec(0.6f, 800.0f);\n    /** Основные пространственные движения (~1.4% перелёта): карточки, панели. */\n    public static final SpringSpec EXPRESSIVE_DEFAULT_SPATIAL = new SpringSpec(0.8f, 380.0f);\n    /** Крупные и медленные перемещения: окно, складывание. */\n    public static final SpringSpec EXPRESSIVE_SLOW_SPATIAL = new SpringSpec(0.8f, 200.0f);\n    public static final SpringSpec STANDARD_FAST_SPATIAL = new SpringSpec(0.9f, 1400.0f);\n    public static final SpringSpec STANDARD_DEFAULT_SPATIAL = new SpringSpec(0.9f, 700.0f);\n    public static final SpringSpec STANDARD_SLOW_SPATIAL = new SpringSpec(0.9f, 300.0f);\n    /** Эффекты (цвет, прозрачность) — без перелёта. */\n    public static final SpringSpec FAST_EFFECTS = new SpringSpec(1.0f, 3800.0f);\n    public static final SpringSpec DEFAULT_EFFECTS = new SpringSpec(1.0f, 1600.0f);\n    public static final SpringSpec SLOW_EFFECTS = new SpringSpec(1.0f, 800.0f);\n\n    /** При «уменьшении движения» пространственные пружины заменяются коротким затуханием. */\n    public SpringSpec reduced() {\n        return dampingRatio < 1.0f ? FAST_EFFECTS : this;\n    }\n}\nEOF\ncat > Motion.java <<'EOF'\npackage com.valkyrie.client.ui.motion;\n\n/**\n * Общие часы интерфейса. {@link #beginFrame()} вызывается один раз за кадр корнем\n * отрисовки; пружины продвигаются лениво при первом чтении в кадре, поэтому\n * отдельного цикла обновления нет, а скрытые элементы просто «спят».\n */\npublic final class Motion {\n    private static long frameId;\n    private static long lastNanos;\n    private static float dt = 1.0f / 60.0f;\n    private static float time;\n    private static boolean reduced;\n    private static long manualClockNanos = -1L;\n\n    private Motion() {\n    }\n\n    /** Отмечает начало кадра. Повторный вызов в том же кадре (≤ 1 мс) игнорируется. */\n    public static void beginFrame() {\n        long now = manualClockNanos >= 0 ? manualClockNanos : System.nanoTime();\n        if (lastNanos != 0L && now - lastNanos < 1_000_000L && manualClockNanos < 0) {\n            return;\n        }\n        float seconds = lastNanos == 0L ? 1.0f / 60.0f : (now - lastNanos) / 1.0e9f;\n        // Защита от рывка после паузы/загрузки: не больше 1/20 с за шаг.\n        dt = Math.max(0.0f, Math.min(seconds, 1.0f / 20.0f));\n        time += dt;\n        lastNanos = now;\n        frameId++;\n    }\n\n    public static long frameId() {\n        return frameId;\n    }\n\n    /** Длительность текущего кадра, с. */\n    public static float dt() {\n        return dt;\n    }\n\n    /** Монотонное время интерфейса, с. */\n    public static float time() {\n        return time;\n    }\n\n    public static boolean reduced() {\n        return reduced;\n    }\n\n    public static void setReduced(boolean value) {\n        reduced = value;\n    }\n\n    /** Детерминированные часы для превью и тестов: следующий кадр наступит через {@code seconds}. */\n    public static void advanceManual(float seconds) {\n        if (manualClockNanos < 0) {\n            manualClockNanos = System.nanoTime();\n        }\n        manualClockNanos += (long) (seconds * 1.0e9);\n        beginFrame();\n    }\n}\nEOF\ncat > Spring.java <<'EOF'\npackage com.valkyrie.client.ui.motion;\n\n/**\n * Пружина с аналитическим решением: шаг не зависит от FPS и не разгоняется при\n * длинных кадрах. Значение продвигается лениво — один раз за кадр {@link Motion}.\n */\npublic final class Spring {\n    private SpringSpec spec;\n    private float value;\n    private float velocity;\n    private float target;\n    private float threshold;\n    private long frame = -1L;\n\n    public Spring(float initial, SpringSpec spec) {\n        this(initial, spec, 0.0005f);\n    }\n\n    /** {@code threshold} — точность, при которой пружина «засыпает» на цели (в единицах значения). */\n    public Spring(float initial, SpringSpec spec, float threshold) {\n        this.value = initial;\n        this.target = initial;\n        this.spec = spec;\n        this.threshold = threshold;\n    }\n\n    public Spring spec(SpringSpec spec) {\n        this.spec = spec;\n        return this;\n    }\n\n    /** Новая цель; скорость сохраняется, поэтому смена направления плавная. */\n    public Spring target(float target) {\n        this.target = target;\n        return this;\n    }\n\n    public Spring target(boolean on) {\n        return target(on ? 1.0f : 0.0f);\n    }\n\n    /** Мгновенно ставит значение и цель (без анимации). */\n    public Spring snap(float value) {\n        this.value = value;\n        this.target = value;\n        this.velocity = 0.0f;\n        this.frame = Motion.frameId();\n        return this;\n    }\n\n    /** Толчок скорости — для «упругого» отклика без смены цели. */\n    public Spring kick(float velocity) {\n        this.velocity += velocity;\n        return this;\n    }\n\n    public float target() {\n        return target;\n    }\n\n    public float velocity() {\n        advance();\n        return velocity;\n    }\n\n    public boolean settled() {\n        advance();\n        return value == target && velocity == 0.0f;\n    }\n\n    /** Текущее значение (с продвижением на текущий кадр). */\n    public float value() {\n        advance();\n        return value;\n    }\n\n    /** Значение, ограниченное [0, 1] — для прозрачностей при пружинах с перелётом. */\n    public float value01() {\n        float v = value();\n        return v < 0.0f ? 0.0f : Math.min(1.0f, v);\n    }\n\n    private void advance() {\n        long now = Motion.frameId();\n        if (frame == now) {\n            return;\n        }\n        float dt = frame < 0 ? 0.0f : Motion.dt();\n        frame = now;\n        if (value == target && velocity == 0.0f) {\n            return;\n        }\n        step(dt);\n    }\n\n    /** Точный шаг затухающего осциллятора длиной {@code dt} секунд. */\n    void step(float dt) {\n        SpringSpec s = Motion.reduced() ? spec.reduced() : spec;\n        double omega = Math.sqrt(s.stiffness());\n        double zeta = s.dampingRatio();\n        double x0 = value - target;\n        double v0 = velocity;\n        double x;\n        double v;\n        if (zeta < 1.0) {\n            double wd = omega * Math.sqrt(1.0 - zeta * zeta);\n            double decay = Math.exp(-zeta * omega * dt);\n            double cos = Math.cos(wd * dt);\n            double sin = Math.sin(wd * dt);\n            double b = (v0 + zeta * omega * x0) / wd;\n            x = decay * (x0 * cos + b * sin);\n            v = decay * (v0 * cos - x0 * wd * sin) - zeta * omega * x;\n            // Производная: d/dt[e^{-ζωt}(x0 cos + b sin)] = -ζω x + e^{-ζωt}(-x0 wd sin + b wd cos)\n            v = -zeta * omega * x + decay * (-x0 * wd * sin + b * wd * cos);\n        } else if (zeta == 1.0) {\n            double decay = Math.exp(-omega * dt);\n            double b = v0 + omega * x0;\n            x = (x0 + b * dt) * decay;\n            v = (v0 - omega * b * dt) * decay;\n        } else {\n            double root = Math.sqrt(zeta * zeta - 1.0);\n            double r1 = -omega * (zeta - root);\n            double r2 = -omega * (zeta + root);\n            double c1 = (v0 - r2 * x0) / (r1 - r2);\n            double c2 = x0 - c1;\n            double e1 = Math.exp(r1 * dt);\n            double e2 = Math.exp(r2 * dt);\n            x = c1 * e1 + c2 * e2;\n            v = c1 * r1 * e1 + c2 * r2 * e2;\n        }\n        if (Math.abs(x) < threshold && Math.abs(v) < threshold * 10.0) {\n            value = target;\n            velocity = 0.0f;\n        } else {\n            value = (float) (target + x);\n            velocity = (float) v;\n        }\n    }\n}\nEOF\necho ok","description":"Write motion package"}
