        .shadow(0xFF05070C)
        .danger(0xFFFF6B73)
        .success(0xFF3FD3A0)
        .scrim(0x400B0E14, 0x660B0E14)
        .hudSurface(0xE61C2230)
        .hudKeySurface(0xD1232A3A)
        .shadowStrength(1.35f)
        .knob(0xFFF2F5FA)
