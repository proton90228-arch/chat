  Input: {"command":"cd /tmp/w/client/src/main/java/com/valkyrie/client/module && python3 - <<'EOF'\nimport re,json,os,glob\nreg=open('ModuleRegistry.java').read()\norder=re.findall(r'new\\s+([A-Z]\\w+Module)\\s*\\(',reg)\nmods=[]\nfor cls in order:\n    fn=f'impl/{cls}.java'\n    if not os.path.exists(fn): print('missing',cls); continue\n    s=open(fn).read()\n    consts=dict(re.findall(r'static\\s+final\\s+String\\s+(\\w+)\\s*=\\s*\"([^\"]*)\"',s))\n    m=re.search(r'super\\(\\s*\"([^\"]*)\"\\s*,\\s*\"([^\"]*)\"\\s*,\\s*Category\\.(\\w+)\\s*(?:,\\s*(true|false))?\\s*\\)',s)\n    name,desc,cat,en=m.group(1),m.group(2),m.group(3),m.group(4)=='true'\n    action='isAction()' in s and 'return true' in s.split('isAction()')[1][:80]\n    notoggle='hasToggle()' in s and 'return false' in s.split('hasToggle()')[1][:80]\n    sets=[]\n    for sm in re.finditer(r'new\\s+Setting\\.(Bool|Slider|Color|Mode)\\((.*?)\\)\\s*\\)',s,re.S):\n        kind,args=sm.group(1),sm.group(2)\n        strs=re.findall(r'\"([^\"]*)\"',args)\n        if kind=='Bool':\n            b=re.findall(r'\\b(true|false)\\b',args)\n            sets.append(dict(kind=kind,key=strs[0],name=strs[1],desc=strs[2] if len(strs)>2 else '',value=b[-1]=='true' if b else False))\n        elif kind=='Slider':\n            nums=re.findall(r'(-?\\d+(?:\\.\\d+)?)f',args)\n            fmt=re.search(r'Slider::(\\w+)',args)\n            sets.append(dict(kind=kind,key=strs[0],name=strs[1],value=float(nums[0]),min=float(nums[1]),max=float(nums[2]),fmt=fmt.group(1) if fmt else 'plain'))\n        elif kind=='Color':\n            c=re.search(r'0x([0-9A-Fa-f]{8})',args)\n            sets.append(dict(kind=kind,key=strs[0],name=strs[1],value=int(c.group(1),16) if c else 0xFFFFFFFF))\n        elif kind=='Mode':\n            lst=re.search(r'List\\.of\\((.*?)\\)',args,re.S).group(1)\n            opts=[consts.get(x.strip(),x.strip().strip('\"')) for x in lst.split(',')]\n            tail=args[args.index(lst)+len(lst)+1:]\n            init=tail.split(',')[-1].strip()\n            init=consts.get(init,init.strip('\"'))\n            sets.append(dict(kind=kind,key=strs[0],name=strs[1],options=opts,value=init))\n    mods.append(dict(cls=cls,name=name,desc=desc,cat=cat,enabled=en,action=action,toggle=not notoggle,settings=sets))\njson.dump(mods,open('/tmp/w/modules.json','w'),indent=1)\nfor m in mods: print(m['cat'],'|',m['name'],'|',m['desc'],'|',len(m['settings']),'A' if m['action'] else '', '' if m['toggle'] else 'NT', 'ON' if m['enabled'] else '')\nprint(len(mods))\nEOF","description":"Extract real module data for previews"}
