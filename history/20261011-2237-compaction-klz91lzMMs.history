/**
 * Цветовые схемы «Sakura You»: TonalSpot от seed-цвета с белоснежной нейтралью «Snow»
 * (chroma 4 вместо 6 у M3) и тёмной нейтралью «Sakura Night» (hue −28°, chroma 7).
 * Порт design/scheme.py; результат проверяется тестом против design-токенов.
 */
import { harmonize, hctFromHex, mod360, TonalPalette } from './hct';

export type PaletteKey = 'P' | 'S' | 'T' | 'N' | 'NV' | 'DN' | 'E';
type RoleMap = Record<string, readonly [PaletteKey, number]>;

export const PRESETS = {
  sakura: { seed: '#DF91AA', name: 'Сакура', kanji: '桜' },
  fuji: { seed: '#B3A0D2', name: 'Глициния', kanji: '藤' },
  momiji: { seed: '#E39A6E', name: 'Момидзи', kanji: '紅葉' },
  matcha: { seed: '#93B47E', name: 'Матча', kanji: '抹茶' },
  sora: { seed: '#8FB4DE', name: 'Сора', kanji: '空' },
} as const;

export type PresetId = keyof typeof PRESETS;

/** Дополнительные цвета состояний кнопки. «Успех» не гармонизируется: зелёный остаётся зелёным. */
const EXT = { install: '#9D8AB8', update: '#D9925F', success: '#4FB98A' } as const;
const NOT_HARMONIZED = new Set<string>(['success']);

const LIGHT: RoleMap = {
  primary: ['P', 40], 'on-primary': ['P', 100], 'primary-container': ['P', 90], 'on-primary-container': ['P', 30],
  secondary: ['S', 40], 'on-secondary': ['S', 100], 'secondary-container': ['S', 90], 'on-secondary-container': ['S', 30],
  tertiary: ['T', 40], 'on-tertiary': ['T', 100], 'tertiary-container': ['T', 90], 'on-tertiary-container': ['T', 30],
  error: ['E', 40], 'on-error': ['E', 100], 'error-container': ['E', 90], 'on-error-container': ['E', 30],
  surface: ['N', 99], 'surface-dim': ['N', 88], 'surface-bright': ['N', 99],
  'surface-container-lowest': ['N', 100], 'surface-container-low': ['N', 97], 'surface-container': ['N', 95],
  'surface-container-high': ['N', 93], 'surface-container-highest': ['N', 91],
  'on-surface': ['N', 10], 'on-surface-variant': ['NV', 30], outline: ['NV', 50], 'outline-variant': ['NV', 85],
  'inverse-surface': ['N', 20], 'inverse-on-surface': ['N', 95], 'inverse-primary': ['P', 80],
  scrim: ['N', 0], shadow: ['N', 0],
  'primary-fixed': ['P', 90], 'primary-fixed-dim': ['P', 80], 'on-primary-fixed': ['P', 10], 'on-primary-fixed-variant': ['P', 30],
  petal: ['P', 80], 'petal-soft': ['P', 90], brand: ['P', 50], 'on-brand': ['P', 100],
};

const DARK: RoleMap = {
  primary: ['P', 80], 'on-primary': ['P', 20], 'primary-container': ['P', 30], 'on-primary-container': ['P', 90],
  secondary: ['S', 80], 'on-secondary': ['S', 20], 'secondary-container': ['S', 30], 'on-secondary-container': ['S', 90],
  tertiary: ['T', 80], 'on-tertiary': ['T', 20], 'tertiary-container': ['T', 30], 'on-tertiary-container': ['T', 90],
  error: ['E', 80], 'on-error': ['E', 20], 'error-container': ['E', 30], 'on-error-container': ['E', 90],
  surface: ['DN', 6], 'surface-dim': ['DN', 6], 'surface-bright': ['DN', 24],
  'surface-container-lowest': ['DN', 4], 'surface-container-low': ['DN', 10], 'surface-container': ['DN', 12],
  'surface-container-high': ['DN', 17], 'surface-container-highest': ['DN', 22],
  'on-surface': ['DN', 92], 'on-surface-variant': ['NV', 80], outline: ['NV', 60], 'outline-variant': ['NV', 30],
  'inverse-surface': ['DN', 90], 'inverse-on-surface': ['DN', 20], 'inverse-primary': ['P', 40],
  scrim: ['N', 0], shadow: ['N', 0],
  'primary-fixed': ['P', 90], 'primary-fixed-dim': ['P', 80], 'on-primary-fixed': ['P', 10], 'on-primary-fixed-variant': ['P', 30],
  petal: ['P', 70], 'petal-soft': ['P', 40], brand: ['P', 70], 'on-brand': ['P', 10],
};

const EXT_LIGHT = { '': 40, 'on-': 100, '-container': 90, 'on--container': 30 } as const;
const EXT_DARK = { '': 80, 'on-': 20, '-container': 30, 'on--container': 90 } as const;

export type Scheme = Record<string, string>;

export interface SchemeSet {
  seed: string;
  light: Scheme;
  dark: Scheme;
}

function extKey(pattern: string, name: string): string {
  if (pattern.includes('--')) return pattern.replace('--', `-${name}-`);
  return pattern.endsWith('-') ? pattern + name : name + pattern;
}

const cache = new Map<string, SchemeSet>();

/** Полная схема (светлая и тёмная) из seed-цвета `#RRGGBB`. */
export function buildScheme(seedHex: string): SchemeSet {
  const seed = seedHex.toUpperCase();
  const cached = cache.get(seed);
  if (cached) return cached;
  const { hue, chroma } = hctFromHex(seed);
  const palettes: Record<PaletteKey, TonalPalette> = {
    P: new TonalPalette(hue, Math.max(chroma, 36.0)),
    S: new TonalPalette(hue, 16.0),
    T: new TonalPalette(hue + 60.0, 24.0),
    N: new TonalPalette(hue, 4.0),
    NV: new TonalPalette(hue, 8.0),
    DN: new TonalPalette(mod360(hue - 28.0), 7.0),
    E: (() => {
      const error = harmonize('#B3261E', seed);
      return new TonalPalette(error.hue, Math.max(error.chroma, 60.0));
    })(),
  };
  const ext = Object.entries(EXT).map(([name, hex]) => {
    const color = NOT_HARMONIZED.has(name) ? hctFromHex(hex) : harmonize(hex, seed);
    return [name, new TonalPalette(color.hue, Math.max(color.chroma, 36.0))] as const;
  });
  const make = (roles: RoleMap, extTones: Record<string, number>): Scheme => {
    const scheme: Scheme = {};
    for (const [role, [palette, tone]] of Object.entries(roles)) scheme[role] = palettes[palette].tone(tone);
    for (const [name, palette] of ext) {
      for (const [pattern, tone] of Object.entries(extTones)) scheme[extKey(pattern, name)] = palette.tone(tone);
    }
    return scheme;
  };
  const result = { seed, light: make(LIGHT, EXT_LIGHT), dark: make(DARK, EXT_DARK) };
  cache.set(seed, result);
  return result;
}
import { buildScheme, PRESETS, type PresetId } from './scheme';

export type PaletteId = PresetId | 'windows';

export const isPreset = (id: string): id is PresetId => Object.hasOwn(PRESETS, id);

const VK_ROLE = /^((on-)?(install|update|success)(-container)?|petal|petal-soft|brand|on-brand)$/;

/** CSS-переменная роли: стандартные роли M3 — `--md-sys-color-*`, роли Valkyrie — `--vk-*`. */
export const cssVariable = (role: string) => (VK_ROLE.test(role) ? `--vk-${role}` : `--md-sys-color-${role}`);

export interface ThemeOptions {
  palette: string;
  dark: boolean;
  accent: string | null;
  reducedMotion: boolean;
}

let dynamicVariables: string[] = [];

/**
 * Пресеты берутся из статических токенов (`data-palette`), палитра «Windows» строится на лету
 * из системного акцента тем же алгоритмом Sakura You.
 */
export function applyTheme(options: ThemeOptions, root: HTMLElement = document.documentElement): void {
  root.dataset.theme = options.dark ? 'dark' : 'light';
  root.dataset.reducedMotion = String(options.reducedMotion);
  for (const name of dynamicVariables) root.style.removeProperty(name);
  dynamicVariables = [];
  if (options.palette === 'windows' && options.accent) {
    root.dataset.palette = 'windows';
    const scheme = buildScheme(options.accent)[options.dark ? 'dark' : 'light'];
    for (const [role, hex] of Object.entries(scheme)) {
      const name = cssVariable(role);
      root.style.setProperty(name, hex);
      dynamicVariables.push(name);
    }
  } else {
    root.dataset.palette = isPreset(options.palette) ? options.palette : 'sakura';
  }
  root.style.colorScheme = options.dark ? 'dark' : 'light';
}

export interface PetalColors {
  pale: string;
  deep: string;
  alpha: number;
}

/** Цвета лепестков. Для «Сакуры» — точные цвета Java-версии. */
export function petalColors(palette: string, dark: boolean, accent: string | null): PetalColors {
  const seed = palette === 'windows' ? accent : isPreset(palette) && palette !== 'sakura' ? PRESETS[palette].seed : null;
  if (!seed) {
    return dark ? { pale: '#F7DDE8', deep: '#E9A9C2', alpha: 0.62 } : { pale: '#F2CEDE', deep: '#E8B4C8', alpha: 0.55 };
  }
  const scheme = buildScheme(seed)[dark ? 'dark' : 'light'];
  return dark
    ? { pale: scheme['primary-fixed']!, deep: scheme.petal!, alpha: 0.62 }
    : { pale: scheme['petal-soft']!, deep: scheme.petal!, alpha: 0.55 };
}
